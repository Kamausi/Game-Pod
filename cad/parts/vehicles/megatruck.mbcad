# Mega truck: pickup cab perched on a tube chassis over 54" ag-style tyres, blown big-block
# through the hood, zoomie headers, 4-link bars and coilovers, roll cage.
# Body frame: +Z fwd, +X left. Front axle z=1.776, rear z=-1.924, track 2.4, wheel centres y=-0.55.
param paint_r = 0.10
param paint_g = 0.10
param paint_b = 0.11
set FA = 1.776
set RA = -1.924
set AY = -0.55
# Tube chassis rails and crossmembers (inside the tyres)
color #2b2b2b
material steel
box size=0.10,0.12,5.4 pos=0.42,-0.05,-0.08 mirror=x
box size=0.94,0.10,0.10 pos=0,-0.05,2.45
box size=0.94,0.10,0.10 pos=0,-0.05,-2.55
box size=0.94,0.10,0.10 pos=0,-0.05,0.4
# Axle housings, pumpkins
color #1c1c1c
cyl r=0.09 h=1.90 axis=x pos=0,AY,FA
cyl r=0.09 h=1.90 axis=x pos=0,AY,RA
sphere r=0.22 pos=0,AY,FA scale=1,1,0.8
sphere r=0.22 pos=0,AY,RA scale=1,1,0.8
# 4-link bars and coilovers (chassis to axle)
color #3c3c3c
box size=0.06,0.06,1.25 pos=0.36,-0.33,FA-0.65 rot=-10,0,0 mirror=x
box size=0.06,0.06,1.25 pos=0.36,-0.33,RA+0.65 rot=10,0,0 mirror=x
color #d8a21a
cyl r=0.07 h=0.70 pos=0.62,-0.18,FA-0.15 rot=0,0,-18 seg=10 mirror=x
cyl r=0.07 h=0.70 pos=0.62,-0.18,RA+0.15 rot=0,0,-18 seg=10 mirror=x
# Pickup body sitting high on the chassis (floor y=0.45): one side profile for the front clip,
# hood, cab and roof, a separate bed with flared sides, fender flares over nothing (tyres outside).
color paint_r paint_g paint_b
material paint
extrude depth=1.96 bevel=0.06 pts=-1.00,0.45,2.62,0.45,2.66,0.62,2.64,1.00,2.55,1.10,0.80,1.18,0.70,1.22,0.36,1.86,-0.72,1.88,-0.92,1.30,-1.00,1.22
extrude depth=0.08 bevel=0.02 pts=-1.10,0.45,-3.05,0.45,-3.05,1.20,-1.10,1.20 pos=0.94,0,0 mirror=x
box size=1.96,0.08,1.95 pos=0,0.49,-2.08
box size=1.96,0.75,0.08 pos=0,0.83,-3.02 bevel=0.02
box size=1.80,0.70,0.08 pos=0,0.82,-1.12
color #151515
material matte
box size=0.12,0.05,1.95 pos=0.94,1.22,-2.08 bevel=0.015 mirror=x
box size=1.94,0.03,1.0 pos=0,1.15,1.95
# Door seams, handles, mirrors
box size=0.006,0.66,0.006 pos=0.985,0.82,0.62 mirror=x
box size=0.006,0.66,0.006 pos=0.985,0.82,-0.95 mirror=x
box size=0.02,0.03,0.14 pos=0.99,1.02,-0.20 mirror=x
box size=0.06,0.20,0.16 pos=1.06,1.32,0.72 bevel=0.03 mirror=x
# Grille
color #0d0d0d
box size=1.30,0.34,0.04 pos=0,0.86,2.66 bevel=0.01
# Blower and scoop through the hood, zoomie headers
color #c0c2c4
material chrome
box size=0.45,0.22,0.65 pos=0,1.26,1.70 bevel=0.03
color #222222
material steel
box size=0.40,0.26,0.30 pos=0,1.48,1.65 bevel=0.03
color #b0b2b4
material chrome
cyl r=0.04 h=0.55 pos=0.55,1.15,1.80 rot=-30,0,0 seg=8 mirror=x
cyl r=0.04 h=0.55 pos=0.55,1.15,1.45 rot=-30,0,0 seg=8 mirror=x
# Roll cage over the cab
color #1a1a1a
material steel
cyl r=0.04 h=1.6 pos=0.85,1.95,0.65 rot=-25,0,0 seg=8 mirror=x
cyl r=0.04 h=1.3 pos=0.85,1.90,-0.95 seg=8 mirror=x
cyl r=0.04 h=1.74 axis=x pos=0,2.40,0.10 seg=8
cyl r=0.04 h=1.74 axis=x pos=0,2.40,-0.95 seg=8
cyl r=0.04 h=1.05 axis=z pos=0.85,2.40,-0.42 seg=8 mirror=x
# Lights, light bar, bumpers
color #e8eef2
material lens
box size=0.30,0.18,0.04 pos=0.72,0.88,2.65 bevel=0.01 mirror=x
box size=1.40,0.08,0.06 pos=0,2.47,0.15
color #b01313
box size=0.08,0.30,0.04 pos=0.92,0.90,-3.07 mirror=x
color #1a1a1a
material steel
box size=1.4,0.20,0.20 pos=0,0.10,2.60 bevel=0.03
box size=1.4,0.20,0.20 pos=0,0.10,-3.05 bevel=0.03
