# Mega truck: pickup cab perched on a tube chassis over 54" ag-style tyres, blown big-block
# through the hood, zoomie headers, 4-link bars and coilovers, roll cage.
# Body frame: +Z fwd, +X left. Front axle z=1.776, rear z=-1.924, track 2.4, wheel centres y=-0.55.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.10
param paint_g = 0.10
param paint_b = 0.11
set FA = 1.776
set RA = -1.924
set AY = -0.55
# Tube chassis rails and crossmembers (inside the tyres)
# High-fidelity surfacing: smoother curves and rounded edges, then the whole vehicle is shaped
# as one (tumblehome, barrelled sides, tapered nose/tail, plan bow, crowned hood and roof).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.10 ty0=1.25 ty1=1.86 crown=0.03 cy0=1.70 cy1=1.84 hw=0.98
color #2b2b2b
material steel
box size=0.10,0.12,5.4 pos=0.42,-0.05,-0.08 mirror=x
box size=0.94,0.10,0.10 pos=0,-0.05,2.45
box size=0.94,0.10,0.10 pos=0,-0.05,-2.55
box size=0.94,0.10,0.10 pos=0,-0.05,0.4
# Axles, links and coilovers are drawn live by the game (they follow the suspension).
# Pickup body sitting high on the chassis (floor y=0.45): one side profile for the front clip,
# hood, cab and roof, a separate bed with flared sides, fender flares over nothing (tyres outside).
color paint_r paint_g paint_b
material paint
# >>> body shell (generated by tools/gen_truck_bodies.py)
# Lofted lower body: rocker roll-under, barrelled door, character crease, rounded shoulder,
# crowned hood; wheel openings clipped exactly and backed by wheelhouse liners.
color paint_r paint_g paint_b
material paint
loft sec=-1.0:0.0000,0.4700,0.8700,0.4700,0.9280,0.5300,0.9400,0.7068,0.9440,1.0400,0.9340,1.0800,0.9180,1.1600,0.8700,1.2020,0.4700,1.2100,0.0000,1.2100|-0.98:0.0000,0.4500,0.8950,0.4500,0.9530,0.5100,0.9650,0.7028,0.9690,1.0700,0.9590,1.1100,0.9430,1.1900,0.8950,1.2320,0.4825,1.2400,0.0000,1.2400|-0.92:0.0000,0.4500,0.9100,0.4500,0.9680,0.5100,0.9800,0.7124,0.9840,1.1000,0.9740,1.1400,0.9580,1.2200,0.9100,1.2620,0.4900,1.2700,0.0000,1.2700|0.62:0.0000,0.4500,0.9100,0.4500,0.9680,0.5100,0.9800,0.7028,0.9840,1.0700,0.9740,1.1100,0.9580,1.1900,0.9100,1.2320,0.4900,1.2400,0.0000,1.2400|0.8:0.0000,0.4500,0.9100,0.4500,0.9680,0.5100,0.9800,0.6836,0.9840,1.0100,0.9740,1.0500,0.9580,1.1300,0.9100,1.1720,0.4900,1.1987,0.0000,1.2050|1.6:0.0000,0.4500,0.9100,0.4500,0.9680,0.5100,0.9800,0.6740,0.9840,0.9800,0.9740,1.0200,0.9580,1.1000,0.9100,1.1420,0.4900,1.1725,0.0000,1.1800|2.5:0.0000,0.4500,0.9050,0.4500,0.9630,0.5100,0.9750,0.6612,0.9790,0.9400,0.9690,0.9800,0.9530,1.0600,0.9050,1.1020,0.4875,1.1250,0.0000,1.1300|2.62:0.0000,0.4800,0.8900,0.4800,0.9480,0.5400,0.9600,0.6624,0.9640,0.8800,0.9540,0.9200,0.9380,1.0000,0.8900,1.0420,0.4800,1.0575,0.0000,1.0600|2.66:0.0000,0.6200,0.8500,0.6200,0.9080,0.6800,0.9200,0.7416,0.9240,0.8300,0.9140,0.8700,0.8980,0.9500,0.8500,0.9920,0.4600,1.0030,0.0000,1.0040 n=3 m=2
# Lofted bed sides with a rolled rail and inner wall
loft full=1 sec=-1.100:0.9100,0.4600,0.9100,0.4500,0.9680,0.5100,0.9800,0.6750,0.9840,1.0300,0.9740,1.0700,0.9600,1.1600,0.9300,1.2000,0.8600,1.2000,0.8600,1.1500,0.9100,1.1300|-1.140:0.9100,0.4600,0.9100,0.4500,0.9680,0.5100,0.9800,0.6750,0.9840,1.0300,0.9740,1.0700,0.9600,1.1600,0.9300,1.2000,0.8600,1.2000,0.8600,1.1500,0.9100,1.1300|-3.010:0.9100,0.4600,0.9100,0.4500,0.9680,0.5100,0.9800,0.6750,0.9840,1.0300,0.9740,1.0700,0.9600,1.1600,0.9300,1.2000,0.8600,1.2000,0.8600,1.1500,0.9100,1.1300|-3.050:0.9100,0.4600,0.9100,0.4500,0.9680,0.5100,0.9800,0.6750,0.9840,1.0300,0.9740,1.0700,0.9600,1.1600,0.9300,1.2000,0.8600,1.2000,0.8600,1.1500,0.9100,1.1300 n=2 m=2 mirror=x
