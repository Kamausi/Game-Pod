# Mega truck: pickup cab perched on a tube chassis over 54" ag-style tyres, blown big-block
# through the hood, zoomie headers, 4-link bars and coilovers, roll cage.
# Body frame: +Z fwd, +X left. Front axle z=1.776, rear z=-1.924, track 2.4, wheel centres y=-0.55.
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.10
param paint_g = 0.10
param paint_b = 0.11
set FA = 1.776
set RA = -1.924
set AY = -0.55
# Tube chassis rails and crossmembers (inside the tyres)
color #2b2b2b
material steel
box size=0.10,0.12,5.4 pos=0.42,-0.05,-0.08 mirror=x
box size=0.94,0.10,0.10 pos=0,-0.05,2.45
box size=0.94,0.10,0.10 pos=0,-0.05,-2.55
box size=0.94,0.10,0.10 pos=0,-0.05,0.4
# Axles, links and coilovers are drawn live by the game (they follow the suspension).
# Pickup body sitting high on the chassis (floor y=0.45): one side profile for the front clip,
# hood, cab and roof, a separate bed with flared sides, fender flares over nothing (tyres outside).
color paint_r paint_g paint_b
material paint
extrude depth=1.96 bevel=0.06 pts=-1.00,0.45,2.62,0.45,2.66,0.62,2.64,1.00,2.55,1.10,0.80,1.18,0.66,1.24,-0.95,1.28,-1.00,1.22
# Open greenhouse: roof skin, A/B/C pillars round the see-through cab
extrude depth=1.96 bevel=0.03 pts=0.36,1.86,-0.72,1.88,-0.72,1.83,0.36,1.81
box size=0.08,0.729,0.09 pos=0.945,1.550,0.510 rot=-25.82,0,0 mirror=x
box size=0.08,0.683,0.09 pos=0.945,1.580,-0.835 rot=-159.03,0,0 mirror=x
box size=0.08,0.60,0.10 pos=0.945,1.56,-0.25 mirror=x
extrude depth=0.08 bevel=0.02 pts=-1.10,0.45,-3.05,0.45,-3.05,1.20,-1.10,1.20 pos=0.94,0,0 mirror=x
box size=1.96,0.08,1.95 pos=0,0.49,-2.08
box size=1.96,0.75,0.08 pos=0,0.83,-3.02 bevel=0.02
box size=1.80,0.70,0.08 pos=0,0.82,-1.12
color #151515
material matte
box size=0.12,0.05,1.95 pos=0.94,1.22,-2.08 bevel=0.015 mirror=x
box size=1.94,0.03,1.0 pos=0,1.15,1.95
# Door seams, handles, mirrors
box size=0.006,0.66,0.006 pos=0.985,0.82,0.62 mirror=x
box size=0.006,0.66,0.006 pos=0.985,0.82,-0.95 mirror=x
box size=0.02,0.03,0.14 pos=0.99,1.02,-0.20 mirror=x
box size=0.06,0.20,0.16 pos=1.06,1.32,0.72 bevel=0.03 mirror=x
# Grille
color #0d0d0d
box size=1.30,0.34,0.04 pos=0,0.86,2.66 bevel=0.01
# 8-71 blower through the hood: ribbed polished case on an intake manifold, belt drive at the
# front, and a two-throat injector hat with butterflies; zoomie headers
color #2a2a2a
material steel
box size=0.52,0.08,0.70 pos=0,1.22,1.70 bevel=0.02
color #c0c2c4
material chrome
box size=0.40,0.24,0.62 pos=0,1.38,1.70 bevel=0.04
for k = 0, 6
  box size=0.42,0.012,0.012 pos=0,1.30+k*0.025,1.70 rot=0,0,0
  box size=0.012,0.20,0.60 pos=0.205,1.38,1.70
end
box size=0.012,0.20,0.60 pos=-0.205,1.38,1.70
color #2a2a2a
material steel
cyl r=0.10 h=0.07 axis=z pos=0,1.42,2.04 seg=18
cyl r=0.07 h=0.07 axis=z pos=0,1.16,2.04 seg=16
color #111111
material rubber
box size=0.14,0.30,0.05 pos=0,1.29,2.045
color #c0c2c4
material chrome
box size=0.36,0.06,0.40 pos=0,1.53,1.65 bevel=0.02
color #1c1c1c
material steel
box size=0.34,0.16,0.36 pos=0,1.64,1.65 bevel=0.03
color #0a0a0a
material matte
box size=0.12,0.02,0.14 pos=0.08,1.725,1.65 mirror=x
color #c0c2c4
material chrome
box size=0.11,0.006,0.012 pos=0.08,1.73,1.65 rot=0,0,20 mirror=x
color #b0b2b4
material chrome
cyl r=0.04 h=0.55 pos=0.55,1.15,1.80 rot=-30,0,0 seg=8 mirror=x
cyl r=0.04 h=0.55 pos=0.55,1.15,1.45 rot=-30,0,0 seg=8 mirror=x
# Roll cage over the cab
color #1a1a1a
material steel
cyl r=0.04 h=1.29 pos=0.85,1.825,0.39 rot=-26.8,0,0 seg=8 mirror=x   # cowl (y1.25,z0.68) to roof bar (y2.40,z0.10)
cyl r=0.04 h=1.3 pos=0.85,1.90,-0.95 seg=8 mirror=x
cyl r=0.04 h=1.74 axis=x pos=0,2.40,0.10 seg=8
cyl r=0.04 h=1.74 axis=x pos=0,2.40,-0.95 seg=8
cyl r=0.04 h=1.05 axis=z pos=0.85,2.40,-0.42 seg=8 mirror=x
# Lights, light bar, bumpers
color #e8eef2
material lens
use vehicles/headlamp.mbcad w=0.30 h=0.18 n=2 pos=0.72,0.88,2.67 mirror=x
box size=1.40,0.08,0.06 pos=0,2.47,0.15
color #b01313
use vehicles/taillamp.mbcad w=0.08 h=0.30 pos=0.92,0.90,-3.09 rot=0,180,0 mirror=x
color #1a1a1a
material steel
box size=1.4,0.20,0.20 pos=0,0.10,2.60 bevel=0.03
box size=1.4,0.20,0.20 pos=0,0.10,-3.05 bevel=0.03
# ---- Cab glass ----
color #10161c
material glass
extrude depth=1.94 pts=0.64,1.21,0.34,1.82,-0.70,1.84,-0.88,1.27
color #141414
material matte
# Door lettering
color #f2b01a
material paint
text str=MEGA size=0.22 t=0.06 depth=0.01 pos=0.988,0.78,-0.15 rot=0,90,0
text str=MEGA size=0.22 t=0.06 depth=0.01 pos=-0.988,0.78,-0.15 rot=0,-90,0
# ---- Chassis detail: driveshafts, transfer case, steering, bypass shocks, limit straps ----
color #2b2b2b
material steel
box size=0.30,0.25,0.40 pos=0,-0.20,0.20
cyl r=0.05 h=1.50 axis=z pos=0,-0.38,1.00 rot=-10,0,0 seg=10
cyl r=0.05 h=2.00 axis=z pos=0,-0.38,-0.85 rot=9,0,0 seg=10
box size=0.18,0.16,0.20 pos=0.30,-0.15,2.20
# ---- Bed: aluminium fuel cell, battery box, strapped nitrous bottles ----
color #b9bcbf
material steel
box size=0.80,0.30,0.50 pos=0,0.68,-2.70 bevel=0.02
color #1a1a1a
material plastic
box size=0.36,0.26,0.24 pos=0.55,0.66,-1.45
color #1c4fa8
material paint
cyl r=0.08 h=0.80 axis=x pos=-0.30,0.62,-1.55 seg=12
cyl r=0.08 h=0.80 axis=x pos=-0.30,0.62,-1.75 seg=12
color #111111
material matte
box size=0.04,0.20,0.40 pos=-0.55,0.63,-1.65 mirror=x
# ---- Tube bumpers with hoops, tow points, chrome grille bars ----
color #1a1a1a
material steel
cyl r=0.05 h=1.30 axis=x pos=0,0.42,2.78 seg=10
cyl r=0.05 h=0.60 pos=0.62,0.40,2.72 rot=30,0,0 mirror=x seg=10
cyl r=0.05 h=1.30 axis=x pos=0,0.40,-3.18 seg=10
color #d03a10
material paint
box size=0.06,0.14,0.10 pos=0.45,0.12,2.74 mirror=x
color #c0c2c4
material chrome
for k = 0, 3
  box size=1.24,0.03,0.05 pos=0,0.74+k*0.075,2.685
end
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.84 bl=1.26 wz=0.62 bz=-0.86 ry=1.78 driver=driver
# Bolt-on kit: recovery points always, winch and snorkel when fitted in the garage
use vehicles/kit.mbcad fz=2.83 by=0.10 bw=1.40 rz=-3.23 ry=0.10 sx=1.04 sy0=1.10 sz0=1.10 sy1=1.86 sz1=0.34 winch=winch snorkel=snorkel
# Windscreen wipers parked along the base of the glass, with arms and pivot caps
color #111111
material matte
box size=0.593,0.012,0.024 pos=0.249,1.328,0.632 rot=61.82,0,0
box size=0.504,0.010,0.012 pos=0.269,1.335,0.645 rot=61.82,0,0
cyl r=0.022 h=0.03 pos=0.499,1.285,0.660 rot=61.82,0,0 seg=8
box size=0.593,0.012,0.024 pos=-0.270,1.328,0.632 rot=61.82,0,0
box size=0.504,0.010,0.012 pos=-0.250,1.335,0.645 rot=61.82,0,0
cyl r=0.022 h=0.03 pos=-0.021,1.285,0.660 rot=61.82,0,0 seg=8
# ---- Detail: cage light pods, side steps, hood pins, bed lettering ----
color #1a1a1a
material steel
for k = 0, 3
  box size=0.04,0.10,0.04 pos=-0.66+k*0.44,2.48,0.10
  use vehicles/headlamp.mbcad round=1 r=0.075 pos=-0.66+k*0.44,2.56,0.16
end
color #1a1a1a
material steel
cyl r=0.035 h=1.30 axis=z pos=1.02,0.30,-0.15 seg=10 mirror=x
box size=0.05,0.25,0.05 pos=1.02,0.40,0.40 mirror=x
box size=0.05,0.25,0.05 pos=1.02,0.40,-0.70 mirror=x
color #c0c2c4
material chrome
for s = -1, 1, 2
  cyl r=0.022 h=0.03 pos=s*0.75,1.165,2.45 seg=8
  cyl r=0.022 h=0.03 pos=s*0.75,1.19,1.05 seg=8
end
color #f2b01a
material paint
text str=MUD_BUDDIES size=0.10 t=0.028 depth=0.008 pos=0.982,0.90,-2.10 rot=0,90,0
text str=MUD_BUDDIES size=0.10 t=0.028 depth=0.008 pos=-0.982,0.90,-2.10 rot=0,-90,0
# Rear number plate with frame and plate lamp
material plastic
color #111111
box size=0.34,0.19,0.012 pos=0,0.62,-3.065
material matte
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.62,-3.0709999999999997
color #1a2a4a
text str=MEGA-54 size=0.045 t=0.012 depth=0.004 pos=0,0.615,-3.077 rot=0,180,0
color #b01313
text str=MUD_STATE size=0.014 t=0.004 depth=0.003 pos=0,0.675,-3.077 rot=0,180,0
material lens
color #fff6dc
box size=0.08,0.02,0.02 pos=0,0.725,-3.0749999999999997
