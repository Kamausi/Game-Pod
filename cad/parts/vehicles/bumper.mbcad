# Shared bumper, lofted across the width: front face toward +Z, origin at the bumper centre (place
# rear bumpers with rot=0,180,0). Takes the caller's colour and material for the main beam.
# style 0: steel plate bumper, chamfered section with wings kicking back at the ends, bolt row and
#          (front) a skid plate. style 1: rear step bumper (plate section with a diamond-plate step).
# style 2: classic rolled chrome bumper whose ends wrap back round the corners.
param w = 1.90
param h = 0.20
param d = 0.16
param style = 0
param skid = 0
set p0 = 1-min(1,style)
set p1 = 1-min(1,abs(style-1))
set c2 = 1-min(1,abs(style-2))
set pl = p0+p1
loft full=1 sec=-w/2:-(-d/2+(-0.13)),(-h/2)*0.72+(0.03),-(d/2-0.02+(-0.13)),(-h/2)*0.72+(0.03),-(d/2+(-0.13)),(-h/2+0.03)*0.72+(0.03),-(d/2+(-0.13)),(h/2-0.04)*0.72+(0.03),-(d/2-0.04+(-0.13)),(h/2)*0.72+(0.03),-(-d/2+(-0.13)),(h/2)*0.72+(0.03)|-w/2+0.10:-(-d/2+(-0.07)),(-h/2)*0.85+(0.015),-(d/2-0.02+(-0.07)),(-h/2)*0.85+(0.015),-(d/2+(-0.07)),(-h/2+0.03)*0.85+(0.015),-(d/2+(-0.07)),(h/2-0.04)*0.85+(0.015),-(d/2-0.04+(-0.07)),(h/2)*0.85+(0.015),-(-d/2+(-0.07)),(h/2)*0.85+(0.015)|-w/2+0.26:-(-d/2+(0)),(-h/2)*1+(0),-(d/2-0.02+(0)),(-h/2)*1+(0),-(d/2+(0)),(-h/2+0.03)*1+(0),-(d/2+(0)),(h/2-0.04)*1+(0),-(d/2-0.04+(0)),(h/2)*1+(0),-(-d/2+(0)),(h/2)*1+(0)|w/2-0.26:-(-d/2+(0)),(-h/2)*1+(0),-(d/2-0.02+(0)),(-h/2)*1+(0),-(d/2+(0)),(-h/2+0.03)*1+(0),-(d/2+(0)),(h/2-0.04)*1+(0),-(d/2-0.04+(0)),(h/2)*1+(0),-(-d/2+(0)),(h/2)*1+(0)|w/2-0.10:-(-d/2+(-0.07)),(-h/2)*0.85+(0.015),-(d/2-0.02+(-0.07)),(-h/2)*0.85+(0.015),-(d/2+(-0.07)),(-h/2+0.03)*0.85+(0.015),-(d/2+(-0.07)),(h/2-0.04)*0.85+(0.015),-(d/2-0.04+(-0.07)),(h/2)*0.85+(0.015),-(-d/2+(-0.07)),(h/2)*0.85+(0.015)|w/2:-(-d/2+(-0.13)),(-h/2)*0.72+(0.03),-(d/2-0.02+(-0.13)),(-h/2)*0.72+(0.03),-(d/2+(-0.13)),(-h/2+0.03)*0.72+(0.03),-(d/2+(-0.13)),(h/2-0.04)*0.72+(0.03),-(d/2-0.04+(-0.13)),(h/2)*0.72+(0.03),-(-d/2+(-0.13)),(h/2)*0.72+(0.03) n=3 m=1 rot=0,90,0 scale=pl,pl,pl
loft full=1 sec=-w/2:-(-d/2+(-0.20)),(-h/2+0.02)*0.80+(0),-(d/2-0.05+(-0.20)),(-h/2)*0.80+(0),-(d/2+(-0.20)),(-h/2+0.05)*0.80+(0),-(d/2+0.012+(-0.20)),(0)*0.80+(0),-(d/2+(-0.20)),(h/2-0.05)*0.80+(0),-(d/2-0.05+(-0.20)),(h/2)*0.80+(0),-(-d/2+(-0.20)),(h/2-0.02)*0.80+(0)|-w/2+0.08:-(-d/2+(-0.09)),(-h/2+0.02)*0.92+(0),-(d/2-0.05+(-0.09)),(-h/2)*0.92+(0),-(d/2+(-0.09)),(-h/2+0.05)*0.92+(0),-(d/2+0.012+(-0.09)),(0)*0.92+(0),-(d/2+(-0.09)),(h/2-0.05)*0.92+(0),-(d/2-0.05+(-0.09)),(h/2)*0.92+(0),-(-d/2+(-0.09)),(h/2-0.02)*0.92+(0)|-w/2+0.22:-(-d/2+(-0.01)),(-h/2+0.02)*1+(0),-(d/2-0.05+(-0.01)),(-h/2)*1+(0),-(d/2+(-0.01)),(-h/2+0.05)*1+(0),-(d/2+0.012+(-0.01)),(0)*1+(0),-(d/2+(-0.01)),(h/2-0.05)*1+(0),-(d/2-0.05+(-0.01)),(h/2)*1+(0),-(-d/2+(-0.01)),(h/2-0.02)*1+(0)|w/2-0.22:-(-d/2+(-0.01)),(-h/2+0.02)*1+(0),-(d/2-0.05+(-0.01)),(-h/2)*1+(0),-(d/2+(-0.01)),(-h/2+0.05)*1+(0),-(d/2+0.012+(-0.01)),(0)*1+(0),-(d/2+(-0.01)),(h/2-0.05)*1+(0),-(d/2-0.05+(-0.01)),(h/2)*1+(0),-(-d/2+(-0.01)),(h/2-0.02)*1+(0)|w/2-0.08:-(-d/2+(-0.09)),(-h/2+0.02)*0.92+(0),-(d/2-0.05+(-0.09)),(-h/2)*0.92+(0),-(d/2+(-0.09)),(-h/2+0.05)*0.92+(0),-(d/2+0.012+(-0.09)),(0)*0.92+(0),-(d/2+(-0.09)),(h/2-0.05)*0.92+(0),-(d/2-0.05+(-0.09)),(h/2)*0.92+(0),-(-d/2+(-0.09)),(h/2-0.02)*0.92+(0)|w/2:-(-d/2+(-0.20)),(-h/2+0.02)*0.80+(0),-(d/2-0.05+(-0.20)),(-h/2)*0.80+(0),-(d/2+(-0.20)),(-h/2+0.05)*0.80+(0),-(d/2+0.012+(-0.20)),(0)*0.80+(0),-(d/2+(-0.20)),(h/2-0.05)*0.80+(0),-(d/2-0.05+(-0.20)),(h/2)*0.80+(0),-(-d/2+(-0.20)),(h/2-0.02)*0.80+(0) n=3 m=1 rot=0,90,0 scale=c2,c2,c2
# Bolt row across the plate face
color #3a3a3a
material steel
for k = 0, 9
  cyl r=0.011*pl h=0.012 axis=z seg=6 pos=-w/2+0.32+k*(w-0.64)/9,h/2-0.045,d/2+0.003
  cyl r=0.011*pl h=0.012 axis=z seg=6 pos=-w/2+0.32+k*(w-0.64)/9,-h/2+0.045,d/2+0.003
end
# Skid plate under a front plate bumper
color #2a2a2a
box size=w*0.5*skid*p0,0.012,0.36 pos=0,-h/2-0.03,-0.08 rot=-14,0,0 bevel=0.004
# Diamond-plate step pad on a rear step bumper
color #9a9ea2
box size=0.60*p1,0.008,d-0.03 pos=0,h/2+0.004,-0.005
color #c4c8cc
for i = 0, 11
  for j = 0, 2
    box size=0.028*p1,0.006,0.012 pos=-0.27+i*0.049+mod(j,2)*0.024,h/2+0.011,-d/2+0.035+j*0.035 rot=0,45,0
  end
end
# Rubber over-riders and a licence-plate recess on the chrome bumper
color #151515
material rubber
box size=0.10*c2,0.07,0.04 pos=w/2-0.42,0,d/2+0.01 bevel=0.012
box size=0.10*c2,0.07,0.04 pos=-w/2+0.42,0,d/2+0.01 bevel=0.012
