# '86-'92 Jeep Comanche MJ, lifted, as seen in reference photos 1-2:
# grey paint, black fender flares (trimmed), front plate bumper with amber lights,
# chrome mirror, whip antenna, mud spatter (applied in-shader).
# Body frame: origin at frame height, +Z forward, +X left. Front axle z=1.29, rear z=-1.58.
param paint_r = 0.48
param paint_g = 0.50
param paint_b = 0.48
set W = 1.74
set FA = 1.29
set RA = -1.58
set AY = -0.30
set AR = 0.55
color paint_r paint_g paint_b
material paint
# Front clip: fenders, hood and grille surround in one side profile with the wheel arch cut in
extrude depth=W bevel=0.05 pts=0.52,-0.10,arc(FA,AY,AR,159,21,12),1.95,-0.10,1.97,0.05,1.97,0.34,1.93,0.42,1.82,0.455,0.55,0.48,0.52,0.48
# Doors / lower cab
extrude depth=W bevel=0.05 pts=0.53,-0.12,0.53,0.49,-0.79,0.49,-0.79,-0.12
# Roof skin, A- and B-pillars around the glass
extrude depth=W-0.06 bevel=0.03 pts=0.10,0.87,0.04,0.945,-0.70,0.955,-0.765,0.90,-0.765,0.87
box size=0.07,0.61,0.07 pos=W/2-0.065,0.69,0.28 rot=-46.3,0,0 bevel=0.02 mirror=x
box size=0.07,0.44,0.10 pos=W/2-0.065,0.70,-0.72 bevel=0.02 mirror=x
# Bed sides with the rear arch, top rail caps, front wall and tailgate
extrude depth=0.06 bevel=0.02 pts=-0.82,-0.12,arc(RA,AY,AR,21,159,12),-2.47,-0.12,-2.47,0.64,-0.82,0.64 pos=W/2-0.03,0,0 mirror=x
box size=0.10,0.03,1.66 pos=W/2-0.05,0.655,-1.645 bevel=0.012 mirror=x
box size=W-0.12,0.62,0.05 pos=0,0.33,-0.83
box size=W-0.10,0.60,0.05 pos=0,0.33,-2.455 bevel=0.015
box size=0.22,0.30,0.95 pos=W/2-0.17,0.18,RA bevel=0.05 mirror=x
color #1f1e1c
material matte
box size=W-0.12,0.04,1.62 pos=0,0.10,-1.64
box size=0.36,0.05,0.03 pos=0,0.52,-2.485 bevel=0.01
# Glass greenhouse: windshield, door glass and back light in one tinted extrusion
color #121a20
material glass
extrude depth=W-0.10 bevel=0.03 pts=0.50,0.48,0.06,0.90,-0.70,0.91,-0.76,0.48
# Black trim: beltline seal, cowl vent, wipers, door seams
color #111111
material matte
box size=W+0.004,0.022,1.30 pos=0,0.49,-0.13
box size=W-0.20,0.02,0.10 pos=0,0.49,0.50
box size=0.012,0.012,0.52 pos=0.30,0.505,0.40 rot=0,8,0 mirror=x
box size=0.006,0.58,0.006 pos=W/2+0.001,0.19,0.50 mirror=x
box size=0.006,0.58,0.006 pos=W/2+0.001,0.19,-0.69 mirror=x
box size=0.006,0.012,1.18 pos=W/2+0.001,-0.10,-0.10 mirror=x
# Fender flares (trimmed for big tires) following the arches
color #161616
extrude depth=0.10 bevel=0.02 pts=arc(FA,AY,AR+0.09,165,15,14),arc(FA,AY,AR-0.015,15,165,14) pos=W/2+0.035,0,0 mirror=x
extrude depth=0.10 bevel=0.02 pts=arc(RA,AY,AR+0.09,165,15,14),arc(RA,AY,AR-0.015,15,165,14) pos=W/2+0.035,0,0 mirror=x
# Grille: black panel with vertical chrome-edged slots between square headlights
color #0d0d0d
box size=0.84,0.22,0.03 pos=0,0.24,1.965
color #3a3d40
material steel
box size=0.025,0.20,0.03 pos=0.05,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.15,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.25,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.35,0.24,1.978 mirror=x
color #c8c8c4
material chrome
box size=0.24,0.20,0.025 pos=0.58,0.25,1.97 bevel=0.008 mirror=x
color #f0eee0
material lens
box size=0.20,0.16,0.03 pos=0.58,0.25,1.975 bevel=0.01 mirror=x
color #e08a1a
box size=0.12,0.07,0.04 pos=0.72,0.02,2.08 bevel=0.01 mirror=x
box size=0.02,0.05,0.10 pos=W/2+0.002,0.30,1.72 mirror=x
color #a01010
box size=0.06,0.24,0.04 pos=W/2-0.05,0.46,-2.475 bevel=0.01 mirror=x
box size=0.02,0.05,0.08 pos=W/2+0.002,0.50,-2.36 mirror=x
# Black steel plate bumpers, frame rails, rear step
color #171717
material steel
box size=1.86,0.20,0.14 pos=0,0.02,2.01 bevel=0.015
box size=1.80,0.16,0.12 pos=0,0.02,-2.53 bevel=0.015
box size=0.10,0.14,3.90 pos=0.48,-0.19,-0.30 mirror=x
box size=0.12,0.30,0.06 pos=0.66,-0.04,1.96 bevel=0.01 mirror=x
# Chrome mirrors on black arms, door handles, whip antenna, exhaust tip
color #c9c9c4
material chrome
box size=0.06,0.15,0.11 pos=W/2+0.10,0.66,0.36 bevel=0.02 mirror=x
box size=0.02,0.03,0.12 pos=W/2+0.004,0.40,-0.55 bevel=0.008 mirror=x
cyl r=0.035 h=0.12 axis=z pos=-0.55,-0.18,-2.60
color #1a1a1a
material matte
box size=0.12,0.02,0.04 pos=W/2+0.05,0.62,0.38 mirror=x
cyl r=0.004 h=0.9 pos=0.82,0.88,0.95
