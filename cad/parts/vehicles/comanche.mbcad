# '86-'92 Jeep Comanche MJ, lifted, as seen in reference photos 1-2:
# grey paint, black fender flares (trimmed), front plate bumper with amber lights,
# chrome mirror, whip antenna, mud spatter (applied in-shader).
# Body frame: origin at frame height, +Z forward, +X left. Front axle z=1.29, rear z=-1.58.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.48
param paint_g = 0.50
param paint_b = 0.48
set W = 1.74
set FA = 1.29
set RA = -1.58
set AY = -0.30
set AR = 0.55
# High-fidelity surfacing: smoother curves and rounded edges everywhere, then the whole truck is
# shaped as one: greenhouse tumblehome, barrelled door skins, tapered nose and tail, a slight
# plan-view bow and a crowned hood and roof (details on the panels follow the surface).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.11 ty0=0.46 ty1=0.95 crown=0.03 cy0=0.80 cy1=0.90 hw=0.87
color paint_r paint_g paint_b
material paint
# >>> body shell (generated by tools/gen_truck_bodies.py)
# Lofted lower body: rocker roll-under, barrelled door, character crease, rounded shoulder,
# crowned hood; wheel openings clipped exactly and backed by wheelhouse liners.
color paint_r paint_g paint_b
material paint
loft sec=-0.79:0.0000,-0.0900,0.7700,-0.0900,0.8120,-0.0500,0.8200,0.0500,0.8220,0.2900,0.8290,0.3020,0.8210,0.3140,0.8140,0.4300,0.7900,0.4650,0.7600,0.4700,0.4100,0.4700,0.0000,0.4700|-0.77:0.0000,-0.1150,0.8050,-0.1150,0.8470,-0.0750,0.8550,0.0350,0.8570,0.2930,0.8640,0.3050,0.8560,0.3170,0.8490,0.4450,0.8250,0.4800,0.7950,0.4850,0.4275,0.4850,0.0000,0.4850|-0.7:0.0000,-0.1200,0.8200,-0.1200,0.8620,-0.0800,0.8700,0.0325,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8640,0.4500,0.8400,0.4850,0.8100,0.4900,0.4350,0.4900,0.0000,0.4900|0.5:0.0000,-0.1200,0.8200,-0.1200,0.8620,-0.0800,0.8700,0.0325,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8640,0.4500,0.8400,0.4850,0.8100,0.4900,0.4350,0.4900,0.0000,0.4900|0.56:0.0000,-0.1100,0.8200,-0.1100,0.8620,-0.0700,0.8700,0.0375,0.8720,0.2910,0.8790,0.3030,0.8710,0.3150,0.8640,0.4400,0.8400,0.4750,0.8100,0.4800,0.4350,0.4950,0.0000,0.5000|0.95:0.0000,-0.1000,0.8200,-0.1000,0.8620,-0.0600,0.8700,0.0425,0.8720,0.2870,0.8790,0.2990,0.8710,0.3110,0.8640,0.4300,0.8400,0.4650,0.8100,0.4700,0.4350,0.4887,0.0000,0.4950|1.5:0.0000,-0.1000,0.8200,-0.1000,0.8620,-0.0600,0.8700,0.0388,0.8720,0.2765,0.8790,0.2885,0.8710,0.3005,0.8640,0.4150,0.8400,0.4500,0.8100,0.4550,0.4350,0.4738,0.0000,0.4800|1.9:0.0000,-0.1000,0.8150,-0.1000,0.8570,-0.0600,0.8650,0.0338,0.8670,0.2625,0.8740,0.2745,0.8660,0.2865,0.8590,0.3950,0.8350,0.4300,0.8050,0.4350,0.4325,0.4500,0.0000,0.4550|1.95:0.0000,-0.0600,0.7950,-0.0600,0.8370,-0.0200,0.8450,0.0525,0.8470,0.2430,0.8540,0.2550,0.8460,0.2670,0.8390,0.3500,0.8150,0.3850,0.7850,0.3900,0.4225,0.3975,0.0000,0.4000|1.97:0.0000,0.0200,0.7500,0.0200,0.7920,0.0600,0.8000,0.0950,0.8020,0.2180,0.8090,0.2300,0.8010,0.2420,0.7940,0.2800,0.7700,0.3150,0.7400,0.3200,0.4000,0.3237,0.0000,0.3250 n=3 m=2
