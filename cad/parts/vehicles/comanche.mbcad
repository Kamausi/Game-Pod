# '86-'92 Jeep Comanche MJ, lifted, as seen in reference photos 1-2:
# grey paint, black fender flares (trimmed), front plate bumper with amber lights,
# chrome mirror, whip antenna, mud spatter (applied in-shader).
# Body frame: origin at frame height, +Z forward, +X left. Front axle z=1.29, rear z=-1.58.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.48
param paint_g = 0.50
param paint_b = 0.48
set W = 1.74
set FA = 1.29
set RA = -1.58
set AY = -0.30
set AR = 0.55
# High-fidelity surfacing: smoother curves and rounded edges everywhere, then the whole truck is
# shaped as one: greenhouse tumblehome, barrelled door skins, tapered nose and tail, a slight
# plan-view bow and a crowned hood and roof (details on the panels follow the surface).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.11 ty0=0.46 ty1=0.95 barrel=0.035 by0=-0.15 by1=0.50 bow=0.018 bz0=-2.55 bz1=2.05 taperf=0.07 tf0=1.20 tf1=2.05 taperr=0.03 tr0=-1.9 tr1=-2.55 crown=0.045 cy0=0.36 cy1=0.47 hw=0.87
color paint_r paint_g paint_b
material paint
# Front clip: fenders, hood and grille surround in one side profile with the wheel arch cut in
extrude depth=W bevel=0.085 pts=0.52,-0.10,arc(FA,AY,AR,159,21,12),1.95,-0.10,1.97,0.05,1.97,0.34,1.93,0.42,1.82,0.455,0.55,0.48,0.52,0.48
# Doors / lower cab
extrude depth=W bevel=0.085 pts=0.53,-0.12,0.53,0.49,-0.79,0.49,-0.79,-0.12
# Roof skin, A- and B-pillars around the glass
extrude depth=W-0.06 bevel=0.03 pts=0.10,0.87,0.04,0.945,-0.70,0.955,-0.765,0.90,-0.765,0.87
box size=0.07,0.61,0.07 pos=W/2-0.065,0.69,0.28 rot=-46.3,0,0 bevel=0.02 mirror=x
box size=0.07,0.44,0.10 pos=W/2-0.065,0.70,-0.72 bevel=0.02 mirror=x
# Bed sides with the rear arch, top rail caps, front wall and tailgate
extrude depth=0.06 bevel=0.02 pts=-0.82,-0.12,arc(RA,AY,AR,21,159,12),-2.47,-0.12,-2.47,0.64,-0.82,0.64 pos=W/2-0.03,0,0 mirror=x
box size=0.10,0.03,1.66 pos=W/2-0.05,0.655,-1.645 bevel=0.012 mirror=x
box size=W-0.12,0.62,0.05 pos=0,0.33,-0.83
box size=W-0.10,0.60,0.05 pos=0,0.33,-2.455 bevel=0.015
box size=0.22,0.30,0.95 pos=W/2-0.17,0.18,RA bevel=0.05 mirror=x
color #1f1e1c
material matte
box size=W-0.12,0.04,1.62 pos=0,0.10,-1.64
box size=0.36,0.05,0.03 pos=0,0.52,-2.485 bevel=0.01
# Glass greenhouse: windshield, door glass and back light in one tinted extrusion
color #121a20
material glass
extrude depth=W-0.10 bevel=0.03 pts=0.50,0.48,0.06,0.90,-0.70,0.91,-0.76,0.48
# Black trim: beltline seal, cowl vent, wipers, door seams
color #111111
material matte
box size=W+0.004,0.022,1.30 pos=0,0.49,-0.13
box size=W-0.20,0.02,0.10 pos=0,0.49,0.50
box size=0.012,0.012,0.52 pos=0.30,0.505,0.40 rot=0,8,0 mirror=x
box size=0.006,0.58,0.006 pos=W/2+0.001,0.19,0.50 mirror=x
box size=0.006,0.58,0.006 pos=W/2+0.001,0.19,-0.69 mirror=x
box size=0.006,0.012,1.18 pos=W/2+0.001,-0.10,-0.10 mirror=x
# Fender flares (trimmed for big tires) following the arches
color #161616
extrude depth=0.10 bevel=0.02 pts=arc(FA,AY,AR+0.09,165,15,14),arc(FA,AY,AR-0.015,15,165,14) pos=W/2+0.035,0,0 mirror=x
extrude depth=0.10 bevel=0.02 pts=arc(RA,AY,AR+0.09,165,15,14),arc(RA,AY,AR-0.015,15,165,14) pos=W/2+0.035,0,0 mirror=x
# Grille: black panel with vertical chrome-edged slots between square headlights
color #0d0d0d
box size=0.84,0.22,0.03 pos=0,0.24,1.965
color #7a7e82
material steel
box size=0.025,0.20,0.03 pos=0.05,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.15,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.25,0.24,1.978 mirror=x
box size=0.025,0.20,0.03 pos=0.35,0.24,1.978 mirror=x
# Chrome grille surround, centre crossbar and badge
color #c8c8c4
material chrome
box size=0.88,0.022,0.03 pos=0,0.355,1.982
box size=0.88,0.022,0.03 pos=0,0.125,1.982
box size=0.022,0.25,0.03 pos=0.43,0.24,1.982 mirror=x
box size=0.84,0.03,0.035 pos=0,0.24,1.985
color #b01010
material paint
text str=MB size=0.03 t=0.01 depth=0.006 pos=0,0.24,2.004
color #c8c8c4
material chrome
box size=0.24,0.20,0.025 pos=0.58,0.25,1.97 bevel=0.008 mirror=x
color #f0eee0
material lens
use vehicles/headlamp.mbcad w=0.20 h=0.16 n=1 pos=0.58,0.25,1.99 mirror=x
color #e08a1a
box size=0.12,0.07,0.04 pos=0.72,0.02,2.08 bevel=0.01 mirror=x
box size=0.02,0.05,0.10 pos=W/2+0.002,0.30,1.72 mirror=x
color #a01010
use vehicles/taillamp.mbcad w=0.08 h=0.26 pos=W/2-0.05,0.46,-2.495 rot=0,180,0 mirror=x
box size=0.02,0.05,0.08 pos=W/2+0.002,0.50,-2.36 mirror=x
# Black steel plate bumpers, frame rails, rear step
color #171717
material steel
box size=1.86,0.20,0.14 pos=0,0.02,2.01 bevel=0.015
box size=1.80,0.16,0.12 pos=0,0.02,-2.53 bevel=0.015
box size=0.10,0.14,3.90 pos=0.48,-0.19,-0.30 mirror=x
box size=0.12,0.30,0.06 pos=0.66,-0.04,1.96 bevel=0.01 mirror=x
# Chrome mirrors on black arms, door handles, whip antenna, exhaust tip
color #c9c9c4
material chrome
box size=0.06,0.15,0.11 pos=W/2+0.10,0.66,0.36 bevel=0.02 mirror=x
box size=0.02,0.03,0.12 pos=W/2+0.004,0.40,-0.55 bevel=0.008 mirror=x
cyl r=0.035 h=0.12 axis=z pos=-0.55,-0.18,-2.60
color #1a1a1a
material matte
box size=0.12,0.02,0.04 pos=W/2+0.05,0.62,0.38 mirror=x
cyl r=0.004 h=0.9 pos=0.82,0.88,0.95
# ---- Mud-truck build-out ----
# Roof light bar on low mounts with six LED cubes, and A-pillar ditch lights
color #151515
material steel
box size=1.30,0.08,0.10 pos=0,1.02,0.0 bevel=0.02
box size=0.05,0.08,0.05 pos=0.55,0.97,0.0 mirror=x
color #f4f8ff
material lens
for k = 0, 5
  box size=0.15,0.05,0.012 pos=-0.55+k*0.22,1.02,0.052
end
color #151515
material steel
box size=0.10,0.10,0.10 pos=W/2+0.02,0.52,0.50 bevel=0.02 mirror=x
color #fff4d0
material lens
box size=0.08,0.08,0.012 pos=W/2+0.02,0.52,0.555 mirror=x
# Rock sliders along the sills (tube with three outriggers)
color #1a1a1a
material steel
cyl r=0.035 h=1.30 axis=z pos=W/2+0.10,-0.16,-0.14 seg=8 mirror=x
for k = -1, 1
  box size=0.12,0.04,0.04 pos=W/2+0.05,-0.16,-0.14+k*0.55 mirror=x
end
# Bed roll bar with two round lights, a strapped spare and a jerry can
color #151515
material steel
cyl r=0.035 h=0.70 pos=W/2-0.12,0.95,-0.95 seg=8 mirror=x
cyl r=0.035 h=W-0.24 axis=x pos=0,1.30,-0.95 seg=8
cyl r=0.03 h=0.60 pos=W/2-0.12,0.88,-1.13 rot=40,0,0 seg=8 mirror=x
for s = -1, 1, 2
  color #151515
  cyl r=0.08 h=0.08 axis=z pos=s*0.40,1.38,-0.93 seg=12
  color #fff4d0
  material lens
  cyl r=0.065 h=0.01 axis=z pos=s*0.40,1.38,-0.885 seg=12
  material steel
end
color #121212
material rubber
tire r=0.38 w=0.25 rim=0.19 lugs=16 depth=0.025 tread=mt pos=0.18,0.36,-1.60 rot=0,0,90
color #222222
material steel
cyl r=0.19 h=0.22 pos=0.18,0.36,-1.60 seg=12
color #d07a12
material plastic
cyl r=0.012 h=0.80 axis=z pos=0.18,0.49,-1.60 seg=5
color #c41a1a
material paint
box size=0.17,0.46,0.32 pos=-0.55,0.38,-2.20 bevel=0.03
color #1a1a1a
box size=0.07,0.05,0.04 pos=-0.55,0.63,-2.12
# Orange traction boards clipped to the bed side (passenger)
color #f06010
material plastic
for k = 0, 1
  box size=0.025,0.30,1.05 pos=-W/2-0.02-k*0.03,0.32,-1.62 bevel=0.01
end
color #c84a0a
for k = 0, 5
  box size=0.03,0.04,0.12 pos=-W/2-0.05,0.24+k*0.035,-1.62+0.35*sin(k*60) 
end
# Mud flaps behind the rear wheels
color #121212
material rubber
box size=0.36,0.42,0.012 pos=W/2-0.12,-0.30,-2.30 mirror=x
color #e8e8e2
material paint
box size=0.30,0.04,0.014 pos=W/2-0.12,-0.16,-2.30 mirror=x
# Door lettering both sides
color #e8b020
material paint
text str=MUD_BUDDIES size=0.07 t=0.022 depth=0.006 pos=W/2+0.004,0.27,-0.12 rot=0,90,0
text str=MUD_BUDDIES size=0.07 t=0.022 depth=0.006 pos=-W/2-0.004,0.27,-0.12 rot=0,-90,0
color #f2f2ee
text str=4X4 size=0.07 t=0.022 depth=0.006 pos=W/2+0.004,0.10,-2.0 rot=0,90,0
# Side-exit exhaust tip ahead of the rear wheel (passenger)
color #6a6a66
material steel
cyl r=0.04 h=0.18 axis=x pos=-W/2+0.02,-0.18,-0.92 seg=10
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.60 bl=0.48 wz=0.50 bz=-0.76 ry=0.88 driver=driver
# Bolt-on kit: recovery points always, winch and snorkel when fitted in the garage
use vehicles/kit.mbcad fz=2.08 by=0.02 bw=1.86 rz=-2.60 ry=0.02 sx=0.93 sy0=0.30 sz0=0.80 sy1=0.95 sz1=0.08 winch=winch snorkel=snorkel
# Windscreen wipers parked along the base of the glass, with arms and pivot caps
color #111111
material matte
box size=0.522,0.012,0.024 pos=0.220,0.540,0.473 rot=43.67,0,0
box size=0.444,0.010,0.012 pos=0.240,0.551,0.484 rot=43.67,0,0
cyl r=0.022 h=0.03 pos=0.439,0.510,0.512 rot=43.67,0,0 seg=8
box size=0.522,0.012,0.024 pos=-0.238,0.540,0.473 rot=43.67,0,0
box size=0.444,0.010,0.012 pos=-0.218,0.551,0.484 rot=43.67,0,0
cyl r=0.022 h=0.03 pos=-0.019,0.510,0.512 rot=43.67,0,0 seg=8
# Bolt heads along the fender flares
color #2a2a2a
material steel
for k = 0, 7
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.091,AY+(AR+0.037)*sin(160-k*20),FA+(AR+0.037)*cos(160-k*20) mirror=x
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.091,AY+(AR+0.037)*sin(160-k*20),RA+(AR+0.037)*cos(160-k*20) mirror=x
end
