loft full=1 sec=-0.820:0.8000,-0.1100,0.8000,-0.1200,0.8620,-0.0800,0.8700,0.0000,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8660,0.6000,0.8400,0.6370,0.8200,0.6400,0.7500,0.6400,0.7500,0.5900,0.8000,0.5700|-0.860:0.8000,-0.1100,0.8000,-0.1200,0.8620,-0.0800,0.8700,0.0000,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8660,0.6000,0.8400,0.6370,0.8200,0.6400,0.7500,0.6400,0.7500,0.5900,0.8000,0.5700|-2.430:0.8000,-0.1100,0.8000,-0.1200,0.8620,-0.0800,0.8700,0.0000,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8660,0.6000,0.8400,0.6370,0.8200,0.6400,0.7500,0.6400,0.7500,0.5900,0.8000,0.5700|-2.470:0.8000,-0.1100,0.8000,-0.1200,0.8620,-0.0800,0.8700,0.0000,0.8720,0.2950,0.8790,0.3070,0.8710,0.3190,0.8660,0.6000,0.8400,0.6370,0.8200,0.6400,0.7500,0.6400,0.7500,0.5900,0.8000,0.5700 n=2 m=2 mirror=x
