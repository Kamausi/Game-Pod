# Sport side-by-side UTV (photo 3, left): white/black panels, tube cage, roof.
# Front axle z=1.03, rear z=-1.26.
param paint_r = 0.92
param paint_g = 0.92
param paint_b = 0.90
set W = 1.50
color #1c1c1c
box size=W-0.2,0.30,2.70 pos=0,0.05,-0.15
color paint_r paint_g paint_b
wedge size=W-0.1,0.34,0.95 pos=0,0.28,1.20 rot=0,180,0
box size=W-0.1,0.18,0.90 pos=0,0.25,-1.30
box size=0.06,0.30,0.95 pos=W/2-0.06,0.32,1.05 mirror=x
color #222222
# Seats
box size=0.48,0.10,0.50 pos=0.33,0.25,-0.15 mirror=x
box size=0.48,0.70,0.10 pos=0.33,0.55,-0.42 mirror=x rot=-12,0,0
# Roll cage
color #151515
cyl r=0.025 h=1.25 pos=0.62,0.80,0.35 rot=-18,0,0 mirror=x
cyl r=0.025 h=1.20 pos=0.62,0.78,-0.55 mirror=x
cyl r=0.025 h=1.25 pos=0,1.40,0.20 axis=x
cyl r=0.025 h=1.25 pos=0,1.38,-0.55 axis=x
cyl r=0.025 h=0.80 pos=0.62,1.40,-0.18 axis=z mirror=x
color #f5f5f5
box size=1.30,0.03,0.85 pos=0,1.43,-0.18
color #e8e2c8
box size=0.20,0.06,0.03 pos=0.40,0.42,1.66 mirror=x
