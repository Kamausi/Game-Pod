# Sport side-by-side UTV (photo 3, left): white/black panels, tube cage, roof.
# Sculpted hood with LED slit headlights and a light bar, front bumper with winch plate,
# long-travel A-arms with coilovers, skid plate and rock sliders, bucket seats with harnesses,
# dash and steering, tube cage (A-pillars into roof rails, B-hoop, rear braces) under a roof,
# half doors, side intakes, cargo bed with rails and a spare, exhaust, LED tails, whip flag.
# Body frame: +Z forward, +X left. Front axle z=1.03, rear z=-1.26.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param paint_r = 0.92
param paint_g = 0.92
param paint_b = 0.90
set W = 1.50
set FA = 1.03
set RA = -1.26
set AY = -0.18
set AR = 0.48
set HX = 0.70          # hub x for the suspension arms

# ---- Floor tub, skid plate, rock sliders ----
# High-fidelity surfacing: smoother curves and rounded edges, then the whole vehicle is shaped
# as one (tumblehome, barrelled sides, tapered nose/tail, plan bow, crowned hood and roof).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.05 ty0=0.6 ty1=1.43 barrel=0.04 by0=0.0 by1=0.55 taperf=0.08 tf0=0.9 tf1=1.72 taperr=0.04 tr0=-1.0 tr1=-1.88 crown=0.04 cy0=0.3 cy1=0.5 hw=0.75
color #1c1c1c
material matte
box size=W-0.2,0.30,2.70 pos=0,0.05,-0.15 bevel=0.04
color #6a6e72
material steel
box size=0.95,0.03,2.50 pos=0,-0.115,-0.15
box size=0.06,0.06,1.25 pos=W/2-0.08,-0.06,-0.10 mirror=x

# ---- Painted body: hood/front fenders and rear fenders/cargo box with the arches ----
color paint_r paint_g paint_b
material paint
extrude depth=W-0.08 bevel=0.05 pts=0.55,0.00,arc(FA,AY,AR,158,22,10),1.62,0.0,1.70,0.20,1.62,0.42,0.95,0.52,0.60,0.55,0.55,0.45
extrude depth=W-0.08 bevel=0.05 pts=-0.62,0.05,arc(RA,AY,AR,22,158,10),-1.86,0.05,-1.88,0.36,-0.62,0.40
# Sculpted hood (lofted): crowned centre spine falling to a rounded nose
loft sec=0.620:0.000,0.300,0.700,0.300,0.700,0.475,0.574,0.545,0.245,0.573,0.000,0.595|0.950:0.000,0.300,0.700,0.300,0.700,0.455,0.574,0.525,0.245,0.553,0.000,0.575|1.300:0.000,0.300,0.660,0.300,0.660,0.400,0.541,0.470,0.231,0.498,0.000,0.520|1.550:0.000,0.300,0.600,0.300,0.600,0.340,0.492,0.410,0.210,0.438,0.000,0.460|1.680:0.000,0.300,0.520,0.300,0.520,0.260,0.426,0.330,0.182,0.358,0.000,0.380|1.720:0.000,0.300,0.440,0.300,0.440,0.180,0.361,0.250,0.154,0.278,0.000,0.300 n=4 m=3
# Moulded fender flares arching over all four wheels
color #141414
material plastic
loft sec=0.510:0.000,-0.084,0.070,-0.099,0.090,-0.074,0.070,-0.042,0.000,-0.034|0.580:0.000,0.068,0.070,0.053,0.090,0.078,0.070,0.110,0.000,0.118|0.710:0.000,0.205,0.070,0.190,0.090,0.215,0.070,0.247,0.000,0.255|0.870:0.000,0.286,0.070,0.271,0.090,0.296,0.070,0.328,0.000,0.336|1.030:0.000,0.310,0.070,0.295,0.090,0.320,0.070,0.352,0.000,0.360|1.190:0.000,0.286,0.070,0.271,0.090,0.296,0.070,0.328,0.000,0.336|1.350:0.000,0.205,0.070,0.190,0.090,0.215,0.070,0.247,0.000,0.255|1.480:0.000,0.068,0.070,0.053,0.090,0.078,0.070,0.110,0.000,0.118|1.550:0.000,-0.084,0.070,-0.099,0.090,-0.074,0.070,-0.042,0.000,-0.034 n=4 m=3 pos=W/2-0.02,0,0 mirror=x
loft sec=-1.780:0.000,-0.084,0.070,-0.099,0.090,-0.074,0.070,-0.042,0.000,-0.034|-1.710:0.000,0.068,0.070,0.053,0.090,0.078,0.070,0.110,0.000,0.118|-1.580:0.000,0.205,0.070,0.190,0.090,0.215,0.070,0.247,0.000,0.255|-1.420:0.000,0.286,0.070,0.271,0.090,0.296,0.070,0.328,0.000,0.336|-1.260:0.000,0.310,0.070,0.295,0.090,0.320,0.070,0.352,0.000,0.360|-1.100:0.000,0.286,0.070,0.271,0.090,0.296,0.070,0.328,0.000,0.336|-0.940:0.000,0.205,0.070,0.190,0.090,0.215,0.070,0.247,0.000,0.255|-0.810:0.000,0.068,0.070,0.053,0.090,0.078,0.070,0.110,0.000,0.118|-0.740:0.000,-0.084,0.070,-0.099,0.090,-0.074,0.070,-0.042,0.000,-0.034 n=4 m=3 pos=W/2-0.02,0,0 mirror=x
# Black accent panels: hood stripe, lower nose, fender liners, side intakes
color #141414
material matte
box size=0.20,0.012,0.80 pos=0,0.585,1.05 rot=-6,0,0
box size=1.10,0.16,0.04 pos=0,0.12,1.69 rot=-12,0,0
for k = 0, 3
  box size=0.012,0.045,0.30 pos=W/2-0.04+0.005,0.30+k*0.07,-0.95 mirror=x
end

