# Utility ATV mud build with seated rider: twin snorkels behind the bars, radiator relocated
# up on the front rack, steel racks, front winch. Body frame: +Z fwd, +X left.
# Front axle z=0.715, rear z=-0.585, track 0.98, wheel centres y=-0.12 (29" tyres, r~0.37).
param lod = 0             # 1 = far version: unshaped, coarser curves
param paint_r = 0.15
param paint_g = 0.35
param paint_b = 0.16
param rider_r = 0.75
param rider_g = 0.15
param rider_b = 0.10
set FA = 0.715
set RA = -0.585
# Frame, skid plate and footwells (between the wheels)
# High-fidelity surfacing: smoother curves and rounded edges, then the whole vehicle is shaped
# as one (tumblehome, barrelled sides, tapered nose/tail, plan bow, crowned hood and roof).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 barrel=0.05 by0=-0.1 by1=0.45 taperf=0.06 tf0=0.8 tf1=1.2 crown=0.03 cy0=0.2 cy1=0.4 hw=0.65
color #1d1d1d
material steel
box size=0.42,0.16,1.55 pos=0,-0.05,0.05 bevel=0.03
box size=0.22,0.03,0.40 pos=0.30,0.04,0.05 mirror=x
cyl r=0.04 h=0.86 axis=x pos=0,-0.12,FA
cyl r=0.04 h=0.86 axis=x pos=0,-0.12,RA
# Moulded plastic bodywork (lofted shells): arched fenders over all four tyres, a crowned
# tank/hood running down to the nose, and a tail section under the seat
color paint_r paint_g paint_b
material plastic
loft sec=0.255:0.000,-0.079,0.180,-0.094,0.205,-0.069,0.180,-0.034,0.000,-0.024|0.315:0.000,0.072,0.180,0.057,0.205,0.082,0.180,0.117,0.000,0.127|0.415:0.000,0.187,0.180,0.172,0.205,0.197,0.180,0.232,0.000,0.242|0.565:0.000,0.270,0.180,0.255,0.205,0.280,0.180,0.315,0.000,0.325|0.715:0.000,0.295,0.180,0.280,0.205,0.305,0.180,0.340,0.000,0.350|0.865:0.000,0.270,0.180,0.255,0.205,0.280,0.180,0.315,0.000,0.325|1.015:0.000,0.187,0.180,0.172,0.205,0.197,0.180,0.232,0.000,0.242|1.115:0.000,0.072,0.180,0.057,0.205,0.082,0.180,0.117,0.000,0.127|1.175:0.000,-0.079,0.180,-0.094,0.205,-0.069,0.180,-0.034,0.000,-0.024 n=4 m=3 pos=0.47,0,0 mirror=x
