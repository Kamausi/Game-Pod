color #b01313
box size=0.10,0.04,0.02 pos=0.22,0.34,-0.99 mirror=x
# Rider: riding jacket and pants, jointed arms and legs, gloves on the grips, boots on the
# footwells, motocross helmet with chin bar, peak and goggles, race number on the back
color #2a3442
material matte
