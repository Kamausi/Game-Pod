# Late-1970s "square-body" full-size short-bed pickup, built as a lifted mud truck:
# slab sides with the full-length trim crease, flat hood, egg-crate grille between
# rectangular headlights, chrome bumpers, trimmed black flares, bed roll bar with lights
# and twin stacks behind the cab.
# Body frame: origin at frame height, +Z forward, +X left. Front axle z=1.311, rear z=-1.669.
param paint_r = 0.62
param paint_g = 0.18
param paint_b = 0.12
set W = 1.94
set FA = 1.311
set RA = -1.669
set AY = -0.30
set AR = 0.56
color paint_r paint_g paint_b
material paint
# Front clip: fenders, flat hood and grille surround in one side profile with the arch cut in
extrude depth=W bevel=0.04 pts=0.55,-0.10,arc(FA,AY,AR,159,21,12),2.20,-0.10,2.22,0.04,2.22,0.50,2.19,0.535,0.55,0.545
# Regular cab: doors / lower cab
extrude depth=W bevel=0.04 pts=0.55,-0.12,0.55,0.545,-0.64,0.545,-0.64,-0.12
# Flat roof skin with drip rails, A- and B-pillars around the glass
extrude depth=W-0.08 bevel=0.03 pts=0.12,0.955,0.08,1.0,-0.58,1.0,-0.64,0.97,-0.64,0.955
box size=0.07,0.62,0.07 pos=W/2-0.06,0.7575,0.325 rot=-46.6,0,0 bevel=0.02 mirror=x
box size=0.07,0.43,0.10 pos=W/2-0.06,0.76,-0.59 bevel=0.02 mirror=x
box size=W-0.10,0.03,0.04 pos=0,0.985,0.10 bevel=0.01
# Short bed: sides with the rear arch, rail caps, front wall, tailgate and wheel tubs
extrude depth=0.06 bevel=0.02 pts=-0.68,-0.12,arc(RA,AY,AR,21,159,12),-2.48,-0.12,-2.48,0.56,-0.68,0.56 pos=W/2-0.03,0,0 mirror=x
box size=0.10,0.03,1.82 pos=W/2-0.05,0.575,-1.58 bevel=0.012 mirror=x
box size=W-0.12,0.44,0.05 pos=0,0.34,-0.70
box size=W-0.08,0.46,0.05 pos=0,0.33,-2.465 bevel=0.015
box size=0.26,0.26,1.00 pos=W/2-0.19,0.31,RA bevel=0.05 mirror=x
color #1d1c1a
material matte
box size=W-0.12,0.04,1.74 pos=0,0.16,-1.58
box size=W-0.20,0.02,0.04 pos=0,0.46,-2.495
# Glass greenhouse: windshield, door glass (with vent-window dividers) and back light
color #121a20
material glass
extrude depth=W-0.10 bevel=0.03 pts=0.53,0.545,0.10,0.965,-0.61,0.965,-0.61,0.545
color #111111
material matte
box size=0.02,0.38,0.025 pos=W/2-0.045,0.75,0.22 rot=-12,0,0 mirror=x
# Black trim: cowl vent, wipers, door and hood shut lines, tailgate stamping
box size=W-0.24,0.02,0.10 pos=0,0.55,0.50
box size=0.012,0.012,0.52 pos=0.32,0.565,0.42 rot=0,8,0 mirror=x
box size=0.006,0.64,0.006 pos=W/2+0.001,0.21,0.52 mirror=x
box size=0.006,0.64,0.006 pos=W/2+0.001,0.21,-0.58 mirror=x
box size=0.006,0.012,1.10 pos=W/2+0.001,-0.10,-0.03 mirror=x
box size=0.006,0.006,1.58 pos=W/2-0.14,0.547,1.38 mirror=x
box size=W-0.36,0.006,0.006 pos=0,0.20,-2.492
# Full-length chrome trim along the body crease (above the arches)
color #c8c8c4
material chrome
box size=0.012,0.025,4.66 pos=W/2+0.004,0.40,-0.14 bevel=0.005 mirror=x
box size=0.012,0.02,1.10 pos=W/2+0.004,0.545,-0.03 mirror=x
# Trimmed black fender flares following the arches
color #161616
material matte
extrude depth=0.09 bevel=0.02 pts=arc(FA,AY,AR+0.08,165,15,14),arc(FA,AY,AR-0.01,15,165,14) pos=W/2+0.035,0,0 mirror=x
extrude depth=0.09 bevel=0.02 pts=arc(RA,AY,AR+0.08,165,15,14),arc(RA,AY,AR-0.01,15,165,14) pos=W/2+0.035,0,0 mirror=x
# Grille: chrome surround, dark recess, egg-crate bars, rectangular headlights, parking lamps
color #c4c4c0
material chrome
box size=1.82,0.38,0.03 pos=0,0.29,2.225 bevel=0.012
color #0c0c0c
material matte
box size=1.08,0.28,0.03 pos=0,0.29,2.235
color #b8b8b4
material chrome
box size=1.06,0.022,0.03 pos=0,0.245,2.245
box size=1.06,0.022,0.03 pos=0,0.335,2.245
box size=0.022,0.27,0.03 pos=0,0.29,2.245
box size=0.022,0.27,0.03 pos=0.18,0.29,2.245 mirror=x
box size=0.022,0.27,0.03 pos=0.36,0.29,2.245 mirror=x
box size=0.30,0.20,0.03 pos=0.71,0.32,2.24 bevel=0.01 mirror=x
color #f0eee0
material lens
box size=0.26,0.16,0.03 pos=0.71,0.32,2.25 bevel=0.012 mirror=x
color #e08a1a
box size=0.26,0.05,0.03 pos=0.71,0.155,2.245 bevel=0.008 mirror=x
box size=0.02,0.05,0.12 pos=W/2+0.002,0.30,2.02 mirror=x
color #a01010
box size=0.07,0.22,0.03 pos=W/2-0.045,0.42,-2.49 bevel=0.01 mirror=x
box size=0.02,0.05,0.10 pos=W/2+0.002,0.30,-2.36 mirror=x
# Chrome bumpers, tailgate latch, mirrors, door handles
color #c9c9c4
material chrome
box size=2.00,0.20,0.16 pos=0,0.0,2.29 bevel=0.03
box size=1.96,0.18,0.18 pos=0,0.0,-2.54 bevel=0.03
box size=0.14,0.03,0.02 pos=0,0.50,-2.495 bevel=0.006
box size=0.05,0.18,0.13 pos=W/2+0.13,0.70,0.40 bevel=0.015 mirror=x
box size=0.02,0.03,0.12 pos=W/2+0.004,0.43,-0.42 bevel=0.008 mirror=x
color #1a1a1a
material matte
box size=0.15,0.02,0.03 pos=W/2+0.065,0.63,0.42 mirror=x
box size=0.02,0.10,0.02 pos=W/2+0.13,0.62,0.40 mirror=x
cyl r=0.004 h=0.9 pos=-0.92,0.98,0.95
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,-0.02,-2.635
# Frame rails, crossmembers, red tow hooks
color #161616
material steel
box size=0.10,0.18,4.70 pos=0.50,-0.20,-0.12 mirror=x
box size=1.00,0.12,0.10 pos=0,-0.20,2.05
box size=1.00,0.12,0.10 pos=0,-0.20,-2.38
box size=0.70,0.05,0.60 pos=0,-0.25,1.55
color #b01010
box size=0.05,0.10,0.10 pos=0.45,-0.12,2.36 bevel=0.01 mirror=x
# Bed roll bar with four off-road lights
color #141414
cyl r=0.035 h=0.781 seg=10 pos=0.84,0.97,-0.95 rot=2.9357,-90,0 mirror=x
cyl r=0.035 h=1.64 seg=10 pos=0,1.36,-0.95 rot=90,-90,0
cyl r=0.03 h=0.8166 seg=10 pos=0.85,0.79,-1.3 rot=120.9534,178.3634,0 mirror=x
cyl r=0.025 h=1.8266 seg=10 pos=-0.015,0.99,-0.95 rot=113.8988,-90,0
box size=1.30,0.05,0.04 pos=0,1.42,-0.95 bevel=0.01
color #c9c9c4
material chrome
cyl r=0.075 h=0.08 axis=z seg=16 pos=0.18,1.50,-0.92 mirror=x
cyl r=0.075 h=0.08 axis=z seg=16 pos=0.52,1.50,-0.92 mirror=x
color #f0f2e6
material lens
cyl r=0.065 h=0.02 axis=z seg=16 pos=0.18,1.50,-0.875 mirror=x
cyl r=0.065 h=0.02 axis=z seg=16 pos=0.52,1.50,-0.875 mirror=x
# Twin chrome stacks rising out of the bed behind the cab
color #cfcfca
material chrome
cyl r=0.05 h=1.32 seg=14 pos=0.62,0.84,-0.80 mirror=x
cyl r=0.055 h=0.06 seg=14 pos=0.62,0.20,-0.80 mirror=x
color #141414
material matte
cyl r=0.045 h=0.01 seg=14 pos=0.62,1.505,-0.80 mirror=x
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.80 bl=0.545 wz=0.52 bz=-0.60 ry=0.92
