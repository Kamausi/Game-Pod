# Late-1970s full-size two-door 4x4 SUV (half-cab with the removable hardtop), lifted:
# square-body sheet metal, round headlights in square chrome bezels, contrasting white
# hardtop with big quarter glass, swing-out spare tyre carrier, roof light bar, rock sliders.
# Body frame: origin at frame height, +Z forward, +X left. Front axle z=1.2105, rear z=-1.4795.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.15
param paint_g = 0.30
param paint_b = 0.52
param top_r = 0.92
param top_g = 0.92
param top_b = 0.92
set W = 1.94
set FA = 1.2105
set RA = -1.4795
set AY = -0.30
set AR = 0.56
# High-fidelity surfacing: smoother curves and rounded edges, then the whole vehicle is shaped
# as one (tumblehome, barrelled sides, tapered nose/tail, plan bow, crowned hood and roof).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.09 ty0=0.56 ty1=1.05 barrel=0.03 by0=-0.12 by1=0.56 bow=0.016 bz0=-2.35 bz1=2.10 taperf=0.06 tf0=1.2 tf1=2.10 taperr=0.03 tr0=-1.8 tr1=-2.35 crown=0.045 cy0=0.44 cy1=0.55 hw=0.97
color paint_r paint_g paint_b
material paint
# Front clip: fenders, hood and grille surround with the arch cut in
extrude depth=W bevel=0.075 pts=0.48,-0.10,arc(FA,AY,AR,159,21,12),2.08,-0.10,2.10,0.04,2.10,0.52,2.07,0.555,0.48,0.56
# Tub: doors, rear quarters and tailgate in one side profile with the rear arch
extrude depth=W bevel=0.075 pts=0.48,-0.12,arc(RA,AY,AR,21,159,12),-2.32,-0.12,-2.32,0.56,0.48,0.56
# Windshield frame (body colour)
box size=0.07,0.60,0.07 pos=W/2-0.06,0.78,0.28 rot=-42.3,0,0 bevel=0.02 mirror=x
box size=W-0.08,0.05,0.06 pos=0,0.985,0.09 bevel=0.015
# Glass greenhouse: windshield, door glass, quarter glass, liftgate glass
color #121a20
material glass
extrude depth=W-0.10 bevel=0.03 pts=0.46,0.56,0.08,0.99,-2.29,0.99,-2.29,0.56
# Removable hardtop in contrasting colour: roof skin, B- and D-pillars, side rails, rear header
color top_r top_g top_b
material paint
extrude depth=W-0.04 bevel=0.04 pts=0.10,0.99,0.06,1.05,-2.25,1.05,-2.32,1.0,-2.32,0.975,0.10,0.975
box size=0.07,0.44,0.13 pos=W/2-0.055,0.78,-0.47 bevel=0.02 mirror=x
box size=0.07,0.44,0.10 pos=W/2-0.055,0.78,-2.26 bevel=0.02 mirror=x
box size=0.06,0.04,1.90 pos=W/2-0.03,0.58,-1.37 bevel=0.01 mirror=x
box size=W-0.06,0.06,0.06 pos=0,0.59,-2.30 bevel=0.015
box size=0.03,0.36,0.04 pos=0,0.78,-2.31
color #111111
material matte
box size=0.08,0.012,1.88 pos=W/2-0.03,0.558,-1.37 mirror=x
# Black trim: cowl vent, wipers, door and tailgate shut lines, hood seams
box size=W-0.24,0.02,0.10 pos=0,0.565,0.45
box size=0.012,0.012,0.52 pos=0.32,0.58,0.37 rot=0,8,0 mirror=x
box size=0.006,0.64,0.006 pos=W/2+0.001,0.21,0.46 mirror=x
box size=0.006,0.64,0.006 pos=W/2+0.001,0.21,-0.80 mirror=x
box size=0.006,0.012,1.24 pos=W/2+0.001,-0.10,-0.17 mirror=x
box size=0.006,0.006,1.50 pos=W/2-0.14,0.561,1.25 mirror=x
box size=W-0.10,0.006,0.006 pos=0,0.02,-2.322
box size=W-0.30,0.006,0.006 pos=0,0.30,-2.322
color #c8c8c4
material chrome
box size=0.012,0.025,4.36 pos=W/2+0.004,0.40,-0.11 bevel=0.005 mirror=x
box size=0.12,0.03,0.02 pos=0,0.45,-2.33 bevel=0.006
# Trimmed black fender flares
color #161616
material matte
extrude depth=0.09 bevel=0.02 pts=arc(FA,AY,AR+0.08,165,15,14),arc(FA,AY,AR-0.01,15,165,14) pos=W/2+0.035,0,0 mirror=x
extrude depth=0.09 bevel=0.02 pts=arc(RA,AY,AR+0.08,165,15,14),arc(RA,AY,AR-0.01,15,165,14) pos=W/2+0.035,0,0 mirror=x
# Grille: chrome surround, egg-crate, round headlights in square bezels, parking lamps
color #c4c4c0
material chrome
box size=1.82,0.38,0.03 pos=0,0.29,2.105 bevel=0.012
color #0c0c0c
material matte
box size=1.12,0.28,0.03 pos=0,0.29,2.115
color #b8b8b4
material chrome
box size=1.10,0.022,0.03 pos=0,0.29,2.125
box size=0.022,0.27,0.03 pos=0.14,0.29,2.125 mirror=x
box size=0.022,0.27,0.03 pos=0.28,0.29,2.125 mirror=x
box size=0.022,0.27,0.03 pos=0.42,0.29,2.125 mirror=x
box size=0.022,0.27,0.03 pos=0,0.29,2.125
box size=0.25,0.25,0.03 pos=0.72,0.30,2.12 bevel=0.012 mirror=x
color #f0eee0
material lens
use vehicles/headlamp.mbcad round=1 r=0.09 pos=0.72,0.30,2.145 mirror=x
color #e08a1a
box size=0.30,0.05,0.03 pos=0.40,0.13,2.12 bevel=0.008 mirror=x
box size=0.02,0.05,0.12 pos=W/2+0.002,0.30,1.92 mirror=x
color #a01010
use vehicles/taillamp.mbcad w=0.08 h=0.32 pos=W/2-0.045,0.30,-2.35 rot=0,180,0 mirror=x
box size=0.02,0.05,0.10 pos=W/2+0.002,0.30,-2.20 mirror=x
# Chrome bumpers, mirrors, door handles, fuel door
color #c9c9c4
material chrome
box size=2.00,0.20,0.16 pos=0,0.0,2.17 bevel=0.03
box size=1.96,0.18,0.14 pos=0,0.0,-2.39 bevel=0.03
box size=0.05,0.18,0.13 pos=W/2+0.13,0.72,0.36 bevel=0.015 mirror=x
box size=0.02,0.03,0.12 pos=W/2+0.004,0.43,-0.65 bevel=0.008 mirror=x
cyl r=0.06 h=0.01 axis=x seg=14 pos=-(W/2+0.002),0.30,-1.95
color #1a1a1a
material matte
box size=0.15,0.02,0.03 pos=W/2+0.065,0.65,0.38 mirror=x
box size=0.02,0.10,0.02 pos=W/2+0.13,0.64,0.36 mirror=x
cyl r=0.004 h=0.9 pos=-0.92,0.98,0.85
# Frame rails, crossmembers, rock sliders, red tow hooks
color #161616
material steel
box size=0.10,0.18,4.40 pos=0.50,-0.20,-0.10 mirror=x
box size=1.00,0.12,0.10 pos=0,-0.20,1.95
box size=1.00,0.12,0.10 pos=0,-0.20,-2.25
box size=0.70,0.05,0.60 pos=0,-0.25,1.45
box size=0.08,0.08,1.40 pos=W/2-0.03,-0.16,-0.17 bevel=0.03 mirror=x
color #b01010
box size=0.05,0.10,0.10 pos=0.45,-0.12,2.26 bevel=0.01 mirror=x
# Swing-out spare tyre carrier on the rear bumper
color #151515
material steel
box size=0.07,0.80,0.07 pos=0.88,0.36,-2.50 bevel=0.015
box size=0.90,0.07,0.07 pos=0.45,0.70,-2.50 bevel=0.015
box size=0.90,0.07,0.07 pos=0.45,0.06,-2.50 bevel=0.015
box size=0.12,0.12,0.06 pos=0.45,0.40,-2.50
color #1b1a19
tire r=0.42 w=0.26 rim=0.19 lugs=16 depth=0.025 tread=mt pos=0.45,0.40,-2.63 rot=0,90,0
color #2a2a2a
material steel
rim r=0.19 w=0.22 spokes=6 pos=0.45,0.40,-2.63 rot=0,90,0
# Roof light bar on the hardtop
color #121212
material steel
box size=1.36,0.10,0.10 pos=0,1.13,-0.02 bevel=0.02
box size=0.04,0.08,0.04 pos=0.58,1.08,-0.02 mirror=x
color #e6eef2
material lens
box size=1.28,0.06,0.02 pos=0,1.13,0.035
# ---- Trail-rig build-out ----
# Roof rack basket on the hardtop behind the light bar: frame, slats, gear
color #151515
material steel
for s = -1, 1, 2
  box size=0.04,0.10,1.60 pos=s*(W/2-0.12),1.15,-1.20
  for k = 0, 3
    box size=0.04,0.12,0.04 pos=s*(W/2-0.12),1.10,-0.45-k*0.50
  end
end
box size=W-0.20,0.10,0.04 pos=0,1.15,-0.40
box size=W-0.20,0.10,0.04 pos=0,1.15,-2.00
for k = 0, 6
  box size=W-0.22,0.02,0.05 pos=0,1.11,-0.50-k*0.24
end
# Two jerry cans, a hi-lift jack, a shovel and a recovery bag in the basket
for k = 0, 1
  color #c41a1a
  material paint
  box size=0.17,0.32,0.46 pos=-0.55+k*0.20,1.28,-1.70 bevel=0.03
  color #1a1a1a
  box size=0.07,0.04,0.05 pos=-0.55+k*0.20,1.45,-1.55
end
color #c41a1a
material paint
box size=0.05,0.06,1.25 pos=0.20,1.16,-1.20
color #1a1a1a
material steel
box size=0.10,0.10,0.18 pos=0.20,1.20,-0.95
color #6e5434
material matte
cyl r=0.02 h=0.80 axis=z pos=0.55,1.15,-1.05 seg=6
color #2a2a2a
material steel
box size=0.20,0.02,0.24 pos=0.55,1.15,-1.55
color #f06010
material matte
box size=0.36,0.18,0.30 pos=0.55,1.22,-1.85 bevel=0.05
# A-pillar ditch lights
color #151515
material steel
box size=0.10,0.10,0.10 pos=W/2+0.03,0.60,0.44 bevel=0.02 mirror=x
color #fff4d0
material lens
box size=0.08,0.08,0.012 pos=W/2+0.03,0.60,0.495 mirror=x
# Mud flaps behind all four wheels
color #121212
material rubber
box size=0.38,0.30,0.012 pos=W/2-0.14,-0.27,FA-AR-0.16 mirror=x
box size=0.38,0.30,0.012 pos=W/2-0.14,-0.27,RA-AR-0.18 mirror=x
# Door lettering
color #c41a1a
material paint
text str=TRAIL_RIG size=0.07 t=0.022 depth=0.006 pos=W/2+0.005,0.28,-0.02 rot=0,90,0
text str=TRAIL_RIG size=0.07 t=0.022 depth=0.006 pos=-W/2-0.005,0.28,-0.02 rot=0,-90,0
color #1a1a1a
text str=MUD_BUDDIES size=0.055 t=0.018 depth=0.006 pos=W/2+0.005,0.15,-0.02 rot=0,90,0
text str=MUD_BUDDIES size=0.055 t=0.018 depth=0.006 pos=-W/2-0.005,0.15,-0.02 rot=0,-90,0
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.80 bl=0.56 wz=0.45 bz=-0.75 ry=0.95 driver=driver
# Bolt-on kit: recovery points always, winch and snorkel when fitted in the garage
use vehicles/kit.mbcad fz=2.25 by=0.00 bw=2.00 rz=-2.46 ry=0.00 sx=1.03 sy0=0.35 sz0=0.85 sy1=1.03 sz1=0.08 winch=winch snorkel=snorkel
# Windscreen wipers parked along the base of the glass, with arms and pivot caps
color #111111
material matte
box size=0.582,0.012,0.024 pos=0.245,0.620,0.441 rot=48.53,0,0
box size=0.495,0.010,0.012 pos=0.265,0.629,0.452 rot=48.53,0,0
cyl r=0.022 h=0.03 pos=0.489,0.588,0.475 rot=48.53,0,0 seg=8
box size=0.582,0.012,0.024 pos=-0.265,0.620,0.441 rot=48.53,0,0
box size=0.495,0.010,0.012 pos=-0.245,0.629,0.452 rot=48.53,0,0
cyl r=0.022 h=0.03 pos=-0.021,0.588,0.475 rot=48.53,0,0 seg=8
# Rear number plate with frame and plate lamp
material plastic
color #111111
box size=0.34,0.19,0.012 pos=-0.45,0.2,-2.335
material matte
color #f2f2ee
box size=0.30,0.15,0.01 pos=-0.45,0.2,-2.3409999999999997
color #1a2a4a
text str=TRAIL-1 size=0.045 t=0.012 depth=0.004 pos=-0.45,0.195,-2.347 rot=0,180,0
color #b01313
text str=MUD_STATE size=0.014 t=0.004 depth=0.003 pos=-0.45,0.255,-2.347 rot=0,180,0
material lens
color #fff6dc
box size=0.08,0.02,0.02 pos=-0.45,0.305,-2.3449999999999998
# Bolt heads along the fender flares
color #2a2a2a
material steel
for k = 0, 7
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.086,AY+(AR+0.035)*sin(160-k*20),FA+(AR+0.035)*cos(160-k*20) mirror=x
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.086,AY+(AR+0.035)*sin(160-k*20),RA+(AR+0.035)*cos(160-k*20) mirror=x
end
