# GMT800 crew-cab mud truck (photo 3, far right): caked in tan mud, roof light bar,
# hood propped open (radiator packed with mud -> overheating). Front axle z=1.56, rear z=-2.34.
param lod = 0             # 1 = far version: unshaped, coarser curves
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.62
param paint_g = 0.55
param paint_b = 0.42
param hood_open = 0
set W = 1.98
set FA = 1.56
set RA = -2.34
set AY = -0.32
set AR = 0.60
# High-fidelity surfacing: smoother curves and rounded edges, then the whole vehicle is shaped
# as one (tumblehome, barrelled sides, tapered nose/tail, plan bow, crowned hood and roof).
set _segmul = 1.35-0.35*lod
set _bevelmul = 1.5-0.5*lod
deform on=1-lod res=0.09 tumble=0.11 ty0=0.60 ty1=1.12 crown=0.03 cy0=0.95 cy1=1.08 hw=0.99
color paint_r paint_g paint_b
material paint
# Front clip (fenders + grille surround) with the arch cut in; the hood is separate so it can open
# >>> body shell (generated by tools/gen_truck_bodies.py)
# Lofted lower body: rocker roll-under, barrelled door, character crease, rounded shoulder,
# crowned hood; wheel openings clipped exactly and backed by wheelhouse liners.
color paint_r paint_g paint_b
material paint
loft sec=-1.12:0.0000,-0.1000,0.8800,-0.1000,0.9380,-0.0400,0.9500,0.1176,0.9540,0.4100,0.9440,0.4500,0.9280,0.5300,0.8800,0.5720,0.4750,0.5800,0.0000,0.5800|-1.1:0.0000,-0.1250,0.9050,-0.1250,0.9630,-0.0650,0.9750,0.1054,0.9790,0.4250,0.9690,0.4650,0.9530,0.5450,0.9050,0.5870,0.4875,0.5950,0.0000,0.5950|-1.04:0.0000,-0.1300,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1036,0.9940,0.4300,0.9840,0.4700,0.9680,0.5500,0.9200,0.5920,0.4950,0.6000,0.0000,0.6000|1.25:0.0000,-0.1300,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1036,0.9940,0.4300,0.9840,0.4700,0.9680,0.5500,0.9200,0.5920,0.4950,0.6000,0.0000,0.6000|1.33:0.0000,-0.1300,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.0892,0.9940,0.3850,0.9840,0.4250,0.9680,0.5050,0.9200,0.5470,0.4950,0.5550,0.0000,0.5550|2.0:0.0000,-0.1300,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.0876,0.9940,0.3800,0.9840,0.4200,0.9680,0.5000,0.9200,0.5420,0.4950,0.5500,0.0000,0.5500|2.8:0.0000,-0.1300,0.9150,-0.1300,0.9730,-0.0700,0.9850,0.0828,0.9890,0.3650,0.9790,0.4050,0.9630,0.4850,0.9150,0.5270,0.4925,0.5350,0.0000,0.5350|2.9:0.0000,-0.1000,0.9050,-0.1000,0.9630,-0.0400,0.9750,0.0984,0.9790,0.3500,0.9690,0.3900,0.9530,0.4700,0.9050,0.5120,0.4875,0.5200,0.0000,0.5200|2.95:0.0000,0.0500,0.8700,0.0500,0.9280,0.1100,0.9400,0.1812,0.9440,0.2900,0.9340,0.3300,0.9180,0.4100,0.8700,0.4520,0.4700,0.4600,0.0000,0.4600 n=3 m=2
cut cyl=1.56,-0.32,0.6 xmin=0.730
# Lofted bed sides with a rolled rail and inner wall
loft full=1 sec=-1.140:0.9200,-0.1200,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1490,0.9940,0.6300,0.9840,0.6700,0.9700,0.7600,0.9400,0.8000,0.8700,0.8000,0.8700,0.7500,0.9200,0.7300|-1.180:0.9200,-0.1200,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1490,0.9940,0.6300,0.9840,0.6700,0.9700,0.7600,0.9400,0.8000,0.8700,0.8000,0.8700,0.7500,0.9200,0.7300|-3.080:0.9200,-0.1200,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1490,0.9940,0.6300,0.9840,0.6700,0.9700,0.7600,0.9400,0.8000,0.8700,0.8000,0.8700,0.7500,0.9200,0.7300|-3.120:0.9200,-0.1200,0.9200,-0.1300,0.9780,-0.0700,0.9900,0.1490,0.9940,0.6300,0.9840,0.6700,0.9700,0.7600,0.9400,0.8000,0.8700,0.8000,0.8700,0.7500,0.9200,0.7300 n=2 m=2 mirror=x
