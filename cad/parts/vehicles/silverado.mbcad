# GMT800 crew-cab mud truck (photo 3, far right): caked in tan mud, roof light bar,
# hood propped open (radiator packed with mud -> overheating). Front axle z=1.56, rear z=-2.34.
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.62
param paint_g = 0.55
param paint_b = 0.42
param hood_open = 0
set W = 1.98
set FA = 1.56
set RA = -2.34
set AY = -0.32
set AR = 0.60
color paint_r paint_g paint_b
material paint
# Front clip (fenders + grille surround) with the arch cut in; the hood is separate so it can open
extrude depth=W bevel=0.05 pts=1.28,-0.13,arc(FA,AY,AR,161.5,18.5,12),2.92,-0.13,2.95,0.05,2.95,0.46,2.90,0.53,1.30,0.555
box size=W-0.06,0.08,1.58 pos=0,0.585+hood_open*0.55,2.10-hood_open*0.35 rot=-hood_open*55,0,0 bevel=0.03
# Crew-cab doors, roof skin and pillars
extrude depth=W bevel=0.05 pts=1.30,-0.13,1.30,0.60,-1.12,0.60,-1.12,-0.13
extrude depth=W-0.08 bevel=0.03 pts=0.70,1.05,0.64,1.115,-1.03,1.125,-1.10,1.07,-1.10,1.04
box size=0.08,0.77,0.08 pos=W/2-0.07,0.83,0.96 rot=-51.3,0,0 bevel=0.02 mirror=x
box size=0.08,0.50,0.12 pos=W/2-0.07,0.84,0.05 bevel=0.02 mirror=x
box size=0.08,0.50,0.10 pos=W/2-0.07,0.84,-1.06 bevel=0.02 mirror=x
# Bed: sides with the rear arch, rail caps, front wall, tailgate, wheel tubs
extrude depth=0.07 bevel=0.02 pts=-1.14,0.80,-3.12,0.80,-3.12,-0.13,arc(RA,AY,AR,161.5,18.5,12),-1.14,-0.13 pos=W/2-0.035,0,0 mirror=x
box size=0.11,0.035,1.98 pos=W/2-0.055,0.815,-2.13 bevel=0.014 mirror=x
box size=W-0.14,0.80,0.06 pos=0,0.40,-1.16
box size=W-0.10,0.78,0.06 pos=0,0.40,-3.10 bevel=0.02
box size=0.26,0.36,1.10 pos=W/2-0.20,0.20,RA bevel=0.06 mirror=x
color #1d1c1a
material matte
box size=W-0.14,0.04,1.92 pos=0,0.12,-2.13
# Engine bay (seen with the hood up) and the mud-packed radiator
color #232323
box size=W-0.14,0.04,1.50 pos=0,0.20,2.08
color #3b3d3f
material steel
box size=0.80,0.30,0.80 pos=0,0.36,1.90 bevel=0.04
color #5a4a36
material mud
box size=1.40,0.40,0.06 pos=0,0.28,2.78
# Tinted glass greenhouse
color #121a20
material glass
extrude depth=W-0.12 bevel=0.03 pts=1.26,0.59,0.66,1.07,-1.02,1.09,-1.10,0.60
# Trim and door seams
color #111111
material matte
box size=W+0.004,0.022,2.40 pos=0,0.60,0.09
box size=0.006,0.70,0.006 pos=W/2+0.001,0.24,1.28 mirror=x
box size=0.006,0.70,0.006 pos=W/2+0.001,0.24,0.06 mirror=x
box size=0.006,0.70,0.006 pos=W/2+0.001,0.24,-1.10 mirror=x
box size=0.02,0.03,0.14 pos=W/2+0.006,0.46,0.85 bevel=0.008 mirror=x
box size=0.02,0.03,0.14 pos=W/2+0.006,0.46,-0.35 bevel=0.008 mirror=x
box size=0.07,0.24,0.18 pos=W/2+0.12,0.80,1.12 bevel=0.03 mirror=x
# Fender flares
color #151515
extrude depth=0.11 bevel=0.02 pts=arc(FA,AY,AR+0.10,166,14,14),arc(FA,AY,AR-0.015,14,166,14) pos=W/2+0.04,0,0 mirror=x
extrude depth=0.11 bevel=0.02 pts=arc(RA,AY,AR+0.10,166,14,14),arc(RA,AY,AR-0.015,14,166,14) pos=W/2+0.04,0,0 mirror=x
# Chrome grille with body-colour crossbar, headlights, tail lights
color #c4c4c0
material chrome
box size=1.24,0.36,0.04 pos=0,0.30,2.955 bevel=0.012
color #0b0b0b
material matte
box size=1.14,0.29,0.03 pos=0,0.30,2.965
color paint_r paint_g paint_b
material paint
box size=1.24,0.08,0.05 pos=0,0.30,2.97 bevel=0.012
color #c9a227
material chrome
box size=0.16,0.06,0.02 pos=0,0.30,2.996
color #eef2f4
material lens
use vehicles/headlamp.mbcad w=0.30 h=0.20 n=2 pos=0.80,0.33,2.96 mirror=x
color #e08a1a
box size=0.08,0.10,0.04 pos=0.96,0.33,2.92 bevel=0.01 mirror=x
color #b01313
use vehicles/taillamp.mbcad w=0.08 h=0.36 rev=0.30 pos=W/2-0.05,0.55,-3.15 rot=0,180,0 mirror=x
# LED light bar on roof mounts
color #121212
material steel
box size=1.30,0.10,0.10 pos=0,1.19,0.70 bevel=0.02
box size=0.04,0.10,0.04 pos=0.55,1.14,0.70 mirror=x
color #e6eef2
material lens
box size=1.22,0.06,0.02 pos=0,1.19,0.755
# Steel bumpers, rock sliders, frame rails
color #161616
material steel
box size=2.02,0.24,0.18 pos=0,0.0,2.99 bevel=0.02
box size=1.96,0.22,0.16 pos=0,0.0,-3.16 bevel=0.02
box size=0.08,0.08,2.30 pos=W/2+0.01,-0.18,0.10 bevel=0.03 mirror=x
box size=0.12,0.16,5.0 pos=0.55,-0.21,-0.30 mirror=x
# ---- Diesel mud-truck build-out ----
# Twin 5" chrome stacks out of the bed front corners with slash-cut tips
color #cfcfca
material chrome
for s = -1, 1, 2
  cyl r=0.065 h=1.30 pos=s*(W/2-0.22),1.15,-1.30 seg=14
  cyl r=0.07 h=0.12 pos=s*(W/2-0.22),1.86,-1.30 rot=30,0,0 seg=14
  color #111111
  material matte
  cyl r=0.06 h=0.01 pos=s*(W/2-0.22),1.92,-1.27 rot=30,0,0 seg=14
  color #cfcfca
  material chrome
end
# Bed rack over the bed: four posts, side rails and crossbars, loaded with a spare, cans and boards
color #151515
material steel
for s = -1, 1, 2
  box size=0.05,0.62,0.05 pos=s*(W/2-0.08),1.10,-1.50
  box size=0.05,0.62,0.05 pos=s*(W/2-0.08),1.10,-2.95
  box size=0.05,0.05,1.50 pos=s*(W/2-0.08),1.42,-2.22
end
for k = 0, 3
  box size=W-0.12,0.04,0.05 pos=0,1.42,-1.55-k*0.45
end
color #121212
material rubber
tire r=0.42 w=0.28 rim=0.20 lugs=16 depth=0.026 tread=mt pos=0.25,1.58,-2.25 rot=0,0,90
color #222222
material steel
cyl r=0.20 h=0.25 pos=0.25,1.58,-2.25 seg=12
color #d07a12
material plastic
cyl r=0.012 h=0.90 axis=z pos=0.25,1.73,-2.25 seg=5
for k = 0, 1
  color #3a6a2a
  material paint
  box size=0.17,0.46,0.32 pos=-0.55,1.68,-1.75-k*0.38 bevel=0.03
  color #1a1a1a
  box size=0.07,0.05,0.04 pos=-0.55,1.93,-1.67-k*0.38
end
color #f06010
material plastic
for k = 0, 1
  box size=0.30,0.025,1.05 pos=-0.30-k*0.04,1.465+k*0.03,-2.65 bevel=0.01
end
# Amber cab clearance lights
color #e8a020
material lens
for k = -2, 2
  box size=0.07,0.035,0.05 pos=k*0.22,1.13,0.62
end
# Mud flaps behind all four wheels
color #121212
material rubber
box size=0.40,0.32,0.012 pos=W/2-0.15,-0.29,FA-AR-0.18 mirror=x
box size=0.40,0.32,0.012 pos=W/2-0.15,-0.29,RA-AR-0.20 mirror=x
# Rear-door lettering and race number, tailgate lettering
color #c41a1a
material paint
text str=22 size=0.18 t=0.055 depth=0.006 pos=W/2+0.005,0.30,-0.55 rot=0,90,0
text str=22 size=0.18 t=0.055 depth=0.006 pos=-W/2-0.005,0.30,-0.55 rot=0,-90,0
color #f2f2ee
text str=MUD_BUDDIES size=0.07 t=0.022 depth=0.006 pos=W/2+0.005,0.08,0.38 rot=0,90,0
text str=MUD_BUDDIES size=0.07 t=0.022 depth=0.006 pos=-W/2-0.005,0.08,0.38 rot=0,-90,0
text str=MUD_TRUCK size=0.09 t=0.028 depth=0.006 pos=0,0.48,-3.165 rot=0,180,0
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.84 bl=0.60 wz=1.20 bz=-1.08 ry=1.03 driver=driver
# Bolt-on kit: recovery points always, winch and snorkel when fitted in the garage
use vehicles/kit.mbcad fz=3.08 by=0.00 bw=2.02 rz=-3.24 ry=0.00 sx=1.05 sy0=0.45 sz0=1.60 sy1=1.12 sz1=0.66 winch=winch snorkel=snorkel
# Windscreen wipers parked along the base of the glass, with arms and pivot caps
color #111111
material matte
box size=0.594,0.012,0.024 pos=0.250,0.658,1.216 rot=38.66,0,0
box size=0.505,0.010,0.012 pos=0.270,0.669,1.225 rot=38.66,0,0
cyl r=0.022 h=0.03 pos=0.500,0.623,1.267 rot=38.66,0,0 seg=8
box size=0.594,0.012,0.024 pos=-0.271,0.658,1.216 rot=38.66,0,0
box size=0.505,0.010,0.012 pos=-0.251,0.669,1.225 rot=38.66,0,0
cyl r=0.022 h=0.03 pos=-0.021,0.623,1.267 rot=38.66,0,0 seg=8
# Rear number plate with frame and plate lamp
material plastic
color #111111
box size=0.34,0.19,0.012 pos=0,0.2,-3.135
material matte
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.2,-3.1409999999999996
color #1a2a4a
text str=MUD-22 size=0.045 t=0.012 depth=0.004 pos=0,0.195,-3.147 rot=0,180,0
color #b01313
text str=MUD_STATE size=0.014 t=0.004 depth=0.003 pos=0,0.255,-3.147 rot=0,180,0
material lens
color #fff6dc
box size=0.08,0.02,0.02 pos=0,0.305,-3.1449999999999996
material plastic
color #121212
box size=0.22,0.06,0.02 pos=0,0.68,-3.1369999999999996
material chrome
color #c8c8c4
box size=0.16,0.025,0.012 pos=0,0.68,-3.147
# Bolt heads along the fender flares
color #2a2a2a
material steel
for k = 0, 7
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.101,AY+(AR+0.043)*sin(160-k*20),FA+(AR+0.043)*cos(160-k*20) mirror=x
  cyl r=0.011 h=0.016 axis=x seg=6 pos=W/2+0.101,AY+(AR+0.043)*sin(160-k*20),RA+(AR+0.043)*cos(160-k*20) mirror=x
end
