# 1976 full-size sedan "bog car" (photo 3: white, '1976' lettered on the glass).
# Long hood, formal roofline with opera windows, chrome bumpers. Front axle z=1.36, rear z=-1.73.
param driver = 1          # 0 for parked rigs: empty cab
param winch = 0           # garage options: winch bumper / snorkel
param snorkel = 0
param paint_r = 0.88
param paint_g = 0.88
param paint_b = 0.86
set W = 1.98
set FA = 1.36
set RA = -1.73
set AY = -0.26
set AR = 0.52
color paint_r paint_g paint_b
material paint
# Whole lower body in one side profile: both arches, long hood, cowl, rear deck
extrude depth=W bevel=0.07 pts=-2.80,-0.10,arc(RA,AY,AR,162,18,12),arc(FA,AY,AR,162,18,12),2.78,-0.10,2.82,0.06,2.82,0.30,2.76,0.38,1.00,0.445,0.70,0.46,-1.66,0.46,-1.95,0.45,-2.70,0.42,-2.82,0.36,-2.84,0.10
# Roof skin, A-pillars and the formal C-pillars with opera windows
extrude depth=W-0.12 bevel=0.04 pts=0.12,0.94,0.06,1.005,-1.06,1.015,-1.16,0.97,-1.16,0.94
box size=0.07,0.77,0.07 pos=W/2-0.09,0.71,0.37 rot=-49.2,0,0 bevel=0.02 mirror=x
box size=0.06,0.48,0.08 pos=W/2-0.09,0.72,-0.48 bevel=0.02 mirror=x
extrude depth=0.06 bevel=0.02 pts=-0.95,0.97,-1.10,0.985,-1.66,0.47,-1.20,0.47 pos=W/2-0.10,0,0 mirror=x
# Greenhouse
color #0e1418
material glass
extrude depth=W-0.20 bevel=0.03 pts=0.66,0.46,0.08,0.96,-1.06,0.98,-1.66,0.46
# '1976' lettered on the side glass, both sides (the photo's shoe-polish numbers)
color #f2f2f2
material matte
text str=1976 size=0.10 t=0.025 depth=0.01 pos=W/2-0.085,0.74,-0.30 rot=0,90,0
text str=1976 size=0.10 t=0.025 depth=0.01 pos=-W/2+0.085,0.74,-0.30 rot=0,-90,0
# Big bold door numbers
color #e8b020
text str=76 size=0.17 t=0.055 depth=0.01 pos=W/2+0.008,0.33,0.10 rot=0,90,0
text str=76 size=0.17 t=0.055 depth=0.01 pos=-W/2-0.008,0.33,0.10 rot=0,-90,0
# Door seams, trunk and hood shut lines
color #141414
box size=0.006,0.52,0.006 pos=W/2+0.002,0.17,0.66 mirror=x
box size=0.006,0.52,0.006 pos=W/2+0.002,0.17,-0.50 mirror=x
box size=0.006,0.52,0.006 pos=W/2+0.002,0.17,-1.62 mirror=x
box size=W-0.20,0.006,0.006 pos=0,0.465,-1.98
# Chrome: beltline spear, bumpers, grille surround, wheel-arch lips, hood ornament
color #c6c8ca
material chrome
box size=0.015,0.025,4.60 pos=W/2+0.04,0.30,0.0 bevel=0.008 mirror=x
box size=W+0.06,0.18,0.18 pos=0,0.02,2.86 bevel=0.04
box size=W+0.06,0.18,0.18 pos=0,0.02,-2.87 bevel=0.04
box size=1.46,0.22,0.04 pos=0,0.22,2.815 bevel=0.01
extrude depth=0.03 pts=arc(FA,AY,AR+0.03,162,18,14),arc(FA,AY,AR,18,162,14) pos=W/2+0.015,0,0 mirror=x
extrude depth=0.03 pts=arc(RA,AY,AR+0.03,162,18,14),arc(RA,AY,AR,18,162,14) pos=W/2+0.015,0,0 mirror=x
box size=0.02,0.06,0.08 pos=0,0.475,2.70 bevel=0.008
color #1b1d1f
material matte
box size=1.36,0.16,0.03 pos=0,0.22,2.825
color #f0eedc
material lens
cyl r=0.075 h=0.04 axis=z seg=18 pos=0.62,0.22,2.83 mirror=x
cyl r=0.075 h=0.04 axis=z seg=18 pos=0.84,0.22,2.83 mirror=x
color #a01212
box size=0.50,0.13,0.04 pos=0.66,0.24,-2.84 bevel=0.012 mirror=x
color #111111
material steel
box size=0.12,0.12,4.6 pos=0.52,-0.16,-0.20 mirror=x
# ---- Bog mods ----
# Dark vinyl landau roof over the rear half
color #2a2622
material matte
box size=W-0.10,0.014,0.80 pos=0,1.02,-0.70
# Chrome air cleaner punched through the hood, and zoomie headers out of the front fenders
color #c6c8ca
material chrome
cyl r=0.22 h=0.10 pos=0,0.50,1.55 seg=18
cyl r=0.05 h=0.06 pos=0,0.58,1.55 seg=10
for k = 0, 3
  cyl r=0.035 h=0.42 pos=W/2+0.02,0.32,0.78-k*0.11 rot=-20,0,-60 mirror=x seg=8
end
# Tube push bar on the front bumper
color #151515
material steel
cyl r=0.04 h=1.40 axis=x pos=0,0.36,3.02 seg=10
cyl r=0.04 h=0.40 pos=0.66,0.20,3.0 mirror=x seg=10
# Mirrors and door handles
color #c6c8ca
material chrome
box size=0.12,0.08,0.10 pos=W/2+0.06,0.56,0.50 bevel=0.02 mirror=x
box size=0.02,0.025,0.12 pos=W/2+0.012,0.34,0.30 mirror=x
# Roof bar with four round driving lights
color #151515
material steel
cyl r=0.025 h=1.40 axis=x pos=0,1.06,0.02 seg=8
for k = 0, 3
  color #151515
  material steel
  cyl r=0.075 h=0.08 axis=z pos=-0.51+k*0.34,1.12,0.03 seg=12
  color #f4f0dc
  material lens
  cyl r=0.06 h=0.01 axis=z pos=-0.51+k*0.34,1.12,0.075 seg=12
end
# Rear plate and dual exhaust tips
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.30,-2.85
color #9a9a9a
material steel
cyl r=0.04 h=0.14 axis=z pos=0.55,-0.10,-2.90 mirror=x seg=10
# ---- Show-bogger build-out ----
# Hand-painted flame job: tongues licking back over the hood (laid on the 2 deg hood slope)
# and down both front fenders, red-orange outer with yellow cores (matte so the clear-coat
# sheen doesn't wash them out at low angles)
material matte
color 0.92 0.30 0.06
extrude depth=0.006 pts=2.7,0.86,2.305,0.788,1.75,0.682,2.015,0.588,2.28,0.573,2.13,0.502,1.4,0.396,1.84,0.301,2.28,0.287,2.27,0.215,1.68,0.109,1.98,0.014,2.28,-0.0,2.105,-0.072,1.35,-0.178,1.815,-0.272,2.28,-0.287,2.24,-0.358,1.62,-0.464,1.95,-0.559,2.28,-0.573,2.34,-0.645,1.82,-0.751,2.7,-0.86 pos=0,0.494,0 rot=0,-2.1,90
color 0.98 0.80 0.12
extrude depth=0.006 pts=2.7,0.74,2.455,0.678,2.05,0.587,2.25,0.506,2.45,0.493,2.32,0.432,1.78,0.34,2.115,0.259,2.45,0.247,2.43,0.185,2.0,0.094,2.225,0.012,2.45,-0.0,2.29,-0.062,1.72,-0.153,2.085,-0.234,2.45,-0.247,2.405,-0.308,1.95,-0.4,2.2,-0.481,2.45,-0.493,2.48,-0.555,2.1,-0.646,2.7,-0.74 pos=0,0.501,0 rot=0,-2.1,90
color 0.92 0.30 0.06
extrude depth=0.006 pos=W/2+0.004,0,0 mirror=x pts=2.78,0.42,1.25,0.435,1.85,0.405,0.60,0.375,1.60,0.345,0.95,0.31,1.95,0.30,2.05,0.20,2.30,0.06,2.78,0.04
color 0.98 0.80 0.12
extrude depth=0.006 pos=W/2+0.009,0,0 mirror=x pts=2.78,0.395,1.60,0.405,2.00,0.385,1.00,0.365,1.85,0.345,1.30,0.325,2.05,0.32,2.15,0.22,2.38,0.09,2.78,0.08
# Hood pins with lanyards
material chrome
color #d0d2d4
for s = -1, 1, 2
  cyl r=0.022 h=0.03 pos=s*0.70,0.395,2.55 seg=8
  cyl r=0.022 h=0.03 pos=s*0.70,0.445,1.10 seg=8
  color #b01010
  box size=0.006,0.006,0.10 pos=s*0.70+0.03,0.40,2.50
  color #d0d2d4
end
# Big roof number and a windshield sponsor banner
material paint
color #111111
text str=76 size=0.38 t=0.10 depth=0.006 pos=0,1.024,-0.55 rot=-90,0,0
color #1d4f9c
box size=W-0.32,0.13,0.008 pos=0,0.888,0.188 rot=-49.2,0,0
color #f2f2ee
text str=MUD_BUDDIES size=0.075 t=0.02 depth=0.004 pos=0,0.892,0.193 rot=-49.2,0,0
# Trunk-deck wing on swan-neck uprights
material steel
color #151515
box size=0.04,0.30,0.12 pos=0.62,0.58,-2.58 rot=-8,0,0 mirror=x
color paint_r paint_g paint_b
material paint
box size=W-0.10,0.03,0.34 pos=0,0.74,-2.62 rot=6,0,0 bevel=0.01
color #b01010
box size=0.03,0.18,0.42 pos=W/2-0.06,0.70,-2.62 mirror=x
# Trunk lettering
color #111111
text str=MUD_BUDDIES size=0.07 t=0.02 depth=0.006 pos=0,0.36,-2.86 rot=0,180,0
# Whip antenna with an orange flag on the rear bumper
material steel
color #2a2a2a
cyl r=0.006 h=1.80 pos=-0.85,1.00,-2.92 seg=4
material matte
color #f06010
extrude depth=0.004 pts=0,0,-0.32,-0.08,0,-0.20 pos=-0.85,1.90,-2.92 rot=0,90,0
# Rubber mud flaps behind all four wheels
color #121212
material rubber
box size=0.36,0.30,0.012 pos=W/2-0.18,-0.32,FA-AR-0.10 mirror=x
box size=0.36,0.30,0.012 pos=W/2-0.18,-0.32,RA-AR-0.12 mirror=x
# Cab interior and driver (seen through the glass)
use vehicles/interior.mbcad W=1.74 bl=0.46 wz=0.62 bz=-1.10 ry=0.93 driver=driver
# Bolt-on kit: recovery points always, winch and snorkel when fitted in the garage
use vehicles/kit.mbcad fz=3.06 by=0.02 bw=2.04 rz=-2.96 ry=0.02 sx=1.06 sy0=0.32 sz0=1.20 sy1=1.00 sz1=0.08 winch=winch snorkel=snorkel
