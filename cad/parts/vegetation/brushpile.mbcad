# Pile of bleached logs and brush pushed up on the spoil mound behind the bus (photos 1-2):
# criss-crossed grey trunks with pale cut ends and branch stubs, an upturned root wad,
# a tangle of thin brush on top, dead leaves and dirt at the base. Origin at ground centre.
material matte
# ---- Logs: three layers crossing at angles ----
for i = 0, 4
  color 0.50+0.05*sin(i*53) 0.47+0.05*sin(i*53) 0.41+0.04*sin(i*37)
  cyl r=0.13+0.03*abs(sin(i*71)) h=2.6+0.6*abs(sin(i*29)) axis=x pos=0.2*sin(i*83),0.14,-0.9+i*0.42 rot=0,8*sin(i*47),2*sin(i*19) seg=7
end
for i = 0, 3
  color 0.45+0.05*sin(i*61) 0.42+0.05*sin(i*61) 0.36
  cyl r=0.11+0.02*abs(sin(i*43)) h=2.3+0.5*abs(sin(i*31)) axis=z pos=-0.75+i*0.5,0.40,0.15*sin(i*77) rot=6*sin(i*23),0,4*sin(i*59) seg=7
end
for i = 0, 2
  color 0.53 0.50 0.44
  cyl r=0.09+0.02*abs(sin(i*41)) h=1.9+0.4*abs(sin(i*17)) axis=x pos=0.25*sin(i*67),0.64,-0.4+i*0.42 rot=0,25+20*i,8*sin(i*29) seg=6
end
# Pale sawn ends on the bottom layer
color #a8956e
for i = 0, 4
  set L = 2.6+0.6*abs(sin(i*29))
  cyl r=0.12+0.03*abs(sin(i*71)) h=0.012 axis=x pos=0.2*sin(i*83)+L/2*cos(8*sin(i*47)),0.14,-0.9+i*0.42-L/2*sin(8*sin(i*47)) rot=0,8*sin(i*47),0 seg=7
end
# Branch stubs poking out of the logs
color #8b8270
for k = 0, 9
  set a = k*36+11
  cyl r=0.03 r2=0.012 h=0.45+0.25*abs(sin(k*53)) pos=0.9*sin(a),0.35+0.25*abs(sin(k*29)),0.8*cos(a) rot=35*sin(k*71),a,55+20*sin(k*13) seg=4
end
# ---- Upturned root wad at one end: a dark earthy disc with root stubs ----
color #4a3a28
material mud
sphere r=0.48 pos=1.50,0.42,-0.3 scale=0.55,1,1.1 rot=0,0,-12 seg=7
sphere r=0.30 pos=1.58,0.70,0.0 scale=0.6,1,1 seg=6
material matte
color #5e4b35
for k = 0, 7
  set a = k*45
  cyl r=0.035 r2=0.01 h=0.55 pos=1.62,0.50+0.55*sin(a),-0.3+0.55*cos(a) rot=a-90,0,0 seg=4
end
# ---- Thin brush tangled on top ----
color #6b5f4c
for k = 0, 13
  set a = k*27+5
  cyl r=0.012 r2=0.004 h=0.8+0.5*abs(sin(k*37)) pos=0.6*sin(a),0.85+0.15*sin(k*19),0.5*cos(a) rot=40*sin(k*61),a,60*sin(k*23) seg=3
end
# Dry leaves and dirt pushed up round the base
color #6e5434
material mud
sphere r=1.0 pos=0,-0.12,0 scale=1.9,0.26,1.4 seg=8
color #8a6a3c
material leaf
sphere r=0.45 pos=-0.9,0.05,0.6 scale=1.2,0.25,1 seg=6
sphere r=0.40 pos=0.8,0.05,-0.8 scale=1.3,0.25,1 seg=6
