# Dark conifer in the tree line behind the bus (photo 1): a narrow dense core wrapped in whorls
# of drooping branch sprays, each tier rotated against the last so the silhouette is ragged,
# lighter new growth at the tips, a spire leader on top.
param h = 7
color #4d3c2a
material matte
cyl r=0.17 r2=0.05 h=h pos=0,h/2,0 seg=6
# exposed dead branch stubs low on the trunk
color #3b2f22
cyl r=0.025 r2=0.01 h=0.6 pos=0.28,h*0.07,0 rot=0,0,-70 seg=4
cyl r=0.025 r2=0.01 h=0.5 pos=-0.22,h*0.09,0.12 rot=20,0,65 seg=4
material leaf
# dense inner core (keeps the tree from looking see-through between sprays)
color #1b3121
cyl r=1.45 r2=0.06 h=h*0.86 pos=0,h*0.55,0 seg=9
# whorls of branch sprays: 9 tiers, 6 sprays each, drooping, shrinking toward the top
for t = 0, 8
  set R = 2.45*(1-t/9.6)+0.25
  set Y = h*(0.13+t*0.093)
  for k = 0, 5
    set a = k*60+t*37
    # outer sprays catch lighter new growth at the tips
    color 0.13+0.04*sin(t*71+k*43) 0.25+0.06*sin(t*29+k*61) 0.15+0.02*sin(k*53)
    sphere r=R*0.42 pos=R*0.52*sin(a),Y-R*0.12,R*0.52*cos(a) scale=0.38,0.34,1 rot=24,a,0 seg=5
    # a shorter, darker spray between each pair, tucked higher and further in
    color 0.09 0.18+0.03*sin(t*41+k*17) 0.11
    sphere r=R*0.3 pos=R*0.36*sin(a+30),Y+0.05,R*0.36*cos(a+30) scale=0.45,0.38,1 rot=18,a+30,0 seg=5
  end
end
# leader
color #24452b
cyl r=0.22 r2=0.01 h=1.2 pos=0,h*0.95+0.25,0 seg=6
