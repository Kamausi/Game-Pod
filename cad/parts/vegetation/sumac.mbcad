# Staghorn sumac / shrub with red fall color (photo 1, left edge).
param red = 1
color #5a4632
cyl r=0.05 h=1.4 pos=0,0.7,0 seg=5
color 0.62*red+0.30*(1-red) 0.12*red+0.32*(1-red) 0.10
sphere r=0.9 pos=0,1.6,0 scale=1.3,0.8,1.2 seg=8
sphere r=0.7 pos=0.6,1.3,0.3 scale=1,0.8,1 seg=8
sphere r=0.6 pos=-0.6,1.2,-0.2 scale=1,0.8,1 seg=8
