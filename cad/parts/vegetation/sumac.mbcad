# Staghorn sumac in October (photo 1, left edge): a clump of three leaning, forked stems, each
# ending in an umbrella of long pinnate leaves drooping outward - built as a ring of small leaf
# clumps around a raised centre so the foliage shader breaks it into ragged leaves - scarlet
# through orange (red=0.25 for the greener, half-turned bushes), with crimson fruit cones on top.
param red = 1
set cR = 0.66*red+0.38*(1-red)
set cG = 0.11*red+0.36*(1-red)
set cB = 0.08*red+0.10*(1-red)
# ---- Stems (velvety brown, leaning out from the clump) ----
color #5b4634
material matte
cyl r=0.045 r2=0.03 h=1.55 pos=0.12,0.74,0 rot=0,0,-9 seg=6
cyl r=0.04 r2=0.028 h=1.35 pos=-0.18,0.64,0.14 rot=11,0,10 seg=6
cyl r=0.04 r2=0.026 h=1.20 pos=0.02,0.58,-0.20 rot=-13,0,-2 seg=6
cyl r=0.025 r2=0.015 h=0.55 pos=0.40,1.62,0.05 rot=0,0,-48 seg=5
# ---- Leaf umbrellas: centre clump + a drooping ring of leaf clumps ----
material leaf
# head A (main stem)
color cR cG cB
sphere r=0.22 pos=0.25,1.66,0 scale=1.2,0.75,1.2 seg=6
for k = 0, 6
  set a = k*51.4
  color cR*(0.9+0.12*sin(k*97)) cG*(0.8+0.5*abs(sin(k*61))) cB
  sphere r=0.17 pos=0.25+0.36*sin(a),1.55,0.36*cos(a) scale=1.35,0.6,1 rot=0,a+90,-18 seg=6
end
# head B (fork on the main stem)
color cR*0.94 cG*1.15 cB
sphere r=0.18 pos=0.66,1.88,0.06 scale=1.2,0.75,1.2 seg=6
for k = 0, 5
  set a = k*60+20
  color cR*(0.95+0.1*sin(k*71)) cG*(0.9+0.6*abs(sin(k*43))) cB
  sphere r=0.14 pos=0.66+0.29*sin(a),1.79,0.06+0.29*cos(a) scale=1.35,0.6,1 rot=0,a+90,-18 seg=6
end
# head C (left stem)
color cR*1.04 cG*0.9 cB
sphere r=0.2 pos=-0.36,1.34,0.24 scale=1.2,0.75,1.2 seg=6
for k = 0, 6
  set a = k*51.4+10
  color cR*(0.88+0.14*sin(k*83)) cG*(0.8+0.5*abs(sin(k*29))) cB
  sphere r=0.16 pos=-0.36+0.33*sin(a),1.24,0.24+0.33*cos(a) scale=1.35,0.6,1 rot=0,a+90,-18 seg=6
end
# head D (short back stem)
color cR*0.96 cG*1.05 cB
sphere r=0.18 pos=0.13,1.16,-0.36 scale=1.2,0.75,1.2 seg=6
for k = 0, 5
  set a = k*60
  sphere r=0.14 pos=0.13+0.28*sin(a),1.07,-0.36+0.28*cos(a) scale=1.35,0.6,1 rot=0,a+90,-18 seg=6
end
# ---- Fruit cones: upright, dark crimson ----
color #6a1418
material matte
cyl r=0.06 r2=0.012 h=0.24 pos=0.25,1.84,0 seg=6
cyl r=0.05 r2=0.01 h=0.20 pos=0.66,2.04,0.06 seg=6
cyl r=0.055 r2=0.01 h=0.22 pos=-0.36,1.50,0.24 seg=6
