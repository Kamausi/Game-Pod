# Dried teasel (Dipsacus) clump at the fence line (photos 5-6): tall pale stems, paired dead
# leaves, egg-shaped spiny heads, each cupped by long upcurved bracts.
for i = 0, 3
  set a = i*90+31
  set h = 1.2+0.4*abs(sin(i*71))
  set ox = 0.10*sin(a)
  set oz = 0.10*cos(a)
  color #8e8268
  material matte
  cyl r=0.008 r2=0.006 h=h pos=ox,h/2,oz rot=6*cos(a),0,-6*sin(a) seg=4
  # paired dead leaves clasping the stem
  color #7a6a4e
  box size=0.03,0.006,0.22 pos=ox,h*0.4,oz rot=-25,a,0
  box size=0.03,0.006,0.22 pos=ox,h*0.4,oz rot=-25,a+180,0
  # spiny head
  color #5e4a33
  sphere r=0.034 pos=ox+0.05*sin(a),h+0.02,oz+0.05*cos(a) scale=1,1.7,1 seg=6
  color #6e5a40
  for b = 0, 3
    box size=0.008,0.12,0.008 pos=ox+0.05*sin(a)+0.04*sin(b*90),h-0.03,oz+0.05*cos(a)+0.04*cos(b*90) rot=35*cos(b*90),0,-35*sin(b*90)
  end
end
