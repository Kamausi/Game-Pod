# Aspen / poplar in October: tall slender pale trunk, sparse yellow crown of leaf clusters (all photos).
param h = 9
param yellow = 0.85
color #b9b4a4
material matte
cyl r=0.13 r2=0.045 h=h pos=0,h/2,0 seg=8
color #3e3a33
# dark lenticel bands and knots on the bark
cyl r=0.125 h=0.05 pos=0,h*0.18,0 seg=8
cyl r=0.11 h=0.04 pos=0,h*0.33,0 seg=8
cyl r=0.095 h=0.05 pos=0,h*0.47,0 seg=8
color #8d8676
# upswept branches
cyl r=0.035 r2=0.012 h=1.10 pos=0.385,h*0.45+0.33,0.000 rot=0.0,0,-38.0 seg=5
cyl r=0.035 r2=0.012 h=1.02 pos=-0.263,h*0.51+0.31,0.241 rot=31.1,0,33.9 seg=5
