# Aspen / poplar in October: tall thin grey trunk, sparse yellow crown (all photos).
param h = 9
param yellow = 0.85
color #8f8a7a
cyl r=0.12 r2=0.05 h=h pos=0,h/2,0 seg=7
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=1.1 pos=0,h*0.62,0 scale=1,2.2,1 seg=8
sphere r=0.9 pos=0.4,h*0.82,0.2 scale=1,1.8,1 seg=8
color 0.68*yellow+0.30*(1-yellow) 0.55*yellow+0.45*(1-yellow) 0.12
sphere r=0.8 pos=-0.4,h*0.5,-0.2 scale=1,1.6,1 seg=8
