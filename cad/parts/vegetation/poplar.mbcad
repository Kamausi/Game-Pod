# Aspen / poplar in October: tall slender pale trunk with dark lenticel bands and knots, upswept
# branches, a sparse crown of many small leaf clusters on twigs (the sky shows through), a few
# yellow leaves scattered on the ground. lod=1: the far version (a handful of big clusters).
param h = 9
param yellow = 0.85
param lod = 0
set nl = 1-lod
set cR = 0.80*yellow+0.35*(1-yellow)
set cG = 0.66*yellow+0.48*(1-yellow)
color #b9b4a4
material matte
cyl r=0.13 r2=0.045 h=h pos=0,h/2,0 seg=8
color #3e3a33
cyl r=0.125 h=0.05 pos=0,h*0.18,0 seg=8
cyl r=0.11 h=0.04 pos=0,h*0.33,0 seg=8
cyl r=0.095 h=0.05 pos=0,h*0.47,0 seg=8
# black diamond knots where lower branches fell off (near only)
for k = 0, 4
  box size=0.05*nl,0.08*nl,0.02 pos=0.118*sin(k*137),h*(0.10+k*0.07),0.118*cos(k*137) rot=0,k*137,45
end
color #8d8676
# upswept branches
for k = 0, 9
  set a = k*137.5
  set y = h*(0.42+k*0.048)
  set L = 1.25-k*0.08
  cyl r=0.035 r2=0.012 h=L pos=0.4*L*sin(a)*0.85,y+0.3*L,0.4*L*cos(a)*0.85 rot=-38*cos(a),0,38*sin(a) seg=5
end
# ---- Near crown: ~40 overlapping leaf clusters spiralling through a tall ellipsoid ----
material leaf
for k = 0, 39
  set t = k/39
  set a = k*137.5
  set rr = (0.30+1.05*sin(180*t))*(0.45+0.55*abs(sin(k*71)))
  color cR*(0.88+0.2*abs(sin(k*53))) cG*(0.86+0.22*abs(sin(k*29))) 0.12+0.08*abs(sin(k*17))
  sphere r=(0.30+0.18*abs(sin(k*41)))*nl pos=rr*sin(a),h*(0.44+0.50*t)+0.35*sin(k*83),rr*cos(a) scale=1.2,0.9,1.1 seg=5
end
# a few fallen leaves at the foot of the trunk
color cR*0.9 cG*0.85 0.12
for k = 0, 5
  box size=0.25*nl,0.004,0.18 pos=0.7*sin(k*97),0.003,0.7*cos(k*97) rot=0,k*61,0
end
# ---- Far crown (lod=1): the original big clusters ----
material leaf
# crown: leaf clusters scattered through a tall ellipsoid
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.56 pos=-0.94,h*0.676,-0.37 scale=lod,1.45,1 seg=6
color 0.72*yellow+0.30*(1-yellow) 0.58*yellow+0.44*(1-yellow) 0.12
sphere r=0.61 pos=0.28,h*0.744,0.64 scale=lod,1.60,1 seg=6
color 0.88*yellow+0.40*(1-yellow) 0.74*yellow+0.52*(1-yellow) 0.20
sphere r=0.66 pos=-0.07,h*0.497,0.19 scale=lod,1.55,1 seg=6
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.62 pos=0.56,h*0.471,-0.06 scale=lod,1.51,1 seg=6
color 0.72*yellow+0.30*(1-yellow) 0.58*yellow+0.44*(1-yellow) 0.12
sphere r=0.44 pos=0.58,h*0.529,0.05 scale=lod,1.30,1 seg=6
color 0.88*yellow+0.40*(1-yellow) 0.74*yellow+0.52*(1-yellow) 0.20
sphere r=0.55 pos=0.62,h*0.571,0.12 scale=lod,1.62,1 seg=6
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.62 pos=-0.46,h*0.710,-0.56 scale=lod,1.43,1 seg=6
color 0.72*yellow+0.30*(1-yellow) 0.58*yellow+0.44*(1-yellow) 0.12
sphere r=0.67 pos=0.96,h*0.589,-0.01 scale=lod,1.55,1 seg=6
color 0.88*yellow+0.40*(1-yellow) 0.74*yellow+0.52*(1-yellow) 0.20
sphere r=0.44 pos=0.07,h*0.608,0.53 scale=lod,1.58,1 seg=6
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.71 pos=0.37,h*0.650,-0.53 scale=lod,1.62,1 seg=6
color 0.72*yellow+0.30*(1-yellow) 0.58*yellow+0.44*(1-yellow) 0.12
sphere r=0.56 pos=0.11,h*0.450,0.44 scale=lod,1.69,1 seg=6
color 0.88*yellow+0.40*(1-yellow) 0.74*yellow+0.52*(1-yellow) 0.20
sphere r=0.65 pos=0.74,h*0.649,0.37 scale=lod,1.33,1 seg=6
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.65 pos=-0.33,h*0.494,0.57 scale=lod,1.26,1 seg=6
color 0.72*yellow+0.30*(1-yellow) 0.58*yellow+0.44*(1-yellow) 0.12
sphere r=0.66 pos=0.18,h*0.573,0.14 scale=lod,1.29,1 seg=6
color 0.88*yellow+0.40*(1-yellow) 0.74*yellow+0.52*(1-yellow) 0.20
sphere r=0.64 pos=-0.41,h*0.730,0.14 scale=lod,1.27,1 seg=6
color 0.80*yellow+0.35*(1-yellow) 0.66*yellow+0.48*(1-yellow) 0.15
sphere r=0.48 pos=0.44,h*0.772,0.40 scale=lod,1.33,1 seg=6
