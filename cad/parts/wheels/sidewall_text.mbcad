text str=R size=size*0.6 t=td*0.6 depth=0.004 pos=rl*sin(90+(3-4.0)*st*0.62),rl*cos(90+(3-4.0)*st*0.62),z rot=0,0,-(90+(3-4.0)*st*0.62) scale=scl,scl,scl
text str=A size=size*0.6 t=td*0.6 depth=0.004 pos=rl*sin(90+(4-4.0)*st*0.62),rl*cos(90+(4-4.0)*st*0.62),z rot=0,0,-(90+(4-4.0)*st*0.62) scale=scl,scl,scl
text str=D size=size*0.6 t=td*0.6 depth=0.004 pos=rl*sin(90+(5-4.0)*st*0.62),rl*cos(90+(5-4.0)*st*0.62),z rot=0,0,-(90+(5-4.0)*st*0.62) scale=scl,scl,scl
text str=I size=size*0.6 t=td*0.6 depth=0.004 pos=rl*sin(90+(6-4.0)*st*0.62),rl*cos(90+(6-4.0)*st*0.62),z rot=0,0,-(90+(6-4.0)*st*0.62) scale=scl,scl,scl
