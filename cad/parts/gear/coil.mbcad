# Coil spring, unit length along +Z from the origin (stretched between the spring perches so it
# compresses with the suspension). r = coil radius, col = 0 red, 1 yellow, 2 black.
param r = 0.07
param col = 0
color 0.75*max(0,1-abs(col-0))+0.85*max(0,1-abs(col-1))+0.1*max(0,1-abs(col-2)) 0.1*max(0,1-abs(col-0))+0.62*max(0,1-abs(col-1))+0.1*max(0,1-abs(col-2)) 0.08+0.04*max(0,1-abs(col-1))
material paint
for k = 0, 47
  set a = k*45+22.5
  box size=r*0.80,0.016,0.016 pos=r*cos(a),r*sin(a),k/47 rot=0,0,a+90
end
