box size=0.08,0.04,0.04 pos=0.4,1.97,0.38 mirror=x
color #111111
material rubber
cyl r=0.40 h=0.28 axis=x pos=0.86,0.40,FA mirror=x
cyl r=0.40 h=0.26 axis=x pos=0.86,0.40,RA mirror=x
cyl r=0.40 h=0.26 axis=x pos=1.12,0.40,RA mirror=x
