# Parked heavy-duty dually crew-cab tow truck with gooseneck hitch, wheels included.
# Front faces +Z. Origin at ground centre. ~2.4 m wide at the duals, 6.6 m long.
param paint_r = 0.90
param paint_g = 0.90
param paint_b = 0.90
set FA = 2.10
set RA = -1.80
color paint_r paint_g paint_b
material paint
extrude depth=2.0 bevel=0.05 pts=1.10,0.65,1.12,1.20,3.25,1.12,3.30,0.90,3.30,0.62
extrude depth=2.0 bevel=0.05 pts=-1.05,0.62,-1.05,1.30,1.12,1.30,1.12,0.62
extrude depth=1.92 bevel=0.04 pts=0.75,1.30,0.35,1.92,-0.95,1.95,-1.05,1.30
box size=2.40,0.75,2.30 pos=0,1.00,-2.10 bevel=0.04
color #1c1c1c
material matte
box size=2.16,0.04,2.20 pos=0,1.35,-2.10
cyl r=0.05 h=0.20 pos=0,1.45,-1.90
color #10161c
material glass
extrude depth=1.95 pts=0.70,1.32,0.33,1.88,-0.92,1.90,-1.02,1.32
color #c4c4c0
material chrome
