# Family minivan for the visitor lot: short sloped nose, tall glasshouse, sliding rear doors on a hidden track, vertical tail lamps up the D-pillars, roof rails, rear wiper, steel wheels with hubcaps.
# Front faces +Z. Origin at ground centre. Shares props/car_wheels.mbcad with the other lot cars.
param paint_r = 0.7
param paint_g = 0.7
param paint_b = 0.72
set FA = 1.65
set RA = -1.4
set WR = 0.34
set W = 1.95
set ZF = 2.56
set ZR = -2.56
color paint_r paint_g paint_b
material paint
# Lower body: side profile with both wheel arches cut in
extrude depth=W bevel=0.08 pts=-2.50,0.30,arc(RA,WR,WR+0.06,180,0,10),arc(FA,WR,WR+0.06,180,0,10),2.50,0.30,2.56,0.52,2.46,0.80,1.85,0.98,1.45,1.05,-2.45,1.08,-2.56,0.90
# Greenhouse and glass
extrude depth=1.8 bevel=0.06 pts=1.45,1.04,0.70,1.72,-2.30,1.78,-2.52,1.66,-2.52,1.06
color #10161c
material glass
extrude depth=1.8+0.04 pts=1.38,1.07,0.68,1.66,-2.28,1.72,-2.48,1.62,-2.48,1.10
# Blacked-out pillars across the glass
color #121212
material matte
box size=1.845,0.60,0.08 pos=0,1.38,0.20
box size=1.845,0.60,0.10 pos=0,1.40,-1.12
box size=1.845,0.58,0.12 pos=0,1.40,-2.22
# Black lower cladding: bumpers, sills and arch liners
color #1b1b1b
extrude depth=W+0.02 pts=arc(FA,WR,WR+0.11,182,-2,12),arc(FA,WR,WR+0.05,-2,182,12)
extrude depth=W+0.02 pts=arc(RA,WR,WR+0.11,182,-2,12),arc(RA,WR,WR+0.05,-2,182,12)
box size=W+0.02,0.10,FA-RA-2*WR-0.20 pos=0,0.33,(FA+RA)/2
box size=W+0.04,0.16,0.16 pos=0,0.38,ZF-0.04 bevel=0.03
box size=W+0.04,0.16,0.16 pos=0,0.38,ZR+0.04 bevel=0.03
# Door seams, chrome beltline trim and handles
color paint_r*0.45 paint_g*0.45 paint_b*0.45
box size=W+0.008,0.70,0.012 pos=0,0.72,1.30
box size=W+0.008,0.70,0.012 pos=0,0.72,0.20
box size=W+0.008,0.70,0.012 pos=0,0.72,-1.14
box size=W+0.008,0.012,3.40 pos=0,0.42,-0.20
color #2a2a2a
box size=W+0.012,0.025,1.30 pos=0,1.10,-1.72
color #c9c9c4
material chrome
box size=1.8+0.05,0.02,3.7 pos=0,1.07,-0.45
box size=W+0.02,0.03,0.14 pos=0,0.92,0.55
box size=W+0.02,0.03,0.14 pos=0,0.92,-0.10
# Mirrors
color paint_r paint_g paint_b
material paint
box size=0.16,0.10,0.14 pos=W/2+0.06,1.1,1.2 mirror=x bevel=0.03
color #0d0d0d
material matte
box size=0.10,0.02,0.10 pos=W/2+0.01,1.1-0.06,1.2+0.03 mirror=x
# Front: grille, badge, headlamps, indicators, fog lamps, plate
color #0d0d0d
material matte
box size=1.0,0.18,0.04 pos=0,0.66,ZF-0.01 bevel=0.02
box size=W*0.62,0.10,0.04 pos=0,0.42,ZF+0.04
color #c8c8c8
material chrome
box size=1.0,0.02,0.045 pos=0,0.66+0.18*0.25,ZF
cyl r=0.045 h=0.02 axis=z pos=0,0.66,ZF+0.012 seg=10
color #e8eef2
material lens
box size=0.38,0.11,0.05 pos=W/2-0.30,0.8,ZF-0.06 rot=0,-14,0 bevel=0.015 mirror=x
cyl r=0.04 h=0.03 axis=z pos=W/2-0.22,0.42,ZF+0.055 seg=10 mirror=x
color #e08a1a
box size=0.10,0.05,0.12 pos=W/2-0.04,0.8-0.04,ZF-0.18 mirror=x
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.50,ZF+0.065
# Rear: tail lamps, reflectors, plate recess, exhaust, third brake light
color #b01313
material lens
box size=0.07,0.50,0.16 pos=W/2-0.04,1.20,ZR+0.10 mirror=x
box size=0.40,0.06,0.04 pos=0,1.70,-2.53
box size=0.12,0.03,0.01 pos=W/2-0.20,0.40,ZR-0.045 mirror=x
color #0d0d0d
material matte
box size=0.36,0.19,0.01 pos=0,0.7,ZR-0.005
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.7,ZR-0.012
color #9a9a9a
material steel
cyl r=0.035 h=0.10 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
# Roof rails and rear wiper
color #2a2a2a
material steel
box size=0.04,0.05,2.30 pos=0.75,1.81,-0.70 mirror=x
box size=0.06,0.08,0.06 pos=0.75,1.79,0.40 mirror=x
box size=0.06,0.08,0.06 pos=0.75,1.79,-1.80 mirror=x
color #1a1a1a
material matte
box size=0.36,0.015,0.02 pos=0.12,1.25,-2.53 rot=0,0,-15
use props/car_wheels.mbcad FA=FA RA=RA WR=WR TX=W/2-0.13 TW=0.22 spokes=0
