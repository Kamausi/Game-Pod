# Family minivan for the visitor lot: short sloped nose, tall glasshouse, sliding rear doors on a hidden track, captain chairs, D-pillar tail lamps, roof rails, steel wheels with hubcaps.
# Generated by tools/gen_lot_cars.py. Front faces +Z. Origin at ground centre.
param paint_r = 0.7
param paint_g = 0.7
param paint_b = 0.72
param lod = 0          # 1 = far version: no cabin, plain tires, no lettering
set nl = 1-lod
set FA = 1.65
set RA = -1.4
set WR = 0.34
set W = 1.95
set ZF = 2.56
set ZR = -2.56
color paint_r paint_g paint_b
material paint
# Lower body: side profile with both wheel arches cut in
extrude depth=W bevel=0.08 pts=-2.50,0.30,arc(RA,WR,WR+0.06,180,0,10),arc(FA,WR,WR+0.06,180,0,10),2.50,0.30,2.56,0.52,2.46,0.80,1.85,0.98,1.45,1.05,-2.45,1.08,-2.56,0.90
# Open greenhouse: roof skin, A/B/C pillars and headers in body colour
extrude depth=1.820 bevel=0.03 pts=0.7,1.72,-2.3,1.78,-2.3,1.73,0.7,1.67
box size=0.08,1.052,0.09 pos=0.865,1.380,1.075 rot=-47.80,0,0 mirror=x
box size=0.08,0.291,0.09 pos=0.865,1.720,-2.410 rot=-118.61,0,0 mirror=x
box size=0.08,0.640,0.09 pos=0.865,1.360,-2.520 rot=180.00,0,0 mirror=x
box size=0.08,0.680,0.10 pos=0.865,1.400,0.2 mirror=x
box size=0.08,0.690,0.10 pos=0.865,1.415,-1.12 mirror=x
color #121212
material matte
box size=1.800,0.05,0.07 pos=0,1.680,0.700
# See-through glass round the cabin
color #10161c
material glass
extrude depth=1.780 pts=1.38,1.020,0.68,1.690,-2.28,1.750,-2.48,1.640,-2.48,1.040
# Cabin (seats, dash, wheel) seen through the glass
use props/car_cabin.mbcad W=1.680 bl=1.06 wz=1.4 bz=-2.3 ry=1.72 mid=1 seat_r=0.16 seat_g=0.16 seat_b=0.17 scale=nl,nl,nl
# Black lower cladding: arch liners, sills, bumper inserts
color #1b1b1b
material matte
extrude depth=W+0.02 pts=arc(FA,WR,WR+0.11,182,-2,12),arc(FA,WR,WR+0.05,-2,182,12)
extrude depth=W+0.02 pts=arc(RA,WR,WR+0.11,182,-2,12),arc(RA,WR,WR+0.05,-2,182,12)
box size=W+0.02,0.10,FA-RA-2*WR-0.20 pos=0,0.33,(FA+RA)/2
box size=W+0.04,0.16,0.16 pos=0,0.38,ZF-0.04 bevel=0.03
box size=W+0.04,0.16,0.16 pos=0,0.38,ZR+0.04 bevel=0.03
# Feature crease, door seams, chrome beltline trim, handles
color paint_r*0.72 paint_g*0.72 paint_b*0.72
box size=W+0.006,0.012,4.6 pos=0,0.7,0.0
color paint_r*0.45 paint_g*0.45 paint_b*0.45
box size=W+0.008,0.70,0.012 pos=0,0.72,1.30
box size=W+0.008,0.70,0.012 pos=0,0.72,0.20
box size=W+0.008,0.70,0.012 pos=0,0.72,-1.14
box size=W+0.008,0.012,3.40 pos=0,0.42,-0.20
color #2a2a2a
box size=W+0.012,0.025,1.30 pos=0,1.10,-1.72
color #c9c9c4
material chrome
box size=0.025,0.02,3.7 pos=0.912,1.07,-0.45 mirror=x
box size=W+0.02,0.03,0.14 pos=0,0.92,0.55
box size=W+0.02,0.03,0.14 pos=0,0.92,-0.10
# Mirrors with indicator repeaters
color paint_r paint_g paint_b
material paint
box size=0.16,0.10,0.14 pos=W/2+0.06,1.1,1.2 mirror=x bevel=0.03
color #0d0d0d
material matte
box size=0.10,0.02,0.10 pos=W/2+0.01,1.1-0.06,1.2+0.03 mirror=x
color #e08a1a
material lens
box size=0.10,0.015,0.02 pos=W/2+0.07,1.1-0.03,1.2+0.072 mirror=x
# Cowl, wipers and washer jets
color #111111
material matte
box size=1.750,0.03,0.14 pos=0,1.045,1.470
box size=0.60,0.018,0.025 pos=0.30,1.075,1.390 rot=0,8,0
box size=0.52,0.018,0.025 pos=-0.28,1.075,1.390 rot=0,8,0
cyl r=0.012 h=0.02 pos=0.25,1.050,1.630 seg=6 mirror=x
# Front: grille with slats, badge, projector headlamps with LED strips, fog lamps, plate
color #0d0d0d
box size=1.0,0.18,0.04 pos=0,0.66,ZF-0.01 bevel=0.02
box size=W*0.62,0.10,0.04 pos=0,0.42,ZF+0.04
color #3a3a3a
for k = 0, 2
  box size=1.0-0.06,0.012,0.045 pos=0,0.66-0.18*0.3+k*0.18*0.3,ZF
end
color #c8c8c8
material chrome
box size=1.0,0.02,0.05 pos=0,0.66+0.18*0.5,ZF
cyl r=0.045 h=0.02 axis=z pos=0,0.66,ZF+0.015 seg=10
color #e8eef2
material lens
box size=0.38,0.11,0.05 pos=W/2-0.30,0.8,ZF-0.06 rot=0,-14,0 bevel=0.015 mirror=x
color #f8fbff
box size=0.30,0.015,0.02 pos=W/2-0.30,0.8-0.045,ZF-0.025 rot=0,-14,0 mirror=x
color #9aa4ac
material chrome
cyl r=0.035 h=0.02 axis=z pos=W/2-0.22,0.8,ZF-0.02 seg=10 mirror=x
cyl r=0.030 h=0.02 axis=z pos=W/2-0.36,0.8,ZF-0.05 seg=10 mirror=x
color #e8eef2
material lens
cyl r=0.04 h=0.03 axis=z pos=W/2-0.22,0.42,ZF+0.055 seg=10 mirror=x
color #e08a1a
box size=0.10,0.05,0.12 pos=W/2-0.04,0.8-0.04,ZF-0.18 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.8-0.10,ZF-0.40 mirror=x
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.50,ZF+0.065
color #1a2a4a
text str=MOM-VAN size=0.05 t=0.012 depth=0.004 pos=0,0.50,ZF+0.07 scale=nl,nl,nl
# Rear: tail lamps, side reflectors, plate with lamp, badge, exhaust, third brake light
color #b01313
material lens
box size=0.07,0.50,0.16 pos=W/2-0.04,1.20,ZR+0.10 mirror=x
box size=0.40,0.06,0.04 pos=0,1.70,-2.53
box size=0.12,0.03,0.01 pos=W/2-0.20,0.40,ZR-0.045 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.55,ZR+0.30 mirror=x
color #0d0d0d
material matte
box size=0.36,0.19,0.01 pos=0,0.7,ZR-0.005
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.7,ZR-0.012
color #1a2a4a
text str=MOM-VAN size=0.05 t=0.012 depth=0.004 pos=0,0.7,ZR-0.016 rot=0,180,0 scale=nl,nl,nl
color #c8c8c8
material chrome
text str=LX size=0.05 t=0.012 depth=0.006 pos=-W/2+0.40,0.7+0.16,ZR-0.012 rot=0,180,0 scale=nl,nl,nl
color #9a9a9a
material steel
cyl r=0.035 h=0.10 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
cyl r=0.028 h=0.11 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
# Fuel door on the right rear quarter, shark-fin antenna
color paint_r*0.55 paint_g*0.55 paint_b*0.55
material paint
box size=0.006,0.17,0.17 pos=-W/2-0.002,0.85,-1.95
color #151515
material plastic
wedge size=0.06,0.07,0.16 pos=0,1.81,-1.6
# Roof rails and rear wiper
color #2a2a2a
material steel
box size=0.04,0.05,2.30 pos=0.75,1.81,-0.70 mirror=x
box size=0.06,0.08,0.06 pos=0.75,1.79,0.40 mirror=x
box size=0.06,0.08,0.06 pos=0.75,1.79,-1.80 mirror=x
color #1a1a1a
material matte
box size=0.36,0.015,0.02 pos=0.12,1.25,-2.53 rot=0,0,-15
use props/car_wheels.mbcad FA=FA RA=RA WR=WR TX=W/2-0.13 TW=0.22 spokes=0 lod=lod
