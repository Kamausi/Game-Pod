# 55-gallon steel drum used as course markers (photo 3): black w/ yellow sponsor
# band (PJ1-style), or faded blue. Lathed shell with the two rolling hoops, rolled chimes
# top and bottom, recessed lid with bung caps, mud splashed up the base. Origin at ground center.
param r = 0.29
param h = 0.88
param body_r = 0.08
param body_g = 0.08
param body_b = 0.08
param band_r = 0.95
param band_g = 0.82
param band_b = 0.10
param band = 1
set b = r*0.975
material paint
color body_r body_g body_b
lathe seg=22 pts=0,0,b-0.008,0,r,0.012,r,0.03,b,0.042,b,h*0.31,r,h*0.325,r,h*0.345,b,h*0.36,b,h*0.59,r,h*0.605,r,h*0.625,b,h*0.64,b,h-0.042,r,h-0.022,r,h,b-0.012,h,b-0.018,h-0.012,0,h-0.012
# Sponsor band
color band_r band_g band_b
cyl r=b*1.006 h=h*0.20*band pos=0,h*0.80,0 seg=22
# Bung caps on the lid (2" and 3/4")
color body_r*1.6+0.05 body_g*1.6+0.05 body_b*1.6+0.05
material steel
cyl r=0.032 h=0.018 pos=r*0.55,h-0.004,0.03 seg=8
cyl r=0.018 h=0.016 pos=-r*0.58,h-0.004,-0.04 seg=8
# Mud splashed up the base, with drips running up the sides
color #4e3e2a
material mud
cyl r=b*1.008 h=0.10 pos=0,0.05,0 seg=22
for k = 0, 8
  set a = k*40+13
  box size=0.05+0.03*abs(sin(k*71)),0.10+0.12*abs(sin(k*37)),0.012 pos=b*1.004*sin(a),0.12+0.06*abs(sin(k*37)),b*1.004*cos(a) rot=0,a,0
end
