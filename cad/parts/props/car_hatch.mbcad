# Compact five-door hatchback for the visitor lot: stubby nose, upright tailgate with a roof spoiler, big-mouth grille, five-spoke alloys.
# Generated by tools/gen_lot_cars.py. Front faces +Z. Origin at ground centre.
param paint_r = 0.85
param paint_g = 0.12
param paint_b = 0.1
param lod = 0          # 1 = far version: no cabin, plain tires, no lettering
set nl = 1-lod
set FA = 1.25
set RA = -1.3
set WR = 0.3
set W = 1.75
set ZF = 2.04
set ZR = -2.02
color paint_r paint_g paint_b
material paint
# Lower body: side profile with both wheel arches cut in
extrude depth=W bevel=0.08 pts=-1.98,0.28,arc(RA,WR,WR+0.05,180,0,10),arc(FA,WR,WR+0.05,180,0,10),1.98,0.28,2.04,0.50,1.95,0.70,1.05,0.88,-1.85,0.95,-2.02,0.80
# Open greenhouse: roof skin, A/B/C pillars and headers in body colour
extrude depth=1.620 bevel=0.03 pts=0.25,1.42,-1.55,1.46,-1.55,1.41,0.25,1.3699999999999999
box size=0.08,0.970,0.09 pos=0.765,1.145,0.625 rot=-53.75,0,0 mirror=x
box size=0.08,0.532,0.09 pos=0.765,1.340,-1.765 rot=-119.17,0,0 mirror=x
box size=0.08,0.320,0.09 pos=0.765,1.080,-1.980 rot=180.00,0,0 mirror=x
box size=0.08,0.530,0.10 pos=0.765,1.175,-0.35 mirror=x
color #121212
material matte
box size=1.600,0.05,0.07 pos=0,1.380,0.250
# See-through glass round the cabin
color #10161c
material glass
extrude depth=1.580 pts=0.94,0.850,0.23,1.390,-1.52,1.430,-1.92,1.200,-1.92,0.920
# Cabin (seats, dash, wheel) seen through the glass
use props/car_cabin.mbcad W=1.480 bl=0.91 wz=0.95 bz=-1.7 ry=1.4 mid=0 seat_r=0.16 seat_g=0.16 seat_b=0.17 scale=nl,nl,nl
# Black lower cladding: arch liners, sills, bumper inserts
color #1b1b1b
material matte
extrude depth=W+0.02 pts=arc(FA,WR,WR+0.11,182,-2,12),arc(FA,WR,WR+0.05,-2,182,12)
extrude depth=W+0.02 pts=arc(RA,WR,WR+0.11,182,-2,12),arc(RA,WR,WR+0.05,-2,182,12)
box size=W+0.02,0.10,FA-RA-2*WR-0.20 pos=0,0.33,(FA+RA)/2
box size=W+0.04,0.16,0.16 pos=0,0.38,ZF-0.04 bevel=0.03
box size=W+0.04,0.16,0.16 pos=0,0.38,ZR+0.04 bevel=0.03
# Feature crease, door seams, chrome beltline trim, handles
color paint_r*0.72 paint_g*0.72 paint_b*0.72
box size=W+0.006,0.012,3.6 pos=0,0.64,0.0
color paint_r*0.45 paint_g*0.45 paint_b*0.45
box size=W+0.008,0.56,0.012 pos=0,0.64,0.95
box size=W+0.008,0.56,0.012 pos=0,0.64,-0.35
box size=W+0.008,0.50,0.012 pos=0,0.64,-1.40
box size=W+0.008,0.012,2.10 pos=0,0.40,-0.20
color #c9c9c4
material chrome
box size=0.025,0.02,2.4 pos=0.812,0.94,-0.42 mirror=x
box size=W+0.02,0.03,0.14 pos=0,0.80,0.55
box size=W+0.02,0.03,0.14 pos=0,0.80,-0.78
# Mirrors with indicator repeaters
color paint_r paint_g paint_b
material paint
box size=0.16,0.10,0.14 pos=W/2+0.06,0.98,0.85 mirror=x bevel=0.03
color #0d0d0d
material matte
box size=0.10,0.02,0.10 pos=W/2+0.01,0.98-0.06,0.85+0.03 mirror=x
color #e08a1a
material lens
box size=0.10,0.015,0.02 pos=W/2+0.07,0.98-0.03,0.85+0.072 mirror=x
# Cowl, wipers and washer jets
color #111111
material matte
box size=1.550,0.03,0.14 pos=0,0.875,1.020
box size=0.60,0.018,0.025 pos=0.30,0.905,0.940 rot=0,8,0
box size=0.52,0.018,0.025 pos=-0.28,0.905,0.940 rot=0,8,0
cyl r=0.012 h=0.02 pos=0.25,0.880,1.180 seg=6 mirror=x
# Front: grille with slats, badge, projector headlamps with LED strips, fog lamps, plate
color #0d0d0d
box size=0.8,0.24,0.04 pos=0,0.58,ZF-0.01 bevel=0.02
box size=W*0.62,0.10,0.04 pos=0,0.42,ZF+0.04
color #3a3a3a
for k = 0, 2
  box size=0.8-0.06,0.012,0.045 pos=0,0.58-0.24*0.3+k*0.24*0.3,ZF
end
color #c8c8c8
material chrome
box size=0.8,0.02,0.05 pos=0,0.58+0.24*0.5,ZF
cyl r=0.045 h=0.02 axis=z pos=0,0.58,ZF+0.015 seg=10
color #e8eef2
material lens
box size=0.38,0.11,0.05 pos=W/2-0.30,0.7,ZF-0.06 rot=0,-14,0 bevel=0.015 mirror=x
color #f8fbff
box size=0.30,0.015,0.02 pos=W/2-0.30,0.7-0.045,ZF-0.025 rot=0,-14,0 mirror=x
color #9aa4ac
material chrome
cyl r=0.035 h=0.02 axis=z pos=W/2-0.22,0.7,ZF-0.02 seg=10 mirror=x
cyl r=0.030 h=0.02 axis=z pos=W/2-0.36,0.7,ZF-0.05 seg=10 mirror=x
color #e8eef2
material lens
cyl r=0.04 h=0.03 axis=z pos=W/2-0.22,0.42,ZF+0.055 seg=10 mirror=x
color #e08a1a
box size=0.10,0.05,0.12 pos=W/2-0.04,0.7-0.04,ZF-0.18 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.7-0.10,ZF-0.40 mirror=x
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.50,ZF+0.065
color #1a2a4a
text str=ZIPPY-1 size=0.05 t=0.012 depth=0.004 pos=0,0.50,ZF+0.07 scale=nl,nl,nl
# Rear: tail lamps, side reflectors, plate with lamp, badge, exhaust, third brake light
color #b01313
material lens
box size=0.30,0.20,0.06 pos=W/2-0.18,1.02,ZR+0.04 bevel=0.02 mirror=x
box size=0.12,0.03,0.01 pos=W/2-0.20,0.40,ZR-0.045 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.55,ZR+0.30 mirror=x
color #0d0d0d
material matte
box size=0.36,0.19,0.01 pos=0,0.62,ZR-0.005
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.62,ZR-0.012
color #1a2a4a
text str=ZIPPY-1 size=0.05 t=0.012 depth=0.004 pos=0,0.62,ZR-0.016 rot=0,180,0 scale=nl,nl,nl
color #c8c8c8
material chrome
text str=GT size=0.05 t=0.012 depth=0.006 pos=-W/2+0.40,0.62+0.16,ZR-0.012 rot=0,180,0 scale=nl,nl,nl
color #9a9a9a
material steel
cyl r=0.035 h=0.10 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
cyl r=0.028 h=0.11 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
# Fuel door on the right rear quarter, shark-fin antenna
color paint_r*0.55 paint_g*0.55 paint_b*0.55
material paint
box size=0.006,0.17,0.17 pos=-W/2-0.002,0.78,-1.55
color #151515
material plastic
wedge size=0.06,0.07,0.16 pos=0,1.49,-1.25
# Roof spoiler over the tailgate glass and a rear wiper
color #121212
material plastic
box size=1.40,0.05,0.24 pos=0,1.47,-1.86 rot=-8,0,0 bevel=0.015
color #1a1a1a
material matte
box size=0.30,0.015,0.02 pos=0.10,1.05,-2.0 rot=0,0,-15
use props/car_wheels.mbcad FA=FA RA=RA WR=WR TX=W/2-0.13 TW=0.22 spokes=5 lod=lod
