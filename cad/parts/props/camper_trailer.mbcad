# Travel trailer 2.4 x 7 x 3 m with rounded ends, stripes, door and windows on +X, awning
# extended over a mat on +X, A-frame tongue toward +Z, tandem axle. Origin at ground centre.
param stripe_r = 0.15
param stripe_g = 0.30
param stripe_b = 0.55
color #eeece6
material paint
box size=2.40,2.30,6.4 pos=0,1.80,-0.30 bevel=0.30
color stripe_r stripe_g stripe_b
box size=2.42,0.14,6.0 pos=0,1.40,-0.30
box size=2.42,0.06,6.0 pos=0,1.62,-0.30
color #111820
material glass
box size=2.42,0.50,0.90 pos=0,2.15,0.90
box size=2.42,0.50,1.20 pos=0,2.15,-2.10
box size=2.10,0.45,0.04 pos=0,2.20,2.91
color #2a2a2a
material matte
box size=0.04,1.85,0.70 pos=1.21,1.55,-0.60
# Awning on the +X side, poles, mat
color stripe_r stripe_g stripe_b
box size=2.2,0.03,4.0 pos=2.30,2.65,-0.50 rot=0,0,-8
color #9a9a9a
material steel
cyl r=0.025 h=2.6 pos=3.35,1.30,1.45 mirror=z
cyl r=0.025 h=2.6 pos=3.35,1.30,-2.45
color #5a7a5a
material matte
box size=2.0,0.01,3.6 pos=2.30,0.005,-0.50
# Tongue, jack, propane tanks
color #2a2a2c
material steel
box size=0.10,0.10,1.4 pos=0.30,0.50,3.40 rot=0,10,0
box size=0.10,0.10,1.4 pos=-0.30,0.50,3.40 rot=0,-10,0
cyl r=0.035 h=0.50 pos=0,0.25,3.90
color #f2f2f2
material paint
cyl r=0.15 h=0.45 pos=0.18,0.80,3.25 mirror=x
color #111111
material rubber
cyl r=0.34 h=0.22 axis=x pos=1.05,0.34,-0.10 mirror=x
cyl r=0.34 h=0.22 axis=x pos=1.05,0.34,-0.90 mirror=x
color #b01313
material lens
box size=0.10,0.20,0.03 pos=1.00,1.00,-3.52 mirror=x
