# Four-door family sedan for the visitor lot: long hood, swept glasshouse into a short deck, chrome window line, lip spoiler, five-spoke alloys.
# Generated by tools/gen_lot_cars.py. Front faces +Z. Origin at ground centre.
param paint_r = 0.62
param paint_g = 0.62
param paint_b = 0.64
param lod = 0          # 1 = far version: no cabin, plain tires, no lettering
set nl = 1-lod
set FA = 1.4
set RA = -1.45
set WR = 0.32
set W = 1.83
set ZF = 2.44
set ZR = -2.44
color paint_r paint_g paint_b
material paint
# Lower body: side profile with both wheel arches cut in
extrude depth=W bevel=0.08 pts=-2.40,0.28,arc(RA,WR,WR+0.05,180,0,10),arc(FA,WR,WR+0.05,180,0,10),2.40,0.28,2.46,0.50,2.38,0.72,1.30,0.86,1.05,0.90,-1.55,0.94,-2.30,0.95,-2.44,0.80
# Open greenhouse: roof skin, A/B/C pillars and headers in body colour
extrude depth=1.680 bevel=0.03 pts=0.3,1.4,-0.8,1.44,-0.8,1.39,0.3,1.3499999999999999
box size=0.08,0.989,0.09 pos=0.7949999999999999,1.145,0.700 rot=-57.48,0,0 mirror=x
box size=0.08,1.006,0.09 pos=0.7949999999999999,1.185,-1.210 rot=-121.88,0,0 mirror=x
box size=0.08,0.500,0.10 pos=0.7949999999999999,1.170,-0.22 mirror=x
color #121212
material matte
box size=1.660,0.05,0.07 pos=0,1.360,0.300
# See-through glass round the cabin
color #10161c
material glass
extrude depth=1.640 pts=1.04,0.860,0.28,1.370,-0.78,1.410,-1.54,0.900
# Cabin (seats, dash, wheel) seen through the glass
use props/car_cabin.mbcad W=1.540 bl=0.91 wz=1.05 bz=-1.45 ry=1.37 mid=0 seat_r=0.16 seat_g=0.16 seat_b=0.17 scale=nl,nl,nl
# Black lower cladding: arch liners, sills, bumper inserts
color #1b1b1b
material matte
extrude depth=W+0.02 pts=arc(FA,WR,WR+0.11,182,-2,12),arc(FA,WR,WR+0.05,-2,182,12)
extrude depth=W+0.02 pts=arc(RA,WR,WR+0.11,182,-2,12),arc(RA,WR,WR+0.05,-2,182,12)
box size=W+0.02,0.10,FA-RA-2*WR-0.20 pos=0,0.33,(FA+RA)/2
box size=W+0.04,0.16,0.16 pos=0,0.38,ZF-0.04 bevel=0.03
box size=W+0.04,0.16,0.16 pos=0,0.38,ZR+0.04 bevel=0.03
# Feature crease, door seams, chrome beltline trim, handles
color paint_r*0.72 paint_g*0.72 paint_b*0.72
box size=W+0.006,0.012,4.5 pos=0,0.66,0.0
color paint_r*0.45 paint_g*0.45 paint_b*0.45
box size=W+0.008,0.56,0.012 pos=0,0.66,1.05
box size=W+0.008,0.56,0.012 pos=0,0.66,-0.22
box size=W+0.008,0.50,0.012 pos=0,0.66,-1.42
box size=W+0.008,0.012,2.45 pos=0,0.40,-0.18
color #c9c9c4
material chrome
box size=0.025,0.02,2.62 pos=0.842,0.935,-0.26 mirror=x
box size=W+0.02,0.03,0.14 pos=0,0.80,0.62
box size=W+0.02,0.03,0.14 pos=0,0.80,-0.62
# Mirrors with indicator repeaters
color paint_r paint_g paint_b
material paint
box size=0.16,0.10,0.14 pos=W/2+0.06,0.98,0.95 mirror=x bevel=0.03
color #0d0d0d
material matte
box size=0.10,0.02,0.10 pos=W/2+0.01,0.98-0.06,0.95+0.03 mirror=x
color #e08a1a
material lens
box size=0.10,0.015,0.02 pos=W/2+0.07,0.98-0.03,0.95+0.072 mirror=x
# Cowl, wipers and washer jets
color #111111
material matte
box size=1.610,0.03,0.14 pos=0,0.895,1.120
box size=0.60,0.018,0.025 pos=0.30,0.925,1.040 rot=0,8,0
box size=0.52,0.018,0.025 pos=-0.28,0.925,1.040 rot=0,8,0
cyl r=0.012 h=0.02 pos=0.25,0.900,1.280 seg=6 mirror=x
# Front: grille with slats, badge, projector headlamps with LED strips, fog lamps, plate
color #0d0d0d
box size=0.9,0.2,0.04 pos=0,0.62,ZF-0.01 bevel=0.02
box size=W*0.62,0.10,0.04 pos=0,0.42,ZF+0.04
color #3a3a3a
for k = 0, 2
  box size=0.9-0.06,0.012,0.045 pos=0,0.62-0.2*0.3+k*0.2*0.3,ZF
end
color #c8c8c8
material chrome
box size=0.9,0.02,0.05 pos=0,0.62+0.2*0.5,ZF
cyl r=0.045 h=0.02 axis=z pos=0,0.62,ZF+0.015 seg=10
color #e8eef2
material lens
box size=0.38,0.11,0.05 pos=W/2-0.30,0.7,ZF-0.06 rot=0,-14,0 bevel=0.015 mirror=x
color #f8fbff
box size=0.30,0.015,0.02 pos=W/2-0.30,0.7-0.045,ZF-0.025 rot=0,-14,0 mirror=x
color #9aa4ac
material chrome
cyl r=0.035 h=0.02 axis=z pos=W/2-0.22,0.7,ZF-0.02 seg=10 mirror=x
cyl r=0.030 h=0.02 axis=z pos=W/2-0.36,0.7,ZF-0.05 seg=10 mirror=x
color #e8eef2
material lens
cyl r=0.04 h=0.03 axis=z pos=W/2-0.22,0.42,ZF+0.055 seg=10 mirror=x
color #e08a1a
box size=0.10,0.05,0.12 pos=W/2-0.04,0.7-0.04,ZF-0.18 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.7-0.10,ZF-0.40 mirror=x
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.50,ZF+0.065
color #1a2a4a
text str=BOG-2026 size=0.05 t=0.012 depth=0.004 pos=0,0.50,ZF+0.07 scale=nl,nl,nl
# Rear: tail lamps, side reflectors, plate with lamp, badge, exhaust, third brake light
color #b01313
material lens
box size=0.46,0.12,0.06 pos=W/2-0.30,0.84,ZR+0.02 rot=0,10,0 mirror=x
box size=0.06,0.10,0.26 pos=W/2-0.02,0.84,ZR+0.16 mirror=x
box size=0.12,0.03,0.01 pos=W/2-0.20,0.40,ZR-0.045 mirror=x
box size=0.012,0.035,0.08 pos=W/2+0.004,0.55,ZR+0.30 mirror=x
color #0d0d0d
material matte
box size=0.36,0.19,0.01 pos=0,0.62,ZR-0.005
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.62,ZR-0.012
color #1a2a4a
text str=BOG-2026 size=0.05 t=0.012 depth=0.004 pos=0,0.62,ZR-0.016 rot=0,180,0 scale=nl,nl,nl
color #c8c8c8
material chrome
text str=SE size=0.05 t=0.012 depth=0.006 pos=-W/2+0.40,0.62+0.16,ZR-0.012 rot=0,180,0 scale=nl,nl,nl
color #9a9a9a
material steel
cyl r=0.035 h=0.10 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
cyl r=0.028 h=0.11 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
# Fuel door on the right rear quarter, shark-fin antenna
color paint_r*0.55 paint_g*0.55 paint_b*0.55
material paint
box size=0.006,0.17,0.17 pos=-W/2-0.002,0.78,-1.75
color #151515
material plastic
wedge size=0.06,0.07,0.16 pos=0,1.47,-0.95
# Trunk lip spoiler
color paint_r paint_g paint_b
material paint
box size=1.30,0.04,0.10 pos=0,0.975,-2.33 bevel=0.012
use props/car_wheels.mbcad FA=FA RA=RA WR=WR TX=W/2-0.13 TW=0.22 spokes=5 lod=lod
