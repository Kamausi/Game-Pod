# Four-door family sedan for the visitor lot: long hood, swept glasshouse running into a short rear deck, chrome window line, trunk lip spoiler, fins and shark-fin antenna, five-spoke alloys.
# Front faces +Z. Origin at ground centre. Shares props/car_wheels.mbcad with the other lot cars.
param paint_r = 0.62
param paint_g = 0.62
param paint_b = 0.64
set FA = 1.4
set RA = -1.45
set WR = 0.32
set W = 1.83
set ZF = 2.44
set ZR = -2.44
color paint_r paint_g paint_b
material paint
# Lower body: side profile with both wheel arches cut in
extrude depth=W bevel=0.08 pts=-2.40,0.28,arc(RA,WR,WR+0.05,180,0,10),arc(FA,WR,WR+0.05,180,0,10),2.40,0.28,2.46,0.50,2.38,0.72,1.30,0.86,1.05,0.90,-1.55,0.94,-2.30,0.95,-2.44,0.80
# Greenhouse and glass
extrude depth=1.66 bevel=0.06 pts=1.10,0.89,0.30,1.40,-0.80,1.44,-1.62,0.93
color #10161c
material glass
extrude depth=1.66+0.04 pts=1.02,0.92,0.28,1.36,-0.78,1.40,-1.52,0.96
# Blacked-out pillars across the glass
color #121212
material matte
box size=1.705,0.44,0.08 pos=0,1.16,-0.22
box size=1.705,0.36,0.08 pos=0,1.12,-1.05 rot=30,0,0
# Black lower cladding: bumpers, sills and arch liners
color #1b1b1b
extrude depth=W+0.02 pts=arc(FA,WR,WR+0.11,182,-2,12),arc(FA,WR,WR+0.05,-2,182,12)
extrude depth=W+0.02 pts=arc(RA,WR,WR+0.11,182,-2,12),arc(RA,WR,WR+0.05,-2,182,12)
box size=W+0.02,0.10,FA-RA-2*WR-0.20 pos=0,0.33,(FA+RA)/2
box size=W+0.04,0.16,0.16 pos=0,0.38,ZF-0.04 bevel=0.03
box size=W+0.04,0.16,0.16 pos=0,0.38,ZR+0.04 bevel=0.03
# Door seams, chrome beltline trim and handles
color paint_r*0.45 paint_g*0.45 paint_b*0.45
box size=W+0.008,0.56,0.012 pos=0,0.66,1.05
box size=W+0.008,0.56,0.012 pos=0,0.66,-0.22
box size=W+0.008,0.50,0.012 pos=0,0.66,-1.42
box size=W+0.008,0.012,2.45 pos=0,0.40,-0.18
color #c9c9c4
material chrome
box size=1.66+0.05,0.02,2.62 pos=0,0.935,-0.26
box size=W+0.02,0.03,0.14 pos=0,0.80,0.62
box size=W+0.02,0.03,0.14 pos=0,0.80,-0.62
# Mirrors
color paint_r paint_g paint_b
material paint
box size=0.16,0.10,0.14 pos=W/2+0.06,0.98,0.95 mirror=x bevel=0.03
color #0d0d0d
material matte
box size=0.10,0.02,0.10 pos=W/2+0.01,0.98-0.06,0.95+0.03 mirror=x
# Front: grille, badge, headlamps, indicators, fog lamps, plate
color #0d0d0d
material matte
box size=0.9,0.2,0.04 pos=0,0.62,ZF-0.01 bevel=0.02
box size=W*0.62,0.10,0.04 pos=0,0.42,ZF+0.04
color #c8c8c8
material chrome
box size=0.9,0.02,0.045 pos=0,0.62+0.2*0.25,ZF
cyl r=0.045 h=0.02 axis=z pos=0,0.62,ZF+0.012 seg=10
color #e8eef2
material lens
box size=0.38,0.11,0.05 pos=W/2-0.30,0.7,ZF-0.06 rot=0,-14,0 bevel=0.015 mirror=x
cyl r=0.04 h=0.03 axis=z pos=W/2-0.22,0.42,ZF+0.055 seg=10 mirror=x
color #e08a1a
box size=0.10,0.05,0.12 pos=W/2-0.04,0.7-0.04,ZF-0.18 mirror=x
color #f2f2ee
material matte
box size=0.30,0.15,0.01 pos=0,0.50,ZF+0.065
# Rear: tail lamps, reflectors, plate recess, exhaust, third brake light
color #b01313
material lens
box size=0.46,0.12,0.06 pos=W/2-0.30,0.84,ZR+0.02 rot=0,10,0 mirror=x
box size=0.06,0.10,0.26 pos=W/2-0.02,0.84,ZR+0.16 mirror=x
box size=0.12,0.03,0.01 pos=W/2-0.20,0.40,ZR-0.045 mirror=x
color #0d0d0d
material matte
box size=0.36,0.19,0.01 pos=0,0.62,ZR-0.005
color #f2f2ee
box size=0.30,0.15,0.01 pos=0,0.62,ZR-0.012
color #9a9a9a
material steel
cyl r=0.035 h=0.10 axis=z pos=W/2-0.40,0.30,ZR-0.02 seg=10
# Trunk lip spoiler and a shark-fin antenna
color paint_r paint_g paint_b
material paint
box size=1.30,0.04,0.10 pos=0,0.975,-2.33 bevel=0.012
color #151515
material plastic
wedge size=0.06,0.07,0.16 pos=0,1.47,-0.95
use props/car_wheels.mbcad FA=FA RA=RA WR=WR TX=W/2-0.13 TW=0.22 spokes=5
