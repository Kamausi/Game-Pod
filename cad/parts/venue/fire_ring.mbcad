# Steel campfire ring with a few half-burnt logs on a bed of ash (campground).
# 0.9 m diameter, origin at ground centre.
material steel
color #2e2c2a
# Ring wall: outer face, rolled lip, inner face
lathe pts=0.45,0,0.45,0.27,0.47,0.29,0.42,0.30,0.42,0.02 seg=12
color #4a3426
box size=0.10,0.035,0.012 pos=0,0.13,0.452 mirror=z
box size=0.012,0.035,0.10 pos=0.452,0.13,0 mirror=x
# Ash bed and charcoal
material matte
color #2a2725
cyl r=0.42 h=0.05 pos=0,0.025,0 seg=12
color #4d4945
sphere r=0.16 pos=0.05,0.05,-0.03 scale=1.4,0.25,1.2 seg=8
# Logs leaning together, ends charred
color #6b4a2e
cyl r=0.05 h=0.62 axis=x pos=0.02,0.13,0.10 rot=0,18,12 seg=7
cyl r=0.045 h=0.58 axis=z pos=-0.10,0.12,0.0 rot=-14,10,0 seg=7
cyl r=0.05 h=0.60 axis=x pos=0.0,0.12,-0.12 rot=0,-28,-10 seg=7
color #1c1a18
cyl r=0.052 h=0.16 axis=x pos=0.05,0.17,0.11 rot=0,18,12 seg=7
cyl r=0.047 h=0.14 axis=z pos=-0.10,0.16,0.08 rot=-14,10,0 seg=7
# Glowing embers
material lens
color #c2410c
sphere r=0.10 pos=0.0,0.06,0.0 scale=1.3,0.35,1.1 seg=8
