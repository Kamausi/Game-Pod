# Small timber ticket booth on skids: painted board walls, sliding service window facing +Z,
# shed roof sloping to the back, little awning over the window, side door on +X.
param body_r = 0.62
param body_g = 0.16
param body_b = 0.12
param trim_r = 0.92
param trim_g = 0.90
param trim_b = 0.84
material matte
# Skids
color #4a3c2a
box size=0.14,0.14,2.4 pos=0.95,0.07,0 mirror=x
# Walls
material paint
color body_r body_g body_b
box size=2.2,2.25,2.2 pos=0,1.265,0
# Board battens (vertical) on front and sides
color body_r*0.8 body_g*0.8 body_b*0.8
box size=0.05,2.25,0.03 pos=0.55,1.265,1.11 mirror=x
box size=0.03,2.25,0.05 pos=1.11,1.265,-0.55 mirror=x
box size=0.03,2.25,0.05 pos=1.11,1.265,0.55 mirror=x
# Corner trim
color trim_r trim_g trim_b
box size=0.1,2.25,0.1 pos=1.08,1.265,1.08 mirror=x
box size=0.1,2.25,0.1 pos=1.08,1.265,-1.08 mirror=x
# Service window: frame, sliding glass panes (one open), counter shelf
box size=1.5,0.08,0.06 pos=0,2.03,1.12
box size=1.5,0.08,0.06 pos=0,1.07,1.12
box size=0.08,1.0,0.06 pos=0.75,1.55,1.12 mirror=x
material glass
color #24302e
box size=0.72,0.9,0.03 pos=-0.34,1.55,1.13
color #101414
box size=0.7,0.9,0.02 pos=0.36,1.55,1.105
material paint
color trim_r*0.85 trim_g*0.85 trim_b*0.85
box size=1.6,0.05,0.4 pos=0,1.08,1.3
box size=0.06,0.25,0.06 pos=0.6,0.94,1.22 rot=40,0,0 mirror=x
# Side door on +X with knob
color trim_r trim_g trim_b
box size=0.04,1.95,0.84 pos=1.12,1.12,-0.2
material chrome
color #c8c8c8
sphere r=0.035 pos=1.16,1.12,-0.52 seg=8
# Shed roof (higher at the front) with fascia
material steel
color #6d7378
box size=2.6,0.07,2.75 pos=0,2.55,0.05 rot=-6,0,0
material paint
color trim_r trim_g trim_b
box size=2.62,0.14,0.04 pos=0,2.64,1.44
# Awning over the window (striped)
color #e8e4da
box size=1.9,0.04,0.6 pos=0,2.2,1.38 rot=22,0,0
color body_r body_g body_b
box size=1.9,0.12,0.03 pos=0,2.05,1.66

# ---- Build-out: roof sign, queue lane, pennant string, sandwich board, counter details ----
# Sign board on posts above the front fascia
material steel
color #3a3a3a
box size=0.05,0.40,0.05 pos=0.75,2.85,1.38 mirror=x
material paint
color trim_r trim_g trim_b
box size=1.9,0.46,0.05 pos=0,3.12,1.40
color body_r body_g body_b
box size=1.82,0.38,0.06 pos=0,3.12,1.405
color #f6e9b8
text str=TICKETS size=0.26 t=0.065 depth=0.01 pos=0,3.12,1.44
# Lamp over the service window
material steel
color #2e2e2e
cyl r=0.012 h=0.30 axis=z pos=0,2.22,1.30 seg=6
cyl r=0.11 r2=0.03 h=0.10 pos=0,2.18,1.46 seg=10
material lens
color #ffe9b0
cyl r=0.09 h=0.01 pos=0,2.13,1.46 seg=10
# Counter: ticket roll and cash box
material paint
color #d84a2a
cyl r=0.06 h=0.05 axis=x pos=-0.45,1.14,1.32 seg=10
color #2a3a4a
box size=0.30,0.10,0.22 pos=0.45,1.155,1.30 bevel=0.01
# Queue lane: two rows of belt stanchions leading to the window
for k = 0, 3
  material steel
  color #c0c4c8
  cyl r=0.025 h=0.95 pos=-0.85,0.475,2.0+k*0.9 seg=8
  cyl r=0.025 h=0.95 pos=0.85,0.475,2.0+k*0.9 seg=8
  color #2a2a2a
  cyl r=0.16 h=0.03 pos=-0.85,0.015,2.0+k*0.9 seg=12
  cyl r=0.16 h=0.03 pos=0.85,0.015,2.0+k*0.9 seg=12
end
material matte
color #b81c18
box size=0.012,0.05,2.7 pos=-0.85,0.88,3.35
box size=0.012,0.05,2.7 pos=0.85,0.88,3.35
# Pennant string from the roof corner to a pole
material steel
color #8f959a
cyl r=0.03 h=3.4 pos=-1.3,1.7,3.0 seg=8
material matte
color #222222
box size=0.008,0.008,1.66 pos=-1.3,3.01,2.22 rot=-20.4,0,0
for k = 0, 5
  set f = (k+0.5)/6
  color 0.95*(1-mod(k,3)/2) 0.2+0.6*mod(k,2) 0.15+0.7*(mod(k,3)/2)
  extrude depth=0.004 pts=0.11,0,-0.11,0,0,-0.26 pos=-1.3,2.72+0.58*f,1.44+1.56*f
end
# Sandwich board in front of the lane
material paint
color #202326
box size=0.62,0.85,0.03 pos=1.6,0.42,2.45 rot=-14,0,0
box size=0.62,0.85,0.03 pos=1.6,0.42,2.05 rot=14,0,0
color #f2f2ee
text str=ADULT size=0.09 t=0.025 depth=0.006 pos=1.6,0.62,2.52 rot=-14,0,0
text str=10 size=0.20 t=0.05 depth=0.006 pos=1.6,0.36,2.47 rot=-14,0,0
# Gutter along the low back edge of the roof and a side window on -X
material steel
color #6d7378
box size=2.62,0.10,0.10 pos=0,2.36,-1.34
material paint
color trim_r trim_g trim_b
box size=0.05,0.62,0.72 pos=-1.12,1.65,0.0
material glass
color #24302e
box size=0.06,0.52,0.62 pos=-1.125,1.65,0.0
