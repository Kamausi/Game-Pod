# Generic metal-sided utility building (post-frame / steel shed): ribbed wall panels, gable
# roof with the ridge running front-to-back, roll-up door + walk door + window on the +Z
# gable end. Recoloured for pro shop, bathhouse, maintenance shed, concession, first aid.
# w = width (X), l = depth (Z), h = eave height. Origin at ground centre of the footprint.
param w = 10
param l = 8
param h = 3.6
param wall_r = 0.78
param wall_g = 0.76
param wall_b = 0.70
param roof_r = 0.55
param roof_g = 0.12
param roof_b = 0.10
param trim_r = 0.93
param trim_g = 0.93
param trim_b = 0.90
set rise = w*0.125
set dw = min(3.6,w*0.38)
set dh = min(3.0,h-0.55)
set dx = -w*0.2
set wx = w*0.12
set gx = w*0.3
# Slab and door apron
material matte
color #a29e96
box size=w+0.3,0.1,l+0.3 pos=0,0.05,0
box size=dw+0.8,0.06,1.4 pos=dx,0.03,l/2+0.85
# Walls and gable ends
material paint
color wall_r wall_g wall_b
box size=w,h,l pos=0,h/2,0
extrude depth=l rot=0,90,0 pts=w/2,h-0.01,0,h+rise,-w/2,h-0.01
# Panel ribs: sides (+-X) and ends (+-Z)
color wall_r*0.86 wall_g*0.86 wall_b*0.86
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*-4/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*-3/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*-2/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*-1/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*0/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*1/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*2/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*3/10 mirror=x
box size=0.03,h-0.25,0.05 pos=w/2+0.015,h/2+0.08,l*4/10 mirror=x
box size=0.05,h-0.25,0.03 pos=w*-5/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*-4/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*-3/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*-2/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*-1/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*0/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*1/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*2/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*3/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*4/12,h/2+0.08,l/2+0.015 mirror=z
box size=0.05,h-0.25,0.03 pos=w*5/12,h/2+0.08,l/2+0.015 mirror=z
# Roof shell (thin gable) and ridge cap
color roof_r roof_g roof_b
extrude depth=l+0.4 rot=0,90,0 pts=w/2+0.3,h-0.12,w/2+0.3,h-0.02,0,h+rise+0.13,-w/2-0.3,h-0.02,-w/2-0.3,h-0.12,0,h+rise+0.01
color roof_r*0.8 roof_g*0.8 roof_b*0.8
box size=0.5,0.06,l+0.45 pos=0,h+rise+0.13,0
# Trim: corners, base, eave/gable fascia
color trim_r trim_g trim_b
box size=0.12,h,0.12 pos=w/2,h/2,l/2 mirror=x
box size=0.12,h,0.12 pos=w/2,h/2,-l/2 mirror=x
box size=w+0.04,0.12,l+0.04 pos=0,0.16,0
box size=0.1,0.18,l+0.4 pos=w/2+0.32,h-0.08,0 mirror=x
# Roll-up door with frame, slats and header box
box size=dw+0.24,dh+0.14,0.06 pos=dx,(dh+0.14)/2,l/2+0.03
color trim_r*0.92 trim_g*0.92 trim_b*0.92
box size=dw,dh,0.08 pos=dx,dh/2,l/2+0.05
color trim_r*0.7 trim_g*0.7 trim_b*0.7
box size=dw,0.03,0.09 pos=dx,dh*0.25,l/2+0.06
box size=dw,0.03,0.09 pos=dx,dh*0.5,l/2+0.06
box size=dw,0.03,0.09 pos=dx,dh*0.75,l/2+0.06
box size=dw*0.3,0.06,0.1 pos=dx,0.35,l/2+0.07
color trim_r trim_g trim_b
box size=dw+0.3,0.3,0.25 pos=dx,dh+0.28,l/2+0.12
# Walk door with frame, handle, stoop
box size=1.1,2.2,0.06 pos=wx,1.1,l/2+0.03
color wall_r*0.6 wall_g*0.6 wall_b*0.6
box size=0.92,2.08,0.08 pos=wx,1.06,l/2+0.05
material chrome
color #c8c8c8
sphere r=0.04 pos=wx+0.35,1.05,l/2+0.11 seg=8
material matte
color #a29e96
box size=1.3,0.14,0.9 pos=wx,0.07,l/2+0.45
# Window with frame
material paint
color trim_r trim_g trim_b
box size=1.1,0.9,0.06 pos=gx,1.65,l/2+0.03
material glass
color #24303a
box size=0.95,0.75,0.08 pos=gx,1.65,l/2+0.04
# Side window, outdoor light over the walk door, gable vent
material paint
color trim_r trim_g trim_b
box size=0.06,0.9,1.1 pos=w/2+0.03,1.65,l*0.15
material glass
color #24303a
box size=0.08,0.75,0.95 pos=w/2+0.04,1.65,l*0.15
material lens
color #ffe9b0
box size=0.2,0.12,0.12 pos=wx,2.45,l/2+0.08
material plastic
color trim_r*0.8 trim_g*0.8 trim_b*0.8
box size=0.7,0.45,0.05 pos=0,h+rise*0.45,l/2+0.03
