box size=0.305,0.110,0.03 pos=s*0.900,-0.287+post_h,s*-3.18 rot=0,0,s*39.8
box size=0.810,0.110,0.03 pos=s*1.200,0.000+post_h,s*-3.18 rot=0,0,s*90.0
