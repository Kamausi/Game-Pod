# Outdoor concert stage: 10 m (X) x 7 m deck at 1.2 m on a scaffold base with a black front
# skirt, four box-truss towers carrying a roof grid and a shallow arched roof, black back
# scrim, ground-stacked PA on both sides, par cans on the front truss, rear access stair.
# Front (audience side) faces +Z. Origin at ground centre of the deck footprint.
param roof_r = 0.12
param roof_g = 0.12
param roof_b = 0.13
param skirt_r = 0.08
param skirt_g = 0.08
param skirt_b = 0.09
set dh = 1.2
set tx = 5.3
set tz = 3.3
set th = 6.6
# Deck base (scaffold block), deck surface and nosing
material matte
color #3a3a3a
box size=10,dh-0.08,7 pos=0,(dh-0.08)/2,0
color #4a3f33
box size=10,0.08,7 pos=0,dh-0.04,0
material steel
color #6a6f75
box size=10.04,0.06,0.06 pos=0,dh-0.03,3.52
# Front and side skirts
material matte
color skirt_r skirt_g skirt_b
box size=10.06,dh-0.1,0.04 pos=0,(dh-0.1)/2,3.52
box size=0.04,dh-0.1,7.02 pos=5.02,(dh-0.1)/2,0 mirror=x
# Truss towers (four chords each) with base plates
material steel
color #b9bec4
box size=0.6,0.04,0.6 pos=tx,0.02,tz mirror=x
box size=0.6,0.04,0.6 pos=tx,0.02,-tz mirror=x
cyl r=0.025 h=th pos=tx-0.15,th/2,tz-0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx+0.15,th/2,tz-0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx-0.15,th/2,tz+0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx+0.15,th/2,tz+0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx-0.15,th/2,-tz-0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx+0.15,th/2,-tz-0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx-0.15,th/2,-tz+0.15 seg=6 mirror=x
cyl r=0.025 h=th pos=tx+0.15,th/2,-tz+0.15 seg=6 mirror=x
# Tower lacing suggested by rungs
box size=0.32,0.03,0.32 pos=tx,1.5,tz mirror=x
box size=0.32,0.03,0.32 pos=tx,3.0,tz mirror=x
box size=0.32,0.03,0.32 pos=tx,4.5,tz mirror=x
box size=0.32,0.03,0.32 pos=tx,1.5,-tz mirror=x
box size=0.32,0.03,0.32 pos=tx,3.0,-tz mirror=x
box size=0.32,0.03,0.32 pos=tx,4.5,-tz mirror=x
# Roof grid: front/back trusses along X, side trusses along Z (top + bottom chords)
box size=2*tx+0.3,0.05,0.3 pos=0,th,tz mirror=z
box size=2*tx+0.3,0.05,0.3 pos=0,th-0.35,tz mirror=z
box size=0.3,0.05,2*tz pos=tx,th,0 mirror=x
box size=0.3,0.05,2*tz pos=tx,th-0.35,0 mirror=x
box size=0.04,0.35,0.04 pos=2.6,th-0.17,tz+0.15 mirror=x
box size=0.04,0.35,0.04 pos=0,th-0.17,tz+0.15
# Arched roof
material matte
color roof_r roof_g roof_b
extrude depth=2*tx+0.8 pos=0,0,0 pts=3.9,th+0.05,0,th+0.75,-3.9,th+0.05,-3.9,th-0.03,0,th+0.67,3.9,th-0.03
# Back scrim and side wing scrims
color #141414
box size=2*tx-0.3,th-dh-0.4,0.04 pos=0,dh+(th-dh-0.4)/2,-tz
box size=0.04,th-dh-0.6,2.2 pos=tx-0.2,dh+(th-dh-0.6)/2,-tz+1.1 mirror=x
# Par cans on the front truss
color #1c1c1c
cyl r=0.1 h=0.28 axis=z pos=1.0,th-0.55,tz+0.05 seg=8 mirror=x
cyl r=0.1 h=0.28 axis=z pos=2.6,th-0.55,tz+0.05 seg=8 mirror=x
cyl r=0.1 h=0.28 axis=z pos=4.2,th-0.55,tz+0.05 seg=8 mirror=x
material lens
color #ffd9a0
cyl r=0.085 h=0.02 axis=z pos=1.0,th-0.55,tz+0.19 seg=8 mirror=x
color #9fd0ff
cyl r=0.085 h=0.02 axis=z pos=2.6,th-0.55,tz+0.19 seg=8 mirror=x
color #ff9a7a
cyl r=0.085 h=0.02 axis=z pos=4.2,th-0.55,tz+0.19 seg=8 mirror=x
# Ground-stacked PA, both sides (subs, tops, grilles)
material plastic
color #1a1a1a
box size=1.0,0.7,0.85 pos=6.2,0.35,2.6 mirror=x
box size=1.0,0.7,0.85 pos=6.2,1.05,2.6 mirror=x
box size=0.8,0.55,0.65 pos=6.2,1.68,2.65 mirror=x
box size=0.8,0.55,0.65 pos=6.2,2.23,2.65 mirror=x
material matte
color #2b2b2b
box size=0.9,0.6,0.02 pos=6.2,0.35,3.03 mirror=x
box size=0.9,0.6,0.02 pos=6.2,1.05,3.03 mirror=x
box size=0.7,1.0,0.02 pos=6.2,1.95,2.98 mirror=x
# Monitor wedges at the deck front
material plastic
color #1a1a1a
wedge size=0.6,0.35,0.5 pos=1.2,dh+0.175,2.9 rot=0,180,0 mirror=x
# Rear access stair (down toward -Z) with handrails
material steel
color #6a6f75
box size=1.2,0.06,0.3 pos=0,0.96,-3.72
box size=1.2,0.06,0.3 pos=0,0.72,-4.0
box size=1.2,0.06,0.3 pos=0,0.48,-4.28
box size=1.2,0.06,0.3 pos=0,0.24,-4.56
box size=0.06,0.25,1.72 pos=0.63,0.7,-4.1 rot=-42,0,0 mirror=x
box size=0.04,0.04,1.72 pos=0.65,1.6,-4.1 rot=-42,0,0 mirror=x
box size=0.04,0.95,0.04 pos=0.65,0.75,-4.72 mirror=x
# ---- Backline and band gear ----
# Drum riser and kit: kick, snare, toms, floor tom, cymbals on stands, throne
material matte
color #1a1a1a
box size=2.4,0.30,2.0 pos=0,dh+0.15,-1.8
color #b01818
material paint
cyl r=0.28 h=0.40 axis=z pos=0,dh+0.58,-1.20 seg=16
color #f2f2ee
material matte
cyl r=0.27 h=0.01 axis=z pos=0,dh+0.58,-0.995 seg=16
color #b01818
material paint
cyl r=0.12 h=0.14 pos=-0.18,dh+0.95,-1.25 seg=12
cyl r=0.12 h=0.14 pos=0.18,dh+0.95,-1.25 seg=12
cyl r=0.17 h=0.38 pos=0.55,dh+0.49,-1.30 seg=12
color #d8d8d2
material chrome
cyl r=0.17 h=0.06 pos=-0.48,dh+0.75,-1.05 seg=12
for c = -1, 1, 2
  cyl r=0.012 h=1.0 pos=c*0.70,dh+0.80,-1.40 seg=5
end
color #c9a43a
material steel
cyl r=0.24 h=0.01 pos=-0.70,dh+1.30,-1.40 rot=0,0,10 seg=14
cyl r=0.22 h=0.01 pos=0.70,dh+1.30,-1.40 rot=0,0,-10 seg=14
cyl r=0.17 h=0.01 pos=-0.48,dh+0.95,-1.00 seg=12
color #111111
material rubber
cyl r=0.17 h=0.08 pos=0,dh+0.62,-2.05 seg=10
# Amp stacks and bass cab on the deck
material plastic
color #161616
box size=0.80,1.30,0.40 pos=-2.6,dh+0.65,-2.4 bevel=0.02
box size=0.80,0.35,0.40 pos=-2.6,dh+1.48,-2.4 bevel=0.02
box size=0.80,1.30,0.40 pos=2.6,dh+0.65,-2.4 bevel=0.02
box size=0.80,0.35,0.40 pos=2.6,dh+1.48,-2.4 bevel=0.02
color #3a3a3a
material matte
box size=0.70,1.15,0.01 pos=-2.6,dh+0.65,-2.195
box size=0.70,1.15,0.01 pos=2.6,dh+0.65,-2.195
color #c9a43a
material steel
box size=0.66,0.06,0.01 pos=-2.6,dh+1.52,-2.195
box size=0.66,0.06,0.01 pos=2.6,dh+1.52,-2.195
# Mic stands down front (three) and a keyboard on an X-stand
color #2a2a2a
material steel
for m = -1, 1
  cyl r=0.012 h=1.45 pos=m*2.2,dh+0.72,1.9 seg=5
  cyl r=0.15 h=0.02 pos=m*2.2,dh+0.01,1.9 seg=8
  cyl r=0.008 h=0.30 pos=m*2.2,dh+1.48,1.98 rot=60,0,0 seg=5
end
color #111111
material plastic
for m = -1, 1
  sphere r=0.03 pos=m*2.2,dh+1.55,2.10 scale=1,1,1.6 seg=6
end
color #2a2a2a
material steel
box size=0.04,0.85,0.04 pos=-3.4,dh+0.40,-0.6 rot=0,0,30
box size=0.04,0.85,0.04 pos=-3.4,dh+0.40,-0.6 rot=0,0,-30
color #151515
material plastic
box size=1.20,0.10,0.35 pos=-3.4,dh+0.80,-0.6 bevel=0.01
color #f2f2ee
material matte
box size=1.05,0.012,0.14 pos=-3.4,dh+0.856,-0.52
# Backdrop lettering on the scrim
color #e8b020
material matte
set s = 1
set post_h = dh+3.1
box size=0.810,0.110,0.03 pos=s*-3.875,0.000+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.810,0.110,0.03 pos=s*-3.375,0.000+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.540,0.110,0.03 pos=s*-3.750,0.175+post_h,s*-3.18 rot=0,0,s*-54.5
box size=0.540,0.110,0.03 pos=s*-3.500,0.175+post_h,s*-3.18 rot=0,0,s*-125.5
box size=0.760,0.110,0.03 pos=s*-3.150,0.025+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.760,0.110,0.03 pos=s*-2.650,0.025+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.610,0.110,0.03 pos=s*-2.900,-0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.810,0.110,0.03 pos=s*-2.425,0.000+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.460,0.110,0.03 pos=s*-2.250,0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.460,0.110,0.03 pos=s*-2.250,-0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.560,0.110,0.03 pos=s*-1.925,0.000+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.305,0.110,0.03 pos=s*-2.000,0.287+post_h,s*-3.18 rot=0,0,s*-39.8
box size=0.305,0.110,0.03 pos=s*-2.000,-0.287+post_h,s*-3.18 rot=0,0,s*39.8
box size=0.810,0.110,0.03 pos=s*-0.975,0.000+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.510,0.110,0.03 pos=s*-0.775,0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.510,0.110,0.03 pos=s*-0.775,0.000+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.535,0.110,0.03 pos=s*-0.763,-0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.360,0.110,0.03 pos=s*-0.500,0.175+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.360,0.110,0.03 pos=s*-0.475,-0.175+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.760,0.110,0.03 pos=s*-0.250,0.025+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.760,0.110,0.03 pos=s*0.250,0.025+post_h,s*-3.18 rot=0,0,s*90.0
box size=0.610,0.110,0.03 pos=s*0.000,-0.350+post_h,s*-3.18 rot=0,0,s*0.0
box size=0.810,0.110,0.03 pos=s*0.475,0.000+post_h,s*-3.18 rot=0,0,s*90.0
