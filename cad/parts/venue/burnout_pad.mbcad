# Burnout pad: a 14 x 8 m concrete slab with painted boundary lines and old rubber
# streaks, flush with the ground (top 4 cm). Long axis along X. Origin at ground centre.
color #8e8b85
material matte
box size=14,0.04,8 pos=0,0.02,0
# Painted boundary and centre spot
color #e8e4d8
box size=14,0.005,0.12 pos=0,0.042,3.9
box size=14,0.005,0.12 pos=0,0.042,-3.9
box size=0.12,0.005,8 pos=6.95,0.042,0
box size=0.12,0.005,8 pos=-6.95,0.042,0
cyl r=0.9 h=0.005 pos=0,0.042,0 seg=24
color #8e8b85
cyl r=0.78 h=0.006 pos=0,0.043,0 seg=24
# Rubber laid down by earlier burnouts
color #1e1d1c
box size=4.5,0.003,0.32 pos=-0.8,0.0445,0.80 rot=0,6,0
box size=4.5,0.003,0.32 pos=-0.8,0.0445,-0.80 rot=0,6,0
box size=3.0,0.003,0.30 pos=1.6,0.0445,1.2 rot=0,-14,0
box size=3.0,0.003,0.30 pos=1.6,0.0445,-0.4 rot=0,-14,0
cyl r=1.6 h=0.003 pos=-2.8,0.0446,0.2 seg=20
color #8e8b85
cyl r=1.3 h=0.0035 pos=-2.8,0.0447,0.2 seg=20
