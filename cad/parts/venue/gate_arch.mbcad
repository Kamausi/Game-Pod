# Venue entrance gate: two squared timber posts carrying a crossbeam and a big sponsor
# banner panel, with tube-steel farm gates swung fully open (folded back toward -Z).
# Origin at ground centre of the drive lane; visitors drive through along Z, front = +Z.
param banner_r = 0.95
param banner_g = 0.48
param banner_b = 0.08
param span = 9
param post_h = 5.5
set px = span/2
material matte
# Concrete footings
color #8e8a82
box size=0.6,0.12,0.6 pos=px,0.06,0 mirror=x
# Posts (weathered timber), caps
color #6e5638
box size=0.32,post_h,0.32 pos=px,post_h/2,0 mirror=x
color #4a3a26
box size=0.38,0.08,0.38 pos=px,post_h+0.04,0 mirror=x
# Crossbeams (top and lower banner rail)
color #735a3a
box size=span+0.9,0.3,0.26 pos=0,post_h-0.3,0
box size=span-0.32,0.2,0.2 pos=0,post_h-2.25,0
# Knee braces
box size=1.3,0.14,0.14 pos=px-0.55,post_h-0.85,0 rot=0,0,45
box size=1.3,0.14,0.14 pos=-px+0.55,post_h-0.85,0 rot=0,0,-45
# Banner panel (both faces) with a dark border and a white sponsor stripe
material paint
color #1b1b1b
box size=span-1.0,1.66,0.05 pos=0,post_h-1.3,0.14
box size=span-1.0,1.66,0.05 pos=0,post_h-1.3,-0.14
color banner_r banner_g banner_b
box size=span-1.2,1.48,0.06 pos=0,post_h-1.3,0.15
box size=span-1.2,1.48,0.06 pos=0,post_h-1.3,-0.15
color #f2f0ea
box size=span-1.2,0.16,0.07 pos=0,post_h-1.72,0.15
box size=span-1.2,0.16,0.07 pos=0,post_h-1.72,-0.15
# Lettering on both faces (s = -1 is the back face, mirrored so it reads from behind)
color #161616
for s = -1, 1, 2
  box size=0.594,0.090,0.03 pos=s*-2.790,-1.000+post_h,s*0.19 rot=0,0,s*90.0
  box size=0.594,0.090,0.03 pos=s*-2.430,-1.000+post_h,s*0.19 rot=0,0,s*90.0
  box size=0.400,0.090,0.03 pos=s*-2.700,-0.874+post_h,s*0.19 rot=0,0,s*-54.5
