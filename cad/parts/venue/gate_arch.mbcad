# Gate tie-back stakes
color #3a3a3a
cyl r=0.03 h=0.9 pos=px-0.45,0.45,-4.2 seg=8 mirror=x
# Pennant flags on the post tops
color #6c6c6c
material steel
cyl r=0.02 h=1.4 pos=px,post_h+0.75,0 seg=6 mirror=x
color banner_r banner_g banner_b
material matte
extrude depth=0.01 pts=0,0,0.9,-0.18,0,-0.36 rot=0,90,0 pos=px,post_h+1.40,0 mirror=x
