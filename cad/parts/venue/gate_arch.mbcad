# Venue entrance gate: two squared timber posts carrying a crossbeam and a big sponsor
# banner panel, with tube-steel farm gates swung fully open (folded back toward -Z).
# Origin at ground centre of the drive lane; visitors drive through along Z, front = +Z.
param banner_r = 0.95
param banner_g = 0.48
param banner_b = 0.08
param span = 9
param post_h = 5.5
set px = span/2
material matte
# Concrete footings
color #8e8a82
box size=0.6,0.12,0.6 pos=px,0.06,0 mirror=x
# Posts (weathered timber), caps
color #6e5638
box size=0.32,post_h,0.32 pos=px,post_h/2,0 mirror=x
color #4a3a26
box size=0.38,0.08,0.38 pos=px,post_h+0.04,0 mirror=x
# Crossbeams (top and lower banner rail)
color #735a3a
box size=span+0.9,0.3,0.26 pos=0,post_h-0.3,0
box size=span-0.32,0.2,0.2 pos=0,post_h-2.25,0
# Knee braces
box size=1.3,0.14,0.14 pos=px-0.55,post_h-0.85,0 rot=0,0,45
box size=1.3,0.14,0.14 pos=-px+0.55,post_h-0.85,0 rot=0,0,-45
# Banner panel (both faces) with a dark border and a white sponsor stripe
material paint
color #1b1b1b
box size=span-1.0,1.66,0.05 pos=0,post_h-1.3,0.14
box size=span-1.0,1.66,0.05 pos=0,post_h-1.3,-0.14
color banner_r banner_g banner_b
box size=span-1.2,1.48,0.06 pos=0,post_h-1.3,0.15
box size=span-1.2,1.48,0.06 pos=0,post_h-1.3,-0.15
color #f2f0ea
box size=span-1.2,0.16,0.07 pos=0,post_h-1.72,0.15
box size=span-1.2,0.16,0.07 pos=0,post_h-1.72,-0.15
color #1b1b1b
box size=2.2,0.5,0.07 pos=0,post_h-1.18,0.155
box size=2.2,0.5,0.07 pos=0,post_h-1.18,-0.155
# Gate hinges and open gate leaves (galvanised tube, 4 m long, along -Z)
material steel
color #555555
box size=0.06,0.1,0.12 pos=px-0.19,0.5,-0.18 mirror=x
box size=0.06,0.1,0.12 pos=px-0.19,1.3,-0.18 mirror=x
color #a9adb0
box size=0.06,1.25,0.06 pos=px-0.24,0.85,-0.22 mirror=x
box size=0.06,1.25,0.06 pos=px-0.24,0.85,-4.2 mirror=x
box size=0.05,0.05,4.0 pos=px-0.24,0.30,-2.21 mirror=x
box size=0.05,0.05,4.0 pos=px-0.24,0.55,-2.21 mirror=x
box size=0.05,0.05,4.0 pos=px-0.24,0.80,-2.21 mirror=x
box size=0.05,0.05,4.0 pos=px-0.24,1.05,-2.21 mirror=x
box size=0.05,0.05,4.0 pos=px-0.24,1.43,-2.21 mirror=x
box size=0.04,0.04,4.1 pos=px-0.24,0.86,-2.21 rot=16,0,0 mirror=x
# Gate tie-back stakes
color #3a3a3a
cyl r=0.03 h=0.9 pos=px-0.45,0.45,-4.2 seg=8 mirror=x
