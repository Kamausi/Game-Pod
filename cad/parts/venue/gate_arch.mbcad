# Gooseneck lamps over the banner, both faces
color #2a2a2a
material steel
for s = -1, 1, 2
  for k = -1, 1
    cyl r=0.02 h=0.45 pos=k*2.6,post_h-0.25,s*0.30 rot=s*60,0,0 seg=6
    cyl r=0.10 r2=0.05 h=0.12 pos=k*2.6,post_h-0.35,s*0.48 seg=10
  end
end
color #fff4d6
material lens
for s = -1, 1, 2
  for k = -1, 1
    cyl r=0.08 h=0.02 pos=k*2.6,post_h-0.42,s*0.48 seg=10
  end
end
material paint
# Gate hinges and open gate leaves (galvanised tube, 4 m long, along -Z)
material steel
color #555555
box size=0.06,0.1,0.12 pos=px-0.19,0.5,-0.18 mirror=x
box size=0.06,0.1,0.12 pos=px-0.19,1.3,-0.18 mirror=x
