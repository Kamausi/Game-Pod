# Front-load steel dumpster with two plastic lids, side fork pockets and skids.
# ~1.8 x 1.2 x 1.3 m, long axis X, sloped front faces +Z. Origin at ground centre.
param body_r = 0.10
param body_g = 0.33
param body_b = 0.17
# Skids
material steel
color #2b2b2b
box size=1.70,0.10,0.10 pos=0,0.05,0.42 mirror=z
# Body: side profile (z,y) with a sloped lower front, extruded across X
material paint
color body_r body_g body_b
extrude pts=-0.60,0.10,0.40,0.10,0.60,0.55,0.60,1.20,-0.60,1.20 depth=1.80 bevel=0.02
# Top rim lip and vertical stiffening ribs
color body_r*0.8 body_g*0.8 body_b*0.8
box size=1.86,0.06,1.26 pos=0,1.19,0
box size=0.06,1.0,0.03 pos=0.45,0.70,-0.61 mirror=x
box size=0.06,0.64,0.03 pos=0.45,0.88,0.61 mirror=x
box size=0.03,1.0,0.06 pos=0.91,0.70,0.3 mirror=x
box size=0.03,1.0,0.06 pos=0.91,0.70,-0.3 mirror=x
# Fork pockets on both sides
material steel
color #3a3a3a
box size=0.10,0.12,1.10 pos=0.94,0.80,0 mirror=x
# Lids, hinged at the back, closed
material plastic
color #1d1f1d
box size=0.90,0.05,1.26 pos=0.455,1.245,0.0 rot=4,0,0 bevel=0.015 mirror=x
color #141414
box size=0.86,0.02,0.04 pos=0.455,1.235,0.635 mirror=x
material steel
color #555555
cyl r=0.025 h=1.84 axis=x pos=0,1.24,-0.64 seg=8
