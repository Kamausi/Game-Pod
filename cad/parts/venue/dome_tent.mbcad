# Two-pole camping dome tent: coloured inner body, darker rain fly over the top,
# zippered door on +Z. ~2.4 x 2.1 m, 1.3 m tall, origin at ground centre.
param color_r = 0.20
param color_g = 0.55
param color_b = 0.30
material matte
# Groundsheet
color #2b2b2b
box size=2.44,0.02,2.14 pos=0,0.01,0
# Inner body: half-ellipsoid
color color_r color_g color_b
lathe pts=1,0,0.966,0.259,0.866,0.5,0.707,0.707,0.5,0.866,0.259,0.966,0,1 seg=12 scale=1.2,1.3,1.05
# Rain fly: darker cap over the upper body
color color_r*0.55 color_g*0.55 color_b*0.55
lathe pts=0.90,0.40,0.866,0.5,0.707,0.707,0.5,0.866,0.259,0.966,0,1 seg=12 scale=1.215,1.32,1.065
# Pole sleeves crossing over the top
color #1f1f1f
lathe pts=0.025,1.005,0,1.01 seg=6 scale=1.2,1.3,1.05
box size=2.3,0.02,0.04 pos=0,1.305,0
box size=0.04,0.02,2.0 pos=0,1.305,0
# Door on +Z: three tilted panels following the dome curve, zip line up the middle
color color_r*0.4 color_g*0.4 color_b*0.4
box size=0.72,0.32,0.01 pos=0,0.158,1.048 rot=-5.7,0,0
box size=0.60,0.31,0.01 pos=0,0.465,0.988 rot=-17.2,0,0
box size=0.40,0.30,0.01 pos=0,0.745,0.868 rot=-29.5,0,0
color #d9d9d9
box size=0.015,0.32,0.014 pos=0,0.158,1.050 rot=-5.7,0,0
box size=0.015,0.31,0.014 pos=0,0.465,0.990 rot=-17.2,0,0
# Corner stakes and guy points
material steel
color #a0a0a0
box size=0.02,0.10,0.02 pos=1.24,0.05,0.9 mirror=x
box size=0.02,0.10,0.02 pos=1.24,0.05,-0.9 mirror=x
# Fly vestibule over the door: a sloped awning flap staked out in front
material matte
color color_r*0.5 color_g*0.5 color_b*0.5
extrude depth=0.95 pts=0.95,1.02,1.55,0.05,1.60,0.05,1.00,1.06
# Mesh side windows (dark, with a lighter frame)
color color_r*0.75 color_g*0.75 color_b*0.75
box size=0.012,0.36,0.62 pos=1.13,0.58,0 rot=0,0,-22 mirror=x
color #1c2024
box size=0.014,0.30,0.54 pos=1.135,0.58,0 rot=0,0,-22 mirror=x
# The two crossing pole arcs, visible as dark ribs over the fly
color #262626
for k = 0, 8
  set a = k*22.5
  box size=0.025,0.025,0.30 pos=1.2*0.707*cos(a),1.32*sin(a),1.05*0.707*cos(a) rot=0,45,90-a
  box size=0.025,0.025,0.30 pos=-1.2*0.707*cos(a),1.32*sin(a),1.05*0.707*cos(a) rot=0,-45,a-90
end
# Guy lines from the fly corners out to stakes
color #e8e2c8
cyl r=0.006 h=0.95 pos=1.55,0.40,0.80 rot=-30,0,-55 seg=4 mirror=x
cyl r=0.006 h=0.95 pos=1.55,0.40,-0.80 rot=30,0,-55 seg=4 mirror=x
color #a0a0a0
material steel
box size=0.02,0.12,0.02 pos=1.90,0.05,1.0 mirror=x
box size=0.02,0.12,0.02 pos=1.90,0.05,-1.0 mirror=x
box size=0.02,0.12,0.02 pos=0,0.05,1.62
# Doormat
color #5a4a3a
material matte
box size=0.70,0.01,0.45 pos=0,0.012,1.30
