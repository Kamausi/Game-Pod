# Portable diesel light tower: small single-axle trailer with generator housing, four
# outrigger legs with jack pads, telescoping mast (raised, ~7 m) and a crossbar of four
# lamp heads aimed toward +Z. Origin at ground centre of the trailer.
param body_r = 0.92
param body_g = 0.72
param body_b = 0.10
set mh = 7.2
# Trailer frame, axle, wheels, tongue
material steel
color #2a2a2a
box size=2.5,0.12,1.2 pos=0,0.55,0
box size=0.08,0.08,1.6 pos=0,0.33,0
box size=1.1,0.08,0.08 pos=-1.75,0.52,0.2 rot=0,-12,0
box size=1.1,0.08,0.08 pos=-1.75,0.52,-0.2 rot=0,12,0
box size=0.2,0.08,0.12 pos=-2.3,0.52,0
cyl r=0.035 h=0.5 pos=-2.0,0.27,0 seg=8
material rubber
color #161616
cyl r=0.3 h=0.18 axis=z pos=0,0.3,0.78 seg=12 mirror=z
material steel
color #9a9a9a
cyl r=0.15 h=0.19 axis=z pos=0,0.3,0.78 seg=8 mirror=z
# Generator housing (painted) with louvres and fuel cap
material paint
color body_r body_g body_b
box size=2.2,1.15,1.1 pos=0,1.18,0 bevel=0.03
color body_r*0.7 body_g*0.7 body_b*0.7
box size=0.9,0.04,0.02 pos=-0.5,1.35,0.56
box size=0.9,0.04,0.02 pos=-0.5,1.25,0.56
box size=0.9,0.04,0.02 pos=-0.5,1.15,0.56
box size=0.9,0.04,0.02 pos=-0.5,1.35,-0.56
box size=0.9,0.04,0.02 pos=-0.5,1.25,-0.56
box size=0.9,0.04,0.02 pos=-0.5,1.15,-0.56
material steel
color #3a3a3a
cyl r=0.04 h=0.25 pos=0.7,1.85,-0.3 seg=8
# Outriggers (swung out) with screw jacks and pads
color #c9a414
box size=0.1,0.1,1.2 pos=0.95,0.55,1.15 rot=0,25,0 mirror=x
box size=0.1,0.1,1.2 pos=0.95,0.55,-1.15 rot=0,-25,0 mirror=x
color #3a3a3a
cyl r=0.035 h=0.55 pos=1.2,0.28,1.68 seg=8 mirror=x
cyl r=0.035 h=0.55 pos=1.2,0.28,-1.68 seg=8 mirror=x
box size=0.22,0.03,0.22 pos=1.2,0.015,1.68 mirror=x
box size=0.22,0.03,0.22 pos=1.2,0.015,-1.68 mirror=x
# Telescoping mast (three stages) and cable
material steel
color #b8bcc0
box size=0.2,2.6,0.2 pos=0.7,2.3,0
box size=0.16,2.4,0.16 pos=0.7,4.6,0
box size=0.12,1.7,0.12 pos=0.7,6.45,0
color #222222
cyl r=0.012 h=mh-1.8 pos=0.82,(mh+1.8)/2,0 seg=6
# Crossbar and four lamp heads aimed slightly down toward +Z
color #9aa0a6
box size=1.9,0.08,0.08 pos=0.7,mh,0
box size=1.9,0.08,0.08 pos=0.7,mh-0.6,0
box size=0.08,0.68,0.08 pos=0.7,mh-0.3,0
material paint
color #303336
box size=0.42,0.42,0.18 pos=0.7+0.47,mh+0.08,0.1 rot=15,0,0
box size=0.42,0.42,0.18 pos=0.7-0.47,mh+0.08,0.1 rot=15,0,0
box size=0.42,0.42,0.18 pos=0.7+0.47,mh-0.68,0.1 rot=15,0,0
box size=0.42,0.42,0.18 pos=0.7-0.47,mh-0.68,0.1 rot=15,0,0
material lens
color #fff3d6
box size=0.36,0.36,0.03 pos=0.7+0.47,mh+0.06,0.2 rot=15,0,0
box size=0.36,0.36,0.03 pos=0.7-0.47,mh+0.06,0.2 rot=15,0,0
box size=0.36,0.36,0.03 pos=0.7+0.47,mh-0.70,0.2 rot=15,0,0
box size=0.36,0.36,0.03 pos=0.7-0.47,mh-0.70,0.2 rot=15,0,0
