# Open-sided picnic pavilion: concrete slab, squared timber posts and beams, ribbed metal
# gable roof (ridge along X), six picnic tables underneath. 12 m (X) x 8 m (Z).
param roof_r = 0.13
param roof_g = 0.30
param roof_b = 0.18
set eh = 3.0
# Slab
material matte
color #a19d95
box size=12.6,0.12,8.6 pos=0,0.06,0
# Posts (two rows of four)
color #7a5e3c
box size=0.2,eh,0.2 pos=5.8,eh/2,3.8 mirror=x
box size=0.2,eh,0.2 pos=1.93,eh/2,3.8 mirror=x
box size=0.2,eh,0.2 pos=5.8,eh/2,-3.8 mirror=x
box size=0.2,eh,0.2 pos=1.93,eh/2,-3.8 mirror=x
# Eave beams and tie beams
color #6e5434
box size=12.3,0.3,0.2 pos=0,eh+0.05,3.8
box size=12.3,0.3,0.2 pos=0,eh+0.05,-3.8
box size=0.16,0.2,7.8 pos=5.8,eh+0.1,0 mirror=x
box size=0.16,0.2,7.8 pos=1.93,eh+0.1,0 mirror=x
# King posts and ridge beam
box size=0.14,1.3,0.14 pos=5.8,eh+0.85,0 mirror=x
box size=0.14,1.3,0.14 pos=1.93,eh+0.85,0 mirror=x
box size=12.3,0.22,0.14 pos=0,eh+1.45,0
# Rafters suggested by struts on each frame
box size=0.12,0.14,4.4 pos=5.8,eh+0.78,1.95 rot=18.4,0,0 mirror=x
box size=0.12,0.14,4.4 pos=5.8,eh+0.78,-1.95 rot=-18.4,0,0 mirror=x
box size=0.12,0.14,4.4 pos=1.93,eh+0.78,1.95 rot=18.4,0,0 mirror=x
box size=0.12,0.14,4.4 pos=1.93,eh+0.78,-1.95 rot=-18.4,0,0 mirror=x
# Metal roof shell (thin gable), ribs, ridge cap
material paint
color roof_r roof_g roof_b
extrude depth=13.0 pos=0,0,0 pts=4.5,eh-0.1,4.5,eh,0,eh+1.6,-4.5,eh,-4.5,eh-0.1,0,eh+1.5
color roof_r*0.8 roof_g*0.8 roof_b*0.8
box size=0.05,0.04,4.75 pos=4.2,eh+0.82,2.25 rot=19.6,0,0 mirror=x
box size=0.05,0.04,4.75 pos=4.2,eh+0.82,-2.25 rot=-19.6,0,0 mirror=x
box size=0.05,0.04,4.75 pos=1.4,eh+0.82,2.25 rot=19.6,0,0 mirror=x
box size=0.05,0.04,4.75 pos=1.4,eh+0.82,-2.25 rot=-19.6,0,0 mirror=x
material steel
color #8d9297
box size=13.05,0.08,0.4 pos=0,eh+1.6,0
# Picnic tables (top, benches, splayed legs, bench rails)
material matte
set tx = -3.9
set tz = 1.7
color #8b6a44
box size=1.8,0.05,0.76 pos=tx,0.86,tz
box size=1.8,0.05,0.28 pos=tx,0.56,tz+0.62
box size=1.8,0.05,0.28 pos=tx,0.56,tz-0.62
color #6e5434
box size=0.07,0.82,0.08 pos=tx+0.7,0.5,tz+0.24 rot=-24,0,0
box size=0.07,0.82,0.08 pos=tx+0.7,0.5,tz-0.24 rot=24,0,0
box size=0.07,0.82,0.08 pos=tx-0.7,0.5,tz+0.24 rot=-24,0,0
box size=0.07,0.82,0.08 pos=tx-0.7,0.5,tz-0.24 rot=24,0,0
box size=0.06,0.06,1.5 pos=tx+0.7,0.5,tz
box size=0.06,0.06,1.5 pos=tx-0.7,0.5,tz
set tx = 0
set tz = 1.7
color #8b6a44
box size=1.8,0.05,0.76 pos=tx,0.86,tz
box size=1.8,0.05,0.28 pos=tx,0.56,tz+0.62
box size=1.8,0.05,0.28 pos=tx,0.56,tz-0.62
color #6e5434
box size=0.07,0.82,0.08 pos=tx+0.7,0.5,tz+0.24 rot=-24,0,0
box size=0.07,0.82,0.08 pos=tx+0.7,0.5,tz-0.24 rot=24,0,0
