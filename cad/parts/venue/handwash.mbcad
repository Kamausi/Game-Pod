# Portable foot-pump handwash station: plastic tank base, two basins, back panel
# with soap and towel dispensers. ~0.8 x 0.6 x 1.4 m, basins face +Z.
material plastic
# Base / water tank
color #e4e6e1
box size=0.80,0.84,0.56 pos=0,0.42,-0.02
color #cfd2cc
box size=0.82,0.06,0.60 pos=0,0.87,0 bevel=0.015
# Basins sitting on the counter (outer wall, rolled lip, bowl)
color #6f8fae
lathe pts=0.14,0.90,0.17,0.98,0.155,0.985,0.12,0.92,0,0.92 seg=12 pos=0.20,0,0.05 mirror=x
# Back panel and header cap
color #e4e6e1
box size=0.80,0.50,0.06 pos=0,1.14,-0.26
color #3d6b9b
box size=0.82,0.05,0.14 pos=0,1.375,-0.24
# Faucets
material chrome
color #c8c8c8
cyl r=0.012 h=0.10 pos=0.20,0.98,-0.18 seg=8 mirror=x
box size=0.02,0.02,0.10 pos=0.20,1.03,-0.13 mirror=x
# Soap dispensers and paper towel box
material plastic
color #fafafa
box size=0.09,0.14,0.07 pos=0.20,1.18,-0.195 mirror=x
color #4a4a4a
box size=0.24,0.22,0.10 pos=0,1.17,-0.18
color #f4f4f0
box size=0.16,0.03,0.04 pos=0,1.055,-0.15
# Foot pumps at the base
color #2a2a2a
box size=0.14,0.05,0.14 pos=0.20,0.025,0.30 mirror=x
color #1a1a1a
box size=0.83,0.04,0.59 pos=0,0.02,-0.02
