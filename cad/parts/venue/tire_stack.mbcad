# Stack of four worn-out mud tyres used as a crash barrier / marker: real lugged tyres lying
# flat and slightly skewed, the top one painted with a white sidewall stripe, mud packed in the
# lower ones, rainwater and dirt in the bottom. Origin at ground centre.
for k = 0, 3
  color 0.10+0.02*k 0.10+0.02*k 0.10+0.015*k
  tire r=0.40 w=0.27 rim=0.21 lugs=16 depth=0.026 tread=mt pos=0.03*sin(k*97),0.135+k*0.265,0.03*cos(k*61) rot=0,0,90
end
# White paint stripe round the top tyre's sidewall (marker)
color #f0f0ea
material paint
lathe seg=20 pts=0.27,1.072,0.33,1.072,0.33,1.077,0.27,1.077 pos=0.03*sin(291),0,0.03*cos(183)
# Mud caked into the lower two
color #4e3e2a
material mud
lathe seg=16 pts=0.33,0.02,0.40,0.02,0.40,0.30,0.33,0.30
color #5a4730
lathe seg=16 pts=0.33,0.30,0.395,0.30,0.395,0.40,0.33,0.40
# Rainwater and silt in the bottom
color #2a2a24
material glass
cyl r=0.21 h=0.01 pos=0,0.06,0 seg=12
