cyl r=0.010 h=0.44 axis=x pos=0.55,0.52,0 rot=0,0,25 seg=6 mirror=x
material rubber
color #2a2a2a
cyl r=0.02 h=0.02 pos=0.76,0.01,0.30 seg=6 mirror=x
cyl r=0.02 h=0.02 pos=0.76,0.01,-0.30 seg=6 mirror=x
# Cash box with handle
