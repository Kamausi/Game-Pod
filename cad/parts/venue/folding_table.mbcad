# White plastic folding table (registration / tech inspection) with a cash box,
# paperwork and a clipboard. 1.8 m long along X, origin at ground centre.
# Top
material plastic
color #ecebe6
box size=1.83,0.045,0.76 pos=0,0.715,0 bevel=0.015
color #d4d3cd
box size=1.79,0.04,0.02 pos=0,0.675,0.36 mirror=z
# Folding legs: two tube U-frames with feet and fold braces
material steel
color #8d9094
cyl r=0.014 h=0.69 pos=0.76,0.345,0.30 seg=6 mirror=x
cyl r=0.014 h=0.69 pos=0.76,0.345,-0.30 seg=6 mirror=x
