# Elevated announcer / race-control booth: braced steel stilts, steel deck with railing,
# enclosed 3x3 m booth with a big window wall facing the track (+Z), side stair on +X,
# and two PA horn speakers on poles. Origin at ground centre under the booth.
param body_r = 0.86
param body_g = 0.85
param body_b = 0.80
param trim_r = 0.15
param trim_g = 0.32
param trim_b = 0.62
set dk = 4.15
# Footings
material matte
color #8e8a82
box size=0.45,0.1,0.45 pos=1.3,0.05,1.3 mirror=x
box size=0.45,0.1,0.45 pos=1.3,0.05,-1.3 mirror=x
# Stilts and cross bracing
material steel
color #4a4f55
box size=0.16,dk,0.16 pos=1.3,dk/2,1.3 mirror=x
box size=0.16,dk,0.16 pos=1.3,dk/2,-1.3 mirror=x
box size=0.07,0.07,4.44 pos=1.3,2.1,0 rot=54.2,0,0 mirror=x
box size=0.07,0.07,4.44 pos=1.3,2.1,0 rot=-54.2,0,0 mirror=x
box size=4.44,0.07,0.07 pos=0,2.1,1.3 rot=0,0,54.2 mirror=z
box size=4.44,0.07,0.07 pos=0,2.1,1.3 rot=0,0,-54.2 mirror=z
box size=2.6,0.1,0.1 pos=0,0.9,1.3 mirror=z
box size=0.1,0.1,2.6 pos=1.3,0.9,0 mirror=x
# Deck (steel grating look) and edge channel
color #5c6166
box size=3.6,0.15,3.6 pos=0,dk-0.075,0
color #383c40
box size=3.64,0.22,0.06 pos=0,dk-0.11,1.81 mirror=z
box size=0.06,0.22,3.64 pos=1.81,dk-0.11,0 mirror=x
# Railing (yellow safety)
material paint
color #d9b21c
box size=0.05,1.05,0.05 pos=1.77,dk+0.52,1.77 mirror=x
box size=0.05,1.05,0.05 pos=1.77,dk+0.52,-1.77 mirror=x
box size=0.05,1.05,0.05 pos=1.77,dk+0.52,-1.12
box size=3.58,0.05,0.05 pos=0,dk+1.05,1.77 mirror=z
box size=3.58,0.05,0.05 pos=0,dk+0.55,1.77 mirror=z
box size=0.05,0.05,3.58 pos=-1.77,dk+1.05,0
box size=0.05,0.05,3.58 pos=-1.77,dk+0.55,0
box size=0.05,0.05,2.9 pos=1.77,dk+1.05,0.33
box size=0.05,0.05,2.9 pos=1.77,dk+0.55,0.33
# Booth shell
color body_r body_g body_b
box size=3.0,2.5,3.0 pos=0,dk+1.25,0
color trim_r trim_g trim_b
box size=3.04,0.22,3.04 pos=0,dk+0.95,0
box size=3.04,0.1,3.04 pos=0,dk+0.05,0
# Window wall (+Z), side windows, door on +X
material glass
color #1e2a32
box size=2.8,1.3,0.05 pos=0,dk+1.72,1.51
box size=0.05,1.1,2.4 pos=-1.51,dk+1.72,0.05
box size=0.05,1.1,1.1 pos=1.51,dk+1.72,0.75
material paint
color body_r*0.8 body_g*0.8 body_b*0.8
box size=0.06,1.3,0.06 pos=0.47,dk+1.72,1.53 mirror=x
box size=0.05,2.05,0.85 pos=1.52,dk+1.05,-0.85
material chrome
color #c8c8c8
sphere r=0.035 pos=1.56,dk+1.05,-0.53 seg=8
# Roof slab (slight fall to the back) with fascia
material steel
color #6d7378
box size=3.6,0.12,3.7 pos=0,dk+2.6,0.1 rot=-3,0,0
material paint
color trim_r trim_g trim_b
box size=3.62,0.2,0.05 pos=0,dk+2.66,1.96
# PA speaker poles and horns, aimed out over the track
material steel
color #3a3a3a
cyl r=0.045 h=1.5 pos=1.55,dk+3.4,1.55 seg=8 mirror=x
box size=0.08,0.08,0.4 pos=1.55,dk+4.05,1.7 mirror=x
color #d8d8d4
cyl r=0.09 r2=0.3 h=0.55 axis=z pos=1.65,dk+4.0,2.0 rot=12,20,0 seg=10
cyl r=0.09 r2=0.3 h=0.55 axis=z pos=-1.65,dk+4.0,2.0 rot=12,-20,0 seg=10
color #2a2a2a
cyl r=0.11 h=0.22 axis=z pos=1.55,dk+4.05,1.66 seg=8 mirror=x
# Stair on +X (down toward +Z) with top landing
color #4a4f55
box size=0.95,0.15,0.7 pos=2.3,dk-0.075,-1.5
box size=0.1,dk,0.1 pos=2.7,dk/2,-1.8
box size=0.1,dk,0.1 pos=1.9,dk/2,-1.8
box size=0.07,0.28,5.75 pos=1.87,2.19,0.9 rot=44.66,0,0
box size=0.07,0.28,5.75 pos=2.73,2.19,0.9 rot=44.66,0,0
color #6b7076
box size=0.86,0.05,0.28 pos=2.3,0.266,2.700
box size=0.86,0.05,0.28 pos=2.3,0.563,2.400
box size=0.86,0.05,0.28 pos=2.3,0.859,2.100
box size=0.86,0.05,0.28 pos=2.3,1.156,1.800
box size=0.86,0.05,0.28 pos=2.3,1.452,1.500
box size=0.86,0.05,0.28 pos=2.3,1.749,1.200
box size=0.86,0.05,0.28 pos=2.3,2.045,0.900
box size=0.86,0.05,0.28 pos=2.3,2.341,0.600
box size=0.86,0.05,0.28 pos=2.3,2.638,0.300
box size=0.86,0.05,0.28 pos=2.3,2.934,0.000
box size=0.86,0.05,0.28 pos=2.3,3.231,-0.300
box size=0.86,0.05,0.28 pos=2.3,3.527,-0.600
box size=0.86,0.05,0.28 pos=2.3,3.824,-0.900
material paint
color #d9b21c
box size=0.05,0.05,5.9 pos=1.87,2.975,0.9 rot=44.66,0,0
box size=0.05,0.05,5.9 pos=2.73,2.975,0.9 rot=44.66,0,0
box size=0.05,0.95,0.05 pos=2.73,0.475,3.0
box size=0.05,0.95,0.05 pos=1.87,0.475,3.0
box size=0.05,1.05,0.05 pos=2.73,dk+0.52,-1.82
box size=0.05,0.05,0.62 pos=2.73,dk+1.05,-1.51
