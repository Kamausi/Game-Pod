# IBC-style poly water tote: translucent white tank in a galvanised cage on a
# pallet, valve on +Z, garden hose coiled beside it (+X). Origin at ground centre.
# Pallet
material steel
color #8a8d90
box size=1.20,0.04,1.00 pos=0,0.13,0
color #3d3d3d
box size=1.20,0.11,0.10 pos=0,0.055,0.45 mirror=z
box size=1.20,0.11,0.10 pos=0,0.055,0
# Tank
material plastic
color #e9eadf
box size=1.12,0.96,0.92 pos=0,0.63,0 bevel=0.07
color #d8d9cc
cyl r=0.10 h=0.05 pos=0,1.12,0 seg=12
color #1e1e1e
cyl r=0.08 h=0.03 pos=0,1.155,0 seg=10
# Cage: three horizontal tube rings + verticals on every face
material steel
color #b7bbbf
box size=1.18,0.03,0.03 pos=0,0.16,0.49 mirror=z
box size=0.03,0.03,1.0 pos=0.59,0.16,0 mirror=x
box size=1.18,0.03,0.03 pos=0,0.63,0.49 mirror=z
box size=0.03,0.03,1.0 pos=0.59,0.63,0 mirror=x
box size=1.18,0.03,0.03 pos=0,1.10,0.49 mirror=z
box size=0.03,0.03,1.0 pos=0.59,1.10,0 mirror=x
box size=0.025,0.96,0.025 pos=0.20,0.63,0.49 mirror=x
box size=0.025,0.96,0.025 pos=0.58,0.63,0.49 mirror=x
box size=0.025,0.96,0.025 pos=0.20,0.63,-0.49 mirror=x
box size=0.025,0.96,0.025 pos=0.58,0.63,-0.49 mirror=x
box size=0.025,0.96,0.025 pos=0.59,0.63,0.17 mirror=x
box size=0.025,0.96,0.025 pos=0.59,0.63,-0.17 mirror=x
box size=1.18,0.025,0.025 pos=0,1.11,0 
box size=0.025,0.025,1.0 pos=0,1.11,0
# Outlet valve with lever
material plastic
color #3a3a3a
cyl r=0.06 h=0.12 axis=z pos=0,0.26,0.52 seg=10
color #c0392b
box size=0.16,0.03,0.03 pos=0,0.33,0.56
# Hose: three coils on the ground beside the tote, lead running to the valve
material rubber
color #2f6b2a
lathe pts=arc(0.27,0.025,0.025,0,360,8) seg=12 pos=0.98,0,0.10
lathe pts=arc(0.25,0.075,0.025,0,360,8) seg=12 pos=0.97,0,0.08
lathe pts=arc(0.23,0.125,0.025,0,360,8) seg=12 pos=0.99,0,0.09
cyl r=0.022 h=0.62 axis=x pos=0.42,0.05,0.62 rot=0,-25,0 seg=6
cyl r=0.022 h=0.24 pos=0.12,0.16,0.60 rot=60,0,0 seg=6
