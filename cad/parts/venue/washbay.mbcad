# Vehicle wash bay: low concrete pad (drive-on, top at 0.06 m) with a centre drain grate
# strip, two pressure-washer stands with hose reels, and a roofless steel portal frame
# carrying a sign panel at the -Z end. Pad 6 m (X) x 9 m (Z). Origin at ground centre.
param sign_r = 0.12
param sign_g = 0.34
param sign_b = 0.70
set pt = 0.06
# Pad with chamfered-looking lip and drain strip (flush, slightly darker)
material matte
color #9e9a92
box size=6,pt,9 pos=0,pt/2,0
color #8a867e
box size=6.12,pt*0.6,9.12 pos=0,pt*0.3,0
material steel
color #2e3032
box size=0.4,0.008,8.4 pos=0,pt+0.002,0
color #4a4d50
box size=0.44,0.01,0.03 pos=0,pt+0.003,4.21
box size=0.44,0.01,0.03 pos=0,pt+0.003,-4.21
# Portal frame at the -Z end (two columns, beam) and sign panel
color #5a6066
box size=0.2,4.2,0.2 pos=3.3,2.1,-4.3 mirror=x
box size=6.8,0.25,0.2 pos=0,4.1,-4.3
box size=1.1,0.12,0.12 pos=2.88,3.62,-4.3 rot=0,0,-45 mirror=x
material paint
color sign_r sign_g sign_b
box size=4.4,1.1,0.06 pos=0,4.85,-4.3
color #f2f0ea
box size=4.4,0.12,0.07 pos=0,4.42,-4.3
set post_h = 4.97
for s = -1, 1, 2
  box size=0.556,0.080,0.03 pos=s*-1.896,0.000+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.556,0.080,0.03 pos=s*-1.556,0.000+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.372,0.080,0.03 pos=s*-1.811,-0.119+post_h,s*0.045-4.3 rot=0,0,s*54.5
  box size=0.372,0.080,0.03 pos=s*-1.641,-0.119+post_h,s*0.045-4.3 rot=0,0,s*125.5
  box size=0.522,0.080,0.03 pos=s*-1.403,-0.017+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.522,0.080,0.03 pos=s*-1.062,-0.017+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.420,0.080,0.03 pos=s*-1.233,0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.420,0.080,0.03 pos=s*-1.233,0.000+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.420,0.080,0.03 pos=s*-0.740,0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.420,0.080,0.03 pos=s*-0.740,0.000+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.420,0.080,0.03 pos=s*-0.740,-0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.318,0.080,0.03 pos=s*-0.910,0.119+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.318,0.080,0.03 pos=s*-0.570,-0.119+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.556,0.080,0.03 pos=s*-0.417,0.000+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.556,0.080,0.03 pos=s*-0.077,0.000+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.420,0.080,0.03 pos=s*-0.247,0.000+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.556,0.080,0.03 pos=s*0.570,0.000+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.352,0.080,0.03 pos=s*0.706,0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.352,0.080,0.03 pos=s*0.706,0.000+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.369,0.080,0.03 pos=s*0.714,-0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.250,0.080,0.03 pos=s*0.892,0.119+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.250,0.080,0.03 pos=s*0.909,-0.119+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.522,0.080,0.03 pos=s*1.062,-0.017+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.522,0.080,0.03 pos=s*1.402,-0.017+post_h,s*0.045-4.3 rot=0,0,s*90.0
  box size=0.420,0.080,0.03 pos=s*1.232,0.238+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.420,0.080,0.03 pos=s*1.232,0.000+post_h,s*0.045-4.3 rot=0,0,s*0.0
  box size=0.372,0.080,0.03 pos=s*1.641,0.119+post_h,s*0.045-4.3 rot=0,0,s*-54.5
  box size=0.372,0.080,0.03 pos=s*1.811,0.119+post_h,s*0.045-4.3 rot=0,0,s*-125.5
  box size=0.318,0.080,0.03 pos=s*1.726,-0.119+post_h,s*0.045-4.3 rot=0,0,s*90.0
end
# Pressure-washer stands (one each side, near the -Z end): post, cabinet, gun holster,
# boom arm and hose reel
material steel
color #6d7378
box size=0.14,2.6,0.14 pos=3.55,1.3,-2.6 mirror=x
box size=1.2,0.08,0.08 pos=3.0,2.55,-2.6 mirror=x
material paint
color #c8cdd2
box size=0.5,0.8,0.35 pos=3.55,1.1,-2.25 mirror=x
color #d33a2a
box size=0.3,0.15,0.04 pos=3.55,1.35,-2.06 mirror=x
material plastic
color #f0c020
cyl r=0.28 h=0.18 axis=x pos=3.42,1.95,-2.6 seg=12 mirror=x
color #1a1a1a
cyl r=0.17 h=0.2 axis=x pos=3.42,1.95,-2.6 seg=10 mirror=x
cyl r=0.02 h=1.6 pos=2.45,1.75,-2.6 seg=6 mirror=x
color #2a2a2a
box size=0.08,0.35,0.08 pos=3.3,0.95,-2.06 mirror=x
# Kerb stops at the stands so trucks don't clip them
material paint
color #e2c21a
box size=0.25,0.15,1.2 pos=3.25,0.075,-2.6 mirror=x
