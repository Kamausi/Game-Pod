# Copy to .env (never commit it) and chmod 600 .env

# --- alerts (Slack or Discord incoming webhook) ---
TRADEBOT_ALERT_WEBHOOK=

# --- Claude engine (optional; rules/ensemble engines need no key) ---
ANTHROPIC_API_KEY=

# --- paper / practice brokers ---
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
OANDA_ACCOUNT_ID=
OANDA_TOKEN=

# --- LIVE: only used after `tradebot go-live`. Use trade-only keys, no withdrawal permission, IP-allowlisted. ---
LIVE_VENUE=cryptocom
CRYPTOCOM_API_KEY=
CRYPTOCOM_API_SECRET=
APCA_LIVE_KEY_ID=
APCA_LIVE_SECRET_KEY=
OANDA_LIVE_ACCOUNT_ID=
OANDA_LIVE_TOKEN=

# --- LIVE Solana: a dedicated hot wallet holding only what you can lose ---
SOLANA_KEYPAIR_PATH=/state/secrets/solana-hot.json
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JITO_TIP_LAMPORTS=10000

# --- TimescaleDB (optional) ---
POSTGRES_PASSWORD=

# --- TypeSafe Jev (optional engine / reviewer / headline classifier) ---
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest   # pin a version (e.g. jev-1.13.0) once thresholds are calibrated

# Desk (tradebot desk ...): SEC asks automated clients for a contact in the User-Agent
SEC_USER_AGENT=your-name you@example.com
